#!/usr/bin/env zsh
# wts — git worktree + tmux session launcher, built for parallel Claude Code agents
#
# Usage: wts <name> [layout] [context...]
#        wts <name> "<phrase>" [layout] [context...]
#        wts "<phrase>" [layout] [context...]
#        wts new [-p layout] <name|"phrase"...>
#        wts doc add <url|path> | ls [--json] | show [--json] | sync | forget
#        wts doc use <slug> [session] | tools
#        wts ls [--wide] | wts status [--json|--table [--wide]|--fzf]
#        wts brief [name...] | brief --cached [--json] [name...]
#        wts send <session> [--answer | --force] <text...>
#        wts wait <session>... [--until <state>,...] [--timeout <s>] [--json]
#        wts tail <session> [-n <k>] [--json]
#        wts restore [name...]
#        wts stop <name>
#        wts pr [name] | pr --refresh [--json] [name...]
#        wts rm <name> [-f]
#        wts gc [--all] [--all-branches] [--apply] [--no-fetch] [--no-retro]
#        wts gc [--all] [--all-branches] [--no-fetch] --json
#        wts log [--since <when>] [--until <when>] [--task <id>] [--brief]
#                [--no-notes] [--no-things]
#        wts retro [name...] [--force] [--jobs <n>]
#        wts task ls [--all] [--json] | show <id> [--json]
#        wts task link [<id>] [session] | unlink [session]
#        wts task new "<title>" | add [<id>] | edit [<id>] | done [<id>]
#        wts task note [<id>] "<text>" | note [<id>] --clear
#        wts task doc [<id>] [<doc>] | doc [<id>] --rm <slug>
#        wts layouts
#        wts keys
#        wts doctor [--json]
#        wts setup tmux [--install] | git | claude [--install]
#        wts db path | tables | schema [<table>] | row <table> <rowid> | browse [<table>]
#        wts db sql "<SELECT>" | notes [--all] | get | set | del
#        wts help | wts version | wts <command> --help
#
#   <name>     : name of the worktree AND of the tmux session
#   <phrase>   : the task in plain words, quoted; Claude starts with it.
#                Without <name>, Claude proposes the name (a few seconds;
#                Ctrl-C takes the name derived locally instead)
#   [layout]   : tmuxinator layout (default: default), see `wts layouts`
#   [context]  : exposed to the layout as $WTS_CONTEXT
#   --doc <d>  : attach a context document (a slug of `wts doc ls`, a URL or a
#                markdown file); repeatable, and bare --doc at the end picks one
#   --task <t> : the session serves this task (`wts task ls`): its notes and
#                documents become the agent's context; bare --task at the end
#                picks one. Both options work with `new` too
#   --detach   : start the session without attaching to it; implied when stdin
#                is not a terminal (an agent's shell, a script)
#   --json     : detached, progress on stderr, and the session on stdout as
#                JSON: name, branch, worktree, task (an array for `new`)
#
#   new        : create several sessions at once, then attach to the first
#   ls         : list registered sessions and their state (agent and since
#                when, git delta); --wide: tokens, API-price cost and model
#                too (as of the last `wts brief`, or the teardown), and what
#                a blocked agent is waiting for
#   status     : same collection, as JSON (--json), table (--table) or fzf lines (--fzf)
#   brief      : where each session stands, "done / next", summarized by Claude;
#                --cached: the last summaries, from the database, no model call
#   send       : type a line into a session's agent and submit it (the agent's
#                own pane; refused when it is not known, or when no agent is
#                working or idle in it). --answer: the line answers the
#                question the agent is blocked on; --force: whatever its state
#   wait       : return once each session's agent is in one of the states
#                (default: no longer working, or stuck), or after --timeout
#                (90 s); exit 1 on timeout
#   tail       : the agent's last messages, from its transcript
#   restore    : restart registered sessions missing from tmux (after a reboot)
#                and pre-fill `claude --continue`
#   stop       : kill the tmux session only; the worktree, the branch and the
#                registry entry stay (wts restore restarts it)
#   rm         : delete the tmux session, the worktree and the branch
#     -f       : force (dirty worktree, unmerged branch)
#   pr         : open the session's pull request on GitHub (needs gh); the
#                current session when run inside one. --refresh asks gh for
#                each session's PR, checks and review and caches them for the
#                switcher's PR column and `wts status --json` (which never call
#                gh themselves); the switcher also does it every 5 minutes
#   doc        : the library of reusable context documents (a Notion page, a
#                markdown file) attached to a session with --doc
#   gc         : clean up from the remote: worktrees and branches whose PR is
#                merged (squash included) or whose remote branch is gone,
#                plus any stale index.lock blocking writes in a worktree.
#                Only the branches wts created, unless --all-branches.
#                After its fetch, one `gh pr list` finds the PRs merged on
#                GitHub that git alone cannot see (not with --no-fetch).
#                --apply also archives what it tears down, for `wts log`, and
#                asks Claude for one retrospective each (--no-retro: none);
#                --all does every repository that has a session
#   log        : the work journal as JSON: every finished session with its
#                outcome, its diff, its retrospective and a pointer to its
#                transcript, for the six-month look back a review needs
#   retro      : write the retrospectives gc could not (no model, a timeout);
#                reads the archive, never the worktree, so it works any time
#   task       : the work above a session — a Things 3 task, or a local one.
#                One task, one to N sessions; `--task` links at creation and
#                hands over the task's notes and documents as context
#   layouts    : list available layouts (yours shadow the built-in ones)
#   keys       : switcher keys and tmux bindings (the popup shows them too)
#   doctor     : check what wts needs (tmux, tmuxinator, fzf, claude, ...) and
#                that the tmux snippet, the Claude hooks and the skill are
#                installed and current
#   setup tmux : print the tmux.conf snippet (switcher popup, `wts` command);
#                --install writes it into ~/.tmux.conf, replacing an older one
#   setup git  : print the two git settings that keep `wts ls` fast on a large repository
#   setup claude : print (--install: add) the Claude Code hooks that tell every
#                agent in a wts session about the others, the permissions for
#                the read-only verbs, and (--install) the wts skill
#   db         : the state database (SQLite): read anything, and notes the
#                agents leave for each other (`wts db help`). `tables` counts
#                rows and columns, `schema <table>` gives one table's, `row`
#                prints one record; `browse` picks a table, then a row, in fzf
#
# Examples:
#   wts auth-form
#   wts auth-form "validate the email server-side before sending it"
#   wts "users should be able to log out quickly"
#   wts sentry-ABC123 sentry ABC123
#   wts new cors rate-limit metering
#   wts ls
#   wts brief
#   wts restore
#   wts stop auth-form
#   wts pr auth-form
#   wts rm auth-form -f
#   wts doc add https://notion.so/Payments-abc123
#   wts auth-form "limit the rate per key" --doc payments-architecture
#   wts log --since '-6 months' > work.json
#   wts retro
#   wts audit-trail "make the ledger auditable" --task

set -euo pipefail

WTS_VERSION="1.8.3"

# ─── Install layout ──────────────────────────────────────────────────────────
# Homebrew, `make install` and a git checkout all share the same tree:
#   <prefix>/bin/wts
#   <prefix>/libexec/wts/wts-*        helpers
#   <prefix>/share/wts/layouts/*.yml  built-in layouts
# `:A` resolves symlinks, so the Homebrew link in /opt/homebrew/bin leads back
# to the real prefix. Captured here and not inside functions: with zsh's
# FUNCTION_ARGZERO, $0 is the function name there.
WTS_SELF="${0:A}"
WTS_PREFIX="${WTS_SELF:h:h}"
WTS_LIBEXEC="${WTS_LIBEXEC:-$WTS_PREFIX/libexec/wts}"
WTS_BUILTIN_LAYOUTS="$WTS_PREFIX/share/wts/layouts"
WTS_USER_LAYOUTS="${WTS_LAYOUTS_PATH:-${XDG_CONFIG_HOME:-$HOME/.config}/wts/layouts}"

CLAUDE_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"

# ─── Session registry (for `ls` / `restore`) ─────────────────────────────────
# The sessions created by wts, so they can be listed again and restarted after
# a reboot (worktrees survive one, tmux does not). A table of the state
# database, libexec/wts/wts-db.zsh, which every helper sources too.

source "$WTS_LIBEXEC/wts-db.zsh"

registry_available() {
  db_available
}

registry_init() {
  db_init
}

# registry_put <session> <layout> <repo_root> <worktree> <branch> <subdir> <context> [prompt] [docs-json]
# The prompt is only known at creation: a later `wts <name>` (idempotence)
# comes without a phrase and must not erase it, hence the old one is kept.
# The attached documents follow the same rule: a re-run comes without --doc and
# must not detach what `wts doc use` attached since.
registry_put() {
  registry_available || return 0
  registry_init || return 0
  local err
  if ! err=$(db_q "INSERT INTO sessions
      (name, profile, repo_root, worktree, branch, subdir, context, prompt, docs, created_at)
    VALUES ($(sql_str "$1"), $(sql_str "$2"), $(sql_str "$3"), $(sql_str "$4"),
            $(sql_str "$5"), $(sql_str "$6"), $(sql_str "$7"), $(sql_str "${8:-}"),
            json($(sql_str "${9:-[]}")), strftime('%Y-%m-%dT%H:%M:%SZ', 'now'))
    ON CONFLICT(name) DO UPDATE SET
      profile = excluded.profile, repo_root = excluded.repo_root,
      worktree = excluded.worktree, branch = excluded.branch,
      subdir = excluded.subdir, context = excluded.context,
      prompt = CASE WHEN excluded.prompt = '' THEN sessions.prompt ELSE excluded.prompt END,
      docs = CASE WHEN json_array_length(excluded.docs) = 0 THEN sessions.docs ELSE excluded.docs END" \
      2>&1 >/dev/null); then
    # sqlite3's own reason ("database is locked", "readonly database", a full
    # disk): "not updated" alone sent people to look at the wrong thing.
    echo "⚠ registry not updated ($WTS_DB)${err:+: $(first_line "$err")}" >&2
  fi
}

# Forget sessions, with what the database keeps about them: their brief, the
# notes their agent left, and the task they served. The archive row is NOT
# touched — it is the one thing meant to outlive the session, and it carries the
# task itself, so the durable link survives while the live one goes.
#
# Status 1, and sqlite3's reason on stderr, when nothing was deleted: this used
# to end on `|| true`, so a locked database left the row and every side row in
# place while `wts rm` said the session was gone — and the next session of that
# name inherited its notes, its events and its PR state. gc already said so.
registry_del() {
  registry_available || return 0
  [[ -s "$WTS_DB" ]] || return 0
  local in err
  in=$(sql_list "$@")
  if ! err=$(db_q "BEGIN IMMEDIATE;
        DELETE FROM sessions WHERE name IN $in;
        DELETE FROM briefs WHERE session IN $in;
        DELETE FROM notes WHERE session IN $in;
        DELETE FROM task_links WHERE session IN $in;
        DELETE FROM agent_events WHERE session IN $in;
        DELETE FROM agent_panes WHERE session IN $in;
        DELETE FROM touches WHERE session IN $in;
        DELETE FROM pr_state WHERE session IN $in;
        DELETE FROM merge_checks WHERE session IN $in;
        DELETE FROM kv WHERE key IN $(sql_list "${@/#/teardown:}");
        COMMIT;" 2>&1 >/dev/null); then
    echo "⚠ registry not updated ($WTS_DB)${err:+: $(first_line "$err")} — still registered: $*. wts gc --apply clears what is left" >&2
    return 1
  fi
  db_q "$(usage_prune_sql)" >/dev/null 2>&1 || true
  return 0
}

# What `wts-retro store` reads on stdin, for a session whose worktree is gone:
# there is no folder to collect git facts from, so the record carries what the
# registry knows, under <outcome>.
# base outcome pr title commits files added removed commit_count file_count
# transcript session_id bytes mtime — the record `wts-retro collect` writes.
registry_bare_facts() {  # <outcome>
  local -a rec
  rec=("" "$1" "" "" "" "" 0 0 0 0 "" "" 0 0)
  print -rn -- "${(pj:\x1f:)rec}"$'\x1e'
}

# Drop the entries whose worktree is gone — all of them, or the named ones. One
# DELETE for all: the JSON registry was rewritten once per stale entry.
#
# Not the ones `wts rm` is tearing down right now (its `teardown:<name>` mark
# in kv, for a minute): rm removes the worktree, then the branch, and only then
# archives. A `wts ls` run in between — any agent may, without a prompt — saw a
# row with no worktree, archived it `unknown` and deleted it, and rm's own
# record, the one with the outcome, the diff and the transcript, was refused.
registry_prune() {  # [<name>…]
  registry_available || return 0
  [[ -s "$WTS_DB" ]] || return 0
  local name worktree only="1"
  local -a stale
  stale=()
  (( $# )) && only="s.name IN $(sql_list "$@")"
  while IFS=$'\x1f' read -r -d $'\x1e' name worktree; do
    [[ -n "$name" ]] || continue
    [[ -d "$worktree" ]] || stale+=("$name")
  done < <(db_rows "SELECT s.name, s.worktree FROM sessions s
                    WHERE $only AND NOT EXISTS (
                      SELECT 1 FROM kv WHERE key = 'teardown:' || s.name
                        AND CAST(value AS INTEGER) > CAST(strftime('%s', 'now') AS INTEGER) - 60)" 2>/dev/null)
  (( ${#stale} )) || return 0
  # Archived first. A worktree removed by hand — `rm -rf`, a `git worktree
  # remove` typed directly — took the registry row, the notes and the task link
  # with it on the next `wts ls`, silently: the one teardown `wts log` never
  # heard of. There is no folder left to collect git facts from, so the record
  # carries what the registry knows, under the outcome `unknown`.
  if [[ -z "${WTS_NO_ARCHIVE:-}" && -x "$WTS_LIBEXEC/wts-retro" ]]; then
    for name in "${stale[@]}"; do
      if registry_bare_facts unknown \
         | "$WTS_LIBEXEC/wts-retro" store "$name" 2>/dev/null; then
        print -u2 -r -- "→ $name: worktree gone, archived (wts log)"
      fi
    done
  fi
  # `|| true`: a listing must not die of a housekeeping that failed, under
  # `set -e`. registry_del has said why, and the next listing tries again.
  registry_del "${stale[@]}" || true
  return 0
}

registry_has() {
  registry_available && db_has_session "$1"
}

# Claude transcripts directory of a worktree. Claude Code slugifies the working
# directory: every non-alphanumeric character becomes "-", not only "/" and
# ".": `repo__worktrees` is stored under `repo--worktrees`.
claude_project_dir() {
  print -r -- "$CLAUDE_DIR/projects/${1//[^a-zA-Z0-9]/-}"
}

# Main worktree of the repository holding <path>: the first entry of `worktree
# list`, by definition. `git rev-parse --show-toplevel` answers with the CURRENT
# worktree, so run from inside a wts session (the layout's shell window, the
# switcher popup) it named the agent's worktree, and the base derived from it
# (`<worktree>-worktrees/`) nested the next session where gc never looks — or,
# for `wts rm`, pointed at a folder that does not exist while the registry row
# was dropped all the same. wts-fresh had this hop; every path has it now.
main_worktree_of() {  # <path inside a repository>
  local main
  main=$(git -C "$1" worktree list --porcelain 2>/dev/null \
         | awk '/^worktree /{ print substr($0, 10); exit }')
  print -r -- "${main:-$1}"
}

# Attach to a session. `tmux attach` refuses to nest sessions when $TMUX is
# already set ("sessions should be nested with care"): from a pane, and so from
# the window opened by `C-b : wts …`, `switch-client` is the right call.
attach_or_switch() {
  if [[ -n "${TMUX:-}" ]] && tmux switch-client -t "=$1" 2>/dev/null; then
    exit 0
  fi
  exec tmux attach -t "=$1"
}

# Edit distance, for awk: lev(a, b) counts insertions, deletions, substitutions
# and a swap of two adjacent letters as one edit each (optimal string
# alignment). The swap matters: `wts lsit` is one slip of the fingers, and plain
# Levenshtein counts it as two. Shared by the name resolver below and by the
# typo guard of the normal flow, which must agree on what "close" means.
WTS_LEV_AWK='
  function lev(a, b,   la, lb, i, j, c, x, y, z, d) {
    la = length(a); lb = length(b)
    for (i = 0; i <= la; i++) d[i, 0] = i
    for (j = 0; j <= lb; j++) d[0, j] = j
    for (i = 1; i <= la; i++)
      for (j = 1; j <= lb; j++) {
        c = (substr(a, i, 1) == substr(b, j, 1)) ? 0 : 1
        x = d[i-1, j] + 1; y = d[i, j-1] + 1; z = d[i-1, j-1] + c
        d[i, j] = (x < y ? (x < z ? x : z) : (y < z ? y : z))
        if (i > 1 && j > 1 && substr(a, i, 1) == substr(b, j-1, 1) \
            && substr(a, i-1, 1) == substr(b, j, 1) && d[i-2, j-2] + 1 < d[i, j])
          d[i, j] = d[i-2, j-2] + 1
      }
    return d[la, lb]
  }
'

# Resolve an approximate name to a registry key.
# Writes the chosen name on stdout, messages on stderr.
# Why: `wts rm` matches the literal string, and a typo (`rm auth-fom`) used to
# cost a round trip of `wts ls` and retyping.
registry_resolve_name() {
  local want="$1"
  # The substring match below accepts every session for an empty name and
  # offered them all in a picker — to `wts rm`.
  if [[ -z "$want" ]]; then
    print -u2 "wts: empty session name"
    return 1
  fi
  registry_available || { print -r -- "$want"; return 0 }
  [[ -s "$WTS_DB" ]] || { print -r -- "$want"; return 0 }

  # Exact match: nothing to do.
  if db_has_session "$want"; then
    print -r -- "$want"
    return 0
  fi

  typeset -a keys cands
  keys=("${(@f)$(db_ro 'SELECT name FROM sessions ORDER BY name' 2>/dev/null)}")
  (( ${#keys} )) || { print -r -- "$want"; return 0 }

  # Substring either way (covers a typo by omission: "rate-lim" is a prefix
  # of "rate-limit").
  local k
  for k in "${keys[@]}"; do
    [[ -n "$k" ]] || continue
    if [[ "$k" == *"$want"* || "$want" == *"$k"* ]]; then
      cands+=("$k")
    fi
  done

  # Fallback 1: fzf fuzzy filtering (subsequence). Catches omissions.
  if (( ${#cands} == 0 )) && command -v fzf >/dev/null 2>&1; then
    cands=("${(@f)$(print -rl -- "${keys[@]}" | fzf --filter="$want" 2>/dev/null | head -5)}")
    cands=("${(@)cands:#}")
  fi

  # Fallback 2: edit distance. fzf matches subsequences, so it does NOT see an
  # extra character (auth-foorm vs auth-form).
  if (( ${#cands} == 0 )); then
    cands=("${(@f)$(print -rl -- "${keys[@]}" | awk -v q="$want" "$WTS_LEV_AWK"'
      BEGIN { max = int(length(q) / 4); if (max < 2) max = 2 }
      { d = lev(tolower(q), tolower($0)); if (d <= max) print d "\t" $0 }
    ' | sort -n | cut -f2- | head -5)}")
    cands=("${(@)cands:#}")
  fi

  case ${#cands} in
    0) print -r -- "$want" ;;
    1) print -u2 "→ '$want' not found, single match: '${cands[1]}'"
       print -r -- "${cands[1]}" ;;
    *) if [[ -t 0 && -t 2 ]] && command -v fzf >/dev/null 2>&1; then
         local pick
         pick=$(print -rl -- "${cands[@]}" | fzf --reverse --height=40% \
                  --prompt="'$want' ? " --header="several matches") || return 1
         [[ -n "$pick" ]] || return 1
         print -r -- "$pick"
       else
         print -u2 "wts: '$want' is ambiguous: ${(j:, :)cands}"
         return 1
       fi ;;
  esac
}

# ─── Layouts ─────────────────────────────────────────────────────────────────
# Yours first (~/.config/wts/layouts, or $WTS_LAYOUTS_PATH), then the built-in
# ones. tmuxinator gets the file itself (--project-config), so your own
# ~/.config/tmuxinator projects are never touched.
#
# Every start passes --suppress-tmux-version-warning: tmuxinator checks tmux
# against a hard-coded list of releases, and on anything newer prints a warning
# and waits for Enter on stdin. Behind `>/dev/null` (restore, `wts new`) that
# is an invisible hang, and each tmux release would break wts until tmuxinator
# catches up. Detached starts also get `</dev/null`, so nothing ever waits on
# the terminal.

# layout_file <name> — path of the layout, or failure.
layout_file() {
  local dir
  for dir in "$WTS_USER_LAYOUTS" "$WTS_BUILTIN_LAYOUTS"; do
    if [[ -f "$dir/$1.yml" ]]; then
      print -r -- "$dir/$1.yml"
      return 0
    fi
  done
  return 1
}

# layout_list — "<name>\t<path>" per available layout, sorted by name. A user
# layout shadows the built-in one of the same name. Always succeeds: callers
# run it under `set -e`.
layout_list() {
  local -A seen
  local -a out
  local f n
  for f in "$WTS_USER_LAYOUTS"/*.yml(N) "$WTS_BUILTIN_LAYOUTS"/*.yml(N); do
    n=${f:t:r}
    (( ${+seen[$n]} )) && continue
    seen[$n]=1
    out+=("$n"$'\t'"$f")
  done
  if (( ${#out} )); then
    print -rl -- "${(o)out[@]}"
  fi
  return 0
}

# branch_prefix_of <layout file>: in wts-db.zsh, shared with the switcher's
# task screen.

usage() {
  sed -n '3,/^$/p' "$WTS_SELF" | sed 's/^# \{0,1\}//'
}

# start_detached <layout file> <session> — tmuxinator with nothing on the
# terminal, and on failure its own first line on ours. `restore` and `new` sent
# its output to /dev/null and said "tmuxinator failed to start", which left a
# YAML error or a dead tmux server to be found by running tmuxinator by hand.
# Both streams are read: tmuxinator prints "Failed to parse config file" on
# STDOUT, and its stderr is where tmux and the shell complain.
start_detached() {
  local err rc=0
  # `|| rc=$?` and not `if …; then`: after the `if`, $? is the if's own status.
  # `3>&-`: under --json, fd 3 is the caller's capture of this command, and a
  # tmux server started here would inherit it and hold `$(wts … --json)` open
  # for as long as it runs.
  err=$(tmuxinator start --project-config "$1" --name "$2" --no-attach \
          --suppress-tmux-version-warning </dev/null 2>&1 3>&-) || rc=$?
  (( rc )) || return 0
  # A tmuxinator that cannot run at all says nothing: a version manager's shim
  # whose Ruby is not found exits 126 in silence. The status is then the reason.
  err=$(first_line "$err")
  [[ -n "$err" ]] || err="exit status $rc (does \`tmuxinator version\` run? wts doctor)"
  print -u2 -r -- "⚠ $2: tmuxinator failed to start${err:+ — $err}"
  return 1
}

# first_line <text> — the first non-blank line, for a one-line reason.
first_line() {
  local l
  for l in "${(@f)1}"; do
    [[ -n "${l//[[:space:]]/}" ]] && { print -r -- "$l"; return 0 }
  done
  return 0
}

# ─── --doc ───────────────────────────────────────────────────────────────────
# Fills $DOC_REQ with the requested documents and $DOC_REST with everything
# else. It must run BEFORE the phrase/layout/context parsing, which is purely
# positional: a --doc left in place would land in $PROFILE or in $CONTEXT.
# A bare `--doc` as the last argument opens the picker; anywhere else it takes
# the next argument, with no lookahead heuristic — guessing wrong here would
# attach the wrong document to a fresh agent.
# `wts new` re-invokes wts with two positionals only and cannot pass an option
# through, so it hands its own documents over in $WTS_DOC_ARGS (\x1f-separated:
# a value can be a URL with anything in it), and its task in $WTS_TASK_ARG.
#
# --task rides in the same pass, and not in a second one: this is already "the
# pass that removes options", it already implements the bare-flag-at-the-end
# convention, and two scans would only double the chance of the two disagreeing.
#
# --detach and --json ride here too, for the same reason: they are options of a
# creation, and the creation's own parsing is positional.
typeset -ga DOC_REQ DOC_REST
typeset -g TASK_REQ TASK_ASKED DETACH JSON_OUT
strip_doc_args() {
  DOC_REQ=(${(@ps:\x1f:)${WTS_DOC_ARGS:-}})
  DOC_REQ=("${(@)DOC_REQ:#}")
  DOC_REST=()
  TASK_REQ="${WTS_TASK_ARG:-}"
  TASK_ASKED=false
  [[ -n "$TASK_REQ" ]] && TASK_ASKED=true
  DETACH=false
  JSON_OUT=false
  [[ -n "${WTS_NO_ATTACH:-}" ]] && DETACH=true
  while (( $# )); do
    case "$1" in
      --detach) DETACH=true ;;
      --json)   JSON_OUT=true ;;
      --doc=*)  DOC_REQ+=("${1#--doc=}") ;;
      --doc)    if (( $# == 1 )); then
                  DOC_REQ+=("")
                else
                  DOC_REQ+=("${2:-}"); shift
                fi ;;
      --task=*) TASK_REQ="${1#--task=}"; TASK_ASKED=true ;;
      --task)   TASK_ASKED=true
                # Same rule as --doc, and for the same reason: it always
                # consumes the next argument rather than guessing, so
                # `--task <layout>` is a mistake wts can name instead of a
                # layout silently becoming a task.
                if (( $# > 1 )); then
                  TASK_REQ="${2:-}"; shift
                fi ;;
      *)        DOC_REST+=("$1") ;;
    esac
    shift
  done
}

# ─── Help, version, stray options ────────────────────────────────────────────
# Handled before anything else: without this, `wts --help` went down the normal
# flow and created a worktree, a branch and a session named `--help`.

if [[ $# -lt 1 ]]; then
  usage >&2
  exit 1
fi

# Every subcommand, in one place. The --help guard, the typo guard and the
# dispatch below must agree on what is a command and what is a session name:
# nineteen words a session cannot be called, and one list to read them from.
typeset -ga WTS_COMMANDS
WTS_COMMANDS=(new ls status brief restore stop pr rm gc log retro task doc db
              send wait tail layouts keys doctor setup help version)

# sub_usage <command> — its own lines of the header above: the usage lines that
# name it, then its paragraph. Cut from the same text `wts help` prints, so the
# two cannot disagree.
sub_usage() {
  sed -n '3,/^$/p' "$WTS_SELF" | sed 's/^# \{0,1\}//' | awk -v c="$1" '
    /^Examples:/ { exit }
    # A usage line: "Usage: wts rm …", "       wts rm …", or a "| wts status" in one.
    /^(Usage:)? *wts / {
      inu = (index($0, "wts " c " ") || $0 ~ ("wts " c "$") || index($0, "wts " c "|"))
      if (inu) { sub(/^Usage: */, ""); sub(/^ */, ""); u[++nu] = $0 }
      next
    }
    inu && /^        +\[/ { sub(/^ */, "  "); u[++nu] = $0; next }
    { inu = 0 }
    # A description starts at two spaces and the command, and runs on through
    # the deeper-indented lines under it (an option like `-f` included).
    /^  [^ ]/ { ind = (index($0, "  " c " ") == 1) }
    ind && NF { d[++nd] = $0 }
    END {
      if (!nu && !nd) exit 1
      for (i = 1; i <= nu; i++) print (i == 1 ? "usage: " : "       ") u[i]
      if (nd) print ""
      for (i = 1; i <= nd; i++) print d[i]
    }'
}

case "$1" in
  help|-h|--help)       if [[ -n "${2:-}" ]] && (( ${WTS_COMMANDS[(Ie)$2]} )); then
                          sub_usage "$2"
                        else
                          usage
                        fi
                        exit 0 ;;
  version|-V|--version) print -r -- "wts $WTS_VERSION"; exit 0 ;;
  # --doc and --task are real options, they just cannot come first: the name (or
  # the phrase) does. Named here rather than reported as unknown, because
  # `wts --task <id>` is the obvious thing to try once a task carries the context
  # — and "unknown option '--task'" sends you to look for a typo.
  --doc*|--task*)       print -u2 -r -- "wts: '$1' labels a session, it does not name one."
                        print -u2 -r -- "     the name comes first:  wts <name> $*"
                        exit 2 ;;
  -*)                   print -u2 -r -- "wts: unknown option '$1' (see: wts help)"; exit 2 ;;
esac

# `wts <command> --help`, for every command, before any of them runs. `wts new
# --help` started a session named `--help`, `wts rm --help` tried to remove one,
# and each subcommand that had a guard had its own. An exact word only: a phrase
# or a note that merely contains "--help" is text.
if (( ${WTS_COMMANDS[(Ie)$1]} )); then
  for _a in "${@[2,-1]}"; do
    if [[ "$_a" == (-h|--help) ]]; then
      sub_usage "$1"
      exit 0
    fi
  done
  unset _a
fi

# ─── Subcommand: layouts ─────────────────────────────────────────────────────

if [[ "$1" == "layouts" ]]; then
  list=$(layout_list)
  if [[ -z "$list" ]]; then
    print -u2 -r -- "wts: no layout in $WTS_USER_LAYOUTS nor in $WTS_BUILTIN_LAYOUTS"
    exit 1
  fi
  print -r -- "$list"
  exit 0
fi

# ─── Subcommand: keys ────────────────────────────────────────────────────────
# The same list the switcher prints under its own list, from the same helper:
# `wts keys` is for the times the popup is not open — or not open yet.

if [[ "$1" == "keys" ]]; then
  if [[ ! -x "$WTS_LIBEXEC/wts-keys" ]]; then
    print -u2 -r -- "wts: key list not found ($WTS_LIBEXEC/wts-keys)"
    exit 1
  fi
  exec "$WTS_LIBEXEC/wts-keys"
fi

# ─── Subcommands: send, wait, tail ───────────────────────────────────────────
# Another session's agent, driven from a command: what the switcher does with
# keys, for an agent that delegated. In libexec/wts/wts-agent.

if [[ "$1" == (send|wait|tail) ]]; then
  if [[ ! -x "$WTS_LIBEXEC/wts-agent" ]]; then
    print -u2 -r -- "wts: $WTS_LIBEXEC/wts-agent not found"
    exit 1
  fi
  registry_init
  exec "$WTS_LIBEXEC/wts-agent" "$@"
fi

# ─── Subcommand: doctor ──────────────────────────────────────────────────────

if [[ "$1" == "doctor" ]]; then
  if [[ ! -x "$WTS_LIBEXEC/wts-doctor" ]]; then
    print -u2 -r -- "wts: $WTS_LIBEXEC/wts-doctor not found"
    exit 1
  fi
  if [[ -n "${2:-}" && "${2:-}" != --json ]]; then
    echo "usage: wts doctor [--json]" >&2
    exit 2
  fi
  exec "$WTS_LIBEXEC/wts-doctor" "$WTS_VERSION" "${2:-}"
fi

# ─── Subcommand: setup ───────────────────────────────────────────────────────

if [[ "$1" == "setup" ]]; then
  # Both snippets below outlive upgrades: a Homebrew path carries the version
  # (…/Cellar/wts/0.1.0/…) and would break on the next `brew upgrade`. The opt/
  # link is stable, so point there instead.
  libexec="$WTS_LIBEXEC"
  if [[ "$libexec" =~ '^(.*)/Cellar/wts/[^/]+/(.*)$' ]]; then
    libexec="${match[1]}/opt/wts/${match[2]}"
  fi

  # `wts setup claude`: the hooks that tell every Claude Code session started
  # in a wts session about the others, record what it reports about itself and
  # the files it edits, the permissions for the read-only verbs, and the skill
  # that documents the rest. Without them an agent never learns the shared
  # database exists: nothing in its context mentions it. User-wide on purpose —
  # the hooks are silent outside a wts session, a per-repository hook would miss
  # every new repository, and the skill is what lets a Claude started anywhere
  # find wts when the user asks about parallel work.
  if [[ "${2:-}" == "claude" ]]; then
    claude_settings="${CLAUDE_DIR}/settings.json"
    hook_cmd="$libexec/wts-context"
    event_cmd="$libexec/wts-hook"
    skill_dir="${CLAUDE_DIR}/skills/wts"
    skill_src="$WTS_PREFIX/share/wts/skill/SKILL.md"
    # The command the skill names when `wts` is not on the agent's PATH: the
    # same stable (opt/) prefix as the hooks.
    wts_cmd="${libexec:h:h}/bin/wts"
    allow_json=$(print -rl -- "${WTS_CLAUDE_ALLOW[@]}" | jq -Rsc 'split("\n") | map(select(. != ""))' 2>/dev/null)
    if [[ "${3:-}" != "--install" ]]; then
      cat <<EOF
// ─── wts setup claude (wts $WTS_VERSION) ─────────────────────────────────────
// Six Claude Code hooks. SessionStart (wts-context): in a wts session it adds
// to the agent's context its session, its task, the same repository's other
// sessions and their notes, and the files both have edited. The others
// (wts-hook) record what the agent reports about itself — a turn starts, ends,
// waits for a permission or an answer, the agent quits — which dates the states
// in \`wts ls\` and the switcher and rings when an agent needs you
// (WTS_NOTIFY=0 to turn that off); at a turn's start they hand the agent the
// notes its siblings left since its last turn; after an edit (PostToolUse)
// they record the file and say when another session edits it too. Anywhere
// outside a wts session every hook is silent. They read and write the wts
// database only: no git, no model.
//
// The permissions let an agent run the read-only verbs, and write its own
// notes, without a prompt. Never rm, gc, stop, send or a creation.
//
// --install also writes the wts skill to $skill_dir/SKILL.md:
// the reference an agent loads when it needs it, inside a session or not.
//
// Merge into $claude_settings, or let wts do it (backup kept):
//   wts setup claude --install
{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "$hook_cmd", "timeout": 5 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "$event_cmd prompt", "timeout": 10 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "$event_cmd stop", "timeout": 10 } ] }
    ],
    "Notification": [
      { "hooks": [ { "type": "command", "command": "$event_cmd notification", "timeout": 10 } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "$event_cmd end", "timeout": 10 } ] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [ { "type": "command", "command": "$event_cmd touch", "timeout": 10 } ] }
    ]
  },
  "permissions": {
    "allow": $allow_json
  }
}
EOF
      exit 0
    fi
    command -v jq >/dev/null 2>&1 || { echo "wts: jq is required for 'setup claude --install'" >&2; exit 1 }
    mkdir -p "${claude_settings:h}"
    [[ -s "$claude_settings" ]] || echo '{}' > "$claude_settings"
    cp "$claude_settings" "$claude_settings.bak"
    # Idempotent: on each event, any earlier wts entry (an older install path
    # included) is dropped before the current one is added; other hooks stay.
    # The allow rules are appended once each, in the user's own order.
    if jq --arg cmd "$hook_cmd" --arg ev "$event_cmd" --argjson allow "$allow_json" '
         def wts_free(e): [ (.hooks[e] // [])[]
           | .hooks = [ (.hooks // [])[]
                        | select((.command // "") | test("/wts-(context|hook)( |$)") | not) ]
           | select((.hooks | length) > 0) ];
         def add(e; c; t): .hooks[e] = (wts_free(e) + [ { hooks: [ { type: "command", command: c, timeout: t } ] } ]);
         def addm(e; m; c; t): .hooks[e] = (wts_free(e) + [ { matcher: m, hooks: [ { type: "command", command: c, timeout: t } ] } ]);
         add("SessionStart"; $cmd; 5)
         | add("UserPromptSubmit"; $ev + " prompt"; 10)
         | add("Stop"; $ev + " stop"; 10)
         | add("Notification"; $ev + " notification"; 10)
         | add("SessionEnd"; $ev + " end"; 10)
         | addm("PostToolUse"; "Edit|Write|MultiEdit|NotebookEdit"; $ev + " touch"; 10)
         | (.permissions.allow // []) as $cur
         | .permissions.allow = $cur + ($allow | map(select(. as $r | $cur | index($r) | not)))' \
         "$claude_settings.bak" > "$claude_settings.tmp.$$"; then
      mv "$claude_settings.tmp.$$" "$claude_settings"
      echo "→ hooks installed in $claude_settings (backup: settings.json.bak):"
      echo "   SessionStart (wts-context), UserPromptSubmit, Stop, Notification, SessionEnd, PostToolUse (wts-hook)"
      echo "   permissions.allow: the read-only wts verbs and the agent's own notes (no prompt for them)"
    else
      rm -f "$claude_settings.tmp.$$"
      echo "wts: $claude_settings is not valid JSON, left untouched" >&2
      exit 1
    fi
    # The skill: ours to overwrite (it says so in its first lines), never a
    # file of the same name the user wrote.
    if [[ -f "$skill_src" ]]; then
      if [[ -f "$skill_dir/SKILL.md" ]] && ! grep -q 'generated by `wts setup claude' "$skill_dir/SKILL.md"; then
        echo "⚠ $skill_dir/SKILL.md is not wts's own: left as it is" >&2
      else
        mkdir -p "$skill_dir"
        sed -e "s|{{WTS}}|$wts_cmd|g" -e "s|{{VERSION}}|$WTS_VERSION|g" "$skill_src" > "$skill_dir/SKILL.md"
        echo "   skill: $skill_dir/SKILL.md (what an agent loads when it needs wts)"
      fi
    fi
    echo "   new Claude sessions pick it up; running ones on their next /clear or /compact"
    exit 0
  fi

  # `wts setup git`: the two repository settings that keep `git status` fast
  # on a large tree. The collector runs it on every registered worktree at
  # every `wts ls` and switcher tick: 0.5 s per 150k-file worktree without
  # them, 0.04 s with (docs/big-repo-analysis.md). Printed, not applied: they
  # are repository-wide, and fsmonitor starts a daemon per worktree.
  if [[ "${2:-}" == "git" ]]; then
    cat <<'EOF'
# ─── wts setup git ───────────────────────────────────────────────────────────
# Run these in the repository (they apply to all its worktrees). fsmonitor is
# git's built-in file watcher (git 2.37+ on macOS): `git status` then asks the
# daemon what changed instead of walking the tree, and the untracked cache
# makes the untracked-file scan incremental. `wts ls` and the switcher go from
# seconds to a fraction of a second on a large repository.
git config core.fsmonitor true
git config core.untrackedCache true
# To undo: git config --unset core.fsmonitor; git fsmonitor--daemon stop
EOF
    exit 0
  fi
  if [[ "${2:-}" != "tmux" ]]; then
    print -u2 "usage: wts setup tmux [--install] | git | claude [--install]"
    exit 2
  fi

  # Between markers, so that a newer wts finds its own block and replaces it:
  # `wts setup tmux >> ~/.tmux.conf` was the only way in, and every upgrade
  # that followed the README appended a second block under the first. No blank
  # line inside the block — the releases before the markers are recognized by
  # "their header line down to the first blank line", and the rule must hold.
  tmux_snippet() {  # [--no-status]
    cat <<EOF
# >>> wts $WTS_VERSION >>> generated by \`wts setup tmux\`; \`--install\` replaces this block
# prefix+s: session switcher (fzf popup, agents that need you first).
# Replaces tmux's default choose-tree on prefix+s.
bind s display-popup -E -w 85% -h 70% "$libexec/wts-switch"
# prefix+a: jump to the agent that has waited for you the longest.
bind a run-shell "$libexec/wts-switch --next"
# \`C-b :\` then \`wts <name> …\`: create a session from a freshly fetched base.
# Absolute path on purpose: tmux execs the alias directly, without a shell, so
# neither ~ nor \$HOME would be expanded.
set -s command-alias[100] 'wts=new-window -n wts -c "#{pane_current_path}" $libexec/wts-fresh'
# prefix+g: the same prompt, pre-filled.
bind -N "wts: new session from a fresh origin base" g command-prompt -T command -I "wts "
EOF
    if [[ "${1:-}" == --no-status ]]; then
      print -r -- "# Status line: left where you put it, outside this block."
    else
      cat <<EOF
# Status line: "wts: 2 blocked · 1 idle" when agents need you, nothing when
# none does, refreshed every status-interval (15 s by default). Appended to
# status-right: keep this after the lines that set status-right (a theme's),
# or they overwrite it — moved out of this block, it is left alone.
set -ag status-right ' #($libexec/wts-status --line)'
EOF
    fi
    print -r -- "# <<< wts <<<"
  }

  if [[ "${3:-}" != "--install" ]]; then
    print
    tmux_snippet
    print
    print -r -- "# Write it into your tmux.conf, replacing an older wts block: wts setup tmux --install"
    exit 0
  fi

  # --install: ~/.tmux.conf, or the XDG file when that is the one tmux reads.
  tmux_conf="$HOME/.tmux.conf"
  xdg_conf="${XDG_CONFIG_HOME:-$HOME/.config}/tmux/tmux.conf"
  if [[ ! -e "$tmux_conf" && -e "$xdg_conf" ]]; then
    tmux_conf="$xdg_conf"
  fi
  [[ -e "$tmux_conf" ]] || : > "$tmux_conf"
  cp "$tmux_conf" "$tmux_conf.bak"

  # One awk for both passes, so they agree on what a wts block is: the marked
  # one, or a pre-marker one (its "generated by" header line, down to the first
  # blank line). mode=status counts the status lines OUTSIDE every block: a user
  # who moved it below a theme's `set -g status-right` (where it has to be) must
  # not get a second one inside the block.
  wts_blocks_awk='
    function in_block(line) {
      if (inm) { if (line ~ /^# <<< wts <<</) inm = 0; return 1 }
      if (ino) { if (line ~ /^[[:space:]]*$/) { ino = 0; return 0 } return 1 }
      if (line ~ /^# >>> wts /) { inm = 1; return 1 }
      if (line ~ /generated by `wts setup tmux`/) { ino = 1; return 1 }
      return 0
    }
    mode == "status" { if (!in_block($0) && $0 ~ /wts-status --line/) n++; next }
    {
      if (in_block($0)) {
        if (!done) { while ((getline l < snippet) > 0) print l; done = 1 }
        next
      }
      print
    }
    END {
      if (mode == "status") { print n + 0; exit }
      if (!done) {
        if (NR) print ""
        while ((getline l < snippet) > 0) print l
      }
    }'
  status_elsewhere=$(awk -v mode=status "$wts_blocks_awk" "$tmux_conf")
  snippet_file=$(mktemp "${TMPDIR:-/tmp}/wts-tmux.XXXXXX")
  if (( ${status_elsewhere:-0} > 0 )); then
    tmux_snippet --no-status > "$snippet_file"
  else
    tmux_snippet > "$snippet_file"
  fi
  if awk -v mode=write -v snippet="$snippet_file" "$wts_blocks_awk" "$tmux_conf.bak" \
       > "$tmux_conf.tmp.$$"; then
    mv "$tmux_conf.tmp.$$" "$tmux_conf"
    rm -f "$snippet_file"
  else
    rm -f "$snippet_file" "$tmux_conf.tmp.$$"
    echo "wts: $tmux_conf left untouched" >&2
    exit 1
  fi
  echo "→ wts $WTS_VERSION block written in $tmux_conf (backup: ${tmux_conf:t}.bak)"
  if (( ${status_elsewhere:-0} > 0 )); then
    echo "   your own wts-status line, outside the block, is kept as it is"
  fi
  echo "   reload: tmux source-file $tmux_conf"
  exit 0
fi

# ─── Subcommand: ls / status ─────────────────────────────────────────────────

if [[ "$1" == "ls" || "$1" == "status" ]]; then
  if ! registry_available || ! command -v jq >/dev/null 2>&1; then
    echo "wts: sqlite3 and jq are required for '$1'" >&2
    exit 1
  fi
  registry_init
  registry_prune

  sub="$1"; shift

  # `wts ls --json` printed the table and exited 0: the argument was dropped
  # without a word, and a script reading JSON got a box. `ls` takes nothing;
  # `status` is the one with formats.
  # --wide is the one option: the same table with four more columns.
  ls_wide=()
  if [[ "$sub" == ls && "${1:-}" == --wide ]]; then
    ls_wide=(--wide)
    shift
  fi
  if [[ "$sub" == ls ]] && (( $# )); then
    echo "wts ls takes only --wide (got '$1'); for a format: wts status --json|--table|--fzf" >&2
    exit 2
  fi

  if [[ ! -x "$WTS_LIBEXEC/wts-status" ]]; then
    echo "wts: status engine not found ($WTS_LIBEXEC/wts-status)" >&2
    exit 1
  fi

  if [[ "$sub" == "status" ]]; then
    exec "$WTS_LIBEXEC/wts-status" "${@:---json}"
  fi

  if [[ "$(db_ro 'SELECT count(*) FROM sessions')" == "0" ]]; then
    echo "No registered session."
    exit 0
  fi
  exec "$WTS_LIBEXEC/wts-status" --table "${ls_wide[@]}"
fi

# ─── Subcommand: brief ───────────────────────────────────────────────────────

if [[ "$1" == "brief" ]]; then
  if ! registry_available || ! command -v jq >/dev/null 2>&1; then
    echo "wts: sqlite3 and jq are required for 'brief'" >&2
    exit 1
  fi
  registry_init
  registry_prune
  shift

  # --cached [--json]: what the last `wts brief` wrote, from the database alone —
  # no git, no transcript, no model call. For an agent that wants to know where
  # its siblings stand without spending a summary per session on it, and for
  # anything that must not wait. `age_s` says how old each one is; a brief is
  # not re-validated here, which is the whole point of the flag.
  typeset -a brief_names
  brief_cached=false brief_json=false brief_names=()
  for n in "$@"; do
    case "$n" in
      --cached) brief_cached=true ;;
      --json)   brief_json=true ;;
      *)        brief_names+=("$n") ;;
    esac
  done
  if $brief_json && ! $brief_cached; then
    echo "wts brief: --json goes with --cached (a fresh brief calls the model; run wts brief first)" >&2
    exit 2
  fi
  if $brief_cached; then
    brief_where="1"
    (( ${#brief_names} )) && brief_where="s.name IN $(sql_list "${brief_names[@]}")"
    brief_sql="FROM sessions s LEFT JOIN briefs b ON b.session = s.name
               WHERE $brief_where ORDER BY s.name"
    if $brief_json; then
      db_ro "SELECT json_object('version', 1, 'briefs', coalesce(json_group_array(json_object(
               'session', s.name, 'body', b.body,
               'age_s', CASE WHEN b.updated_at IS NULL THEN NULL
                             ELSE CAST(strftime('%s', 'now') AS INTEGER) - b.updated_at END)), json('[]')))
             $brief_sql"
    else
      while IFS=$'\x1f' read -r -d $'\x1e' bname bbody bage; do
        [[ -n "$bname" ]] || continue
        if [[ -z "$bbody" ]]; then
          print -r -- "$bname  (no brief yet: wts brief $bname)"
        else
          print -r -- "$bname  ($(age_ago "$bage"))"
          print -r -- "$bbody" | sed 's/^/  /'
        fi
      done < <(db_rows "SELECT s.name, coalesce(b.body, ''),
                               coalesce(CAST(strftime('%s', 'now') AS INTEGER) - b.updated_at, 0)
                        $brief_sql")
    fi
    exit 0
  fi

  if [[ ! -x "$WTS_LIBEXEC/wts-brief" ]]; then
    echo "wts: $WTS_LIBEXEC/wts-brief not found" >&2
    exit 1
  fi

  # Same typo tolerance as `wts rm`.
  typeset -a names
  names=()
  for n in "$@"; do
    resolved=$(registry_resolve_name "$n") || exit 1
    names+=("$resolved")
  done
  exec "$WTS_LIBEXEC/wts-brief" "${names[@]}"
fi

# ─── Subcommand: restore ─────────────────────────────────────────────────────

if [[ "$1" == "restore" ]]; then
  if ! registry_available; then
    echo "wts: sqlite3 is required for 'restore'" >&2
    exit 1
  fi
  registry_init
  registry_prune
  shift

  typeset -a wanted
  wanted=("$@")

  # Layouts test WTS_RESTORE so they do not relaunch claude or any heavy
  # command in every restored session.
  export WTS_RESTORE=1

  restored=0
  ignored=0
  failed=0
  typeset -A seen_wanted
  seen_wanted=()

  while IFS=$'\x1f' read -r -d $'\x1e' name profile worktree subdir context docs; do
    [[ -n "$name" ]] || continue

    if (( ${#wanted} )) && [[ -z "${wanted[(r)$name]:-}" ]]; then
      continue
    fi
    seen_wanted[$name]=1

    if tmux has-session -t "=$name" 2>/dev/null; then
      echo "→ $name: already running"
      (( ignored++ )) || true
      continue
    fi

    if [[ ! -d "$worktree" ]]; then
      echo "⚠ $name: worktree $worktree not found, skipped" >&2
      (( failed++ )) || true
      continue
    fi

    if ! layout=$(layout_file "$profile"); then
      echo "⚠ $name: layout '$profile' not found, skipped" >&2
      (( failed++ )) || true
      continue
    fi

    workdir="$worktree"
    if [[ -n "$subdir" && -d "$worktree/$subdir" ]]; then
      workdir="$worktree/$subdir"
    fi

    export WTS_NAME="$name"
    export WTS_ROOT="$worktree"
    export WTS_WORKDIR="$workdir"
    export WTS_CONTEXT="$context"
    export WTS_PROMPT=""
    export WTS_PROMPT_FILE=""

    # The context file lives in the worktree, which survives a reboot — but not
    # a `wts gc` husk sweep or a manual rm. Rebuilt from the cache, never
    # fetched: a restore is not an explicit attach. Reset on every iteration,
    # like WTS_RESUME below.
    export WTS_DOC=""
    # `|| restore_task=""`: this file runs under `set -e`, and a failing read
    # must not abort a restore that has nothing to do with tasks.
    restore_task=$(db_task_of_session "$name" 2>/dev/null) || restore_task=""
    typeset -a restore_task_opt
    restore_task_opt=()
    if [[ -n "$restore_task" ]]; then
      restore_task_opt=(--task "$restore_task")
    fi
    if [[ ( -n "$docs" || -n "$restore_task" ) && -x "$WTS_LIBEXEC/wts-doc" ]]; then
      WTS_DOC=$("$WTS_LIBEXEC/wts-doc" materialize "$worktree" "$workdir" \
                  "${restore_task_opt[@]}" \
                  ${(s: :)docs} 2>/dev/null) || WTS_DOC=""
    fi

    # The layout pre-fills `claude --continue` when there is a conversation to
    # resume for this directory, plain `claude` otherwise (--continue would
    # fail). Reset on every iteration: the export would leak into the next one.
    export WTS_RESUME=""
    if [[ -n "$(print -rl -- "$(claude_project_dir "$workdir")"/*.jsonl(N))" ]]; then
      WTS_RESUME=1
    fi
    # The exact conversation, when the hooks recorded its id: `--continue`
    # resumes the most recent one in the directory, which may be a side chat
    # rather than the agent's. Only an id whose transcript is still there, and
    # only the characters `--resume` and the layout's quoting expect.
    export WTS_RESUME_ID=""
    resume_id=$(db_claude_session_of "$name") || resume_id=""
    if [[ -n "$resume_id" \
          && -f "$(claude_project_dir "$workdir")/$resume_id.jsonl" ]]; then
      WTS_RESUME_ID="$resume_id"
      WTS_RESUME=1
    fi

    if start_detached "$layout" "$name"; then
      echo "→ $name restored ($profile, $workdir)"
      (( restored++ )) || true
    else
      (( failed++ )) || true
    fi
  # docs: space-separated slugs (a slug has no space), split below.
  done < <(db_rows "SELECT name, profile, worktree, subdir, context,
                           (SELECT coalesce(group_concat(value, ' '), '') FROM json_each(docs))
                    FROM sessions ORDER BY name")

  # A name the registry does not hold was skipped without a word, and the run
  # ended "0 restored, 0 skipped", exit 0. Matched exactly, as always, in the
  # loop above; what it never met is reported here.
  for n in "${wanted[@]}"; do
    if [[ -z "${seen_wanted[$n]:-}" ]]; then
      echo "⚠ $n: no registered session of that name (wts ls)" >&2
      (( failed++ )) || true
    fi
  done

  echo "→ $restored session(s) restored, $ignored already running$( (( failed )) && echo ", $failed failed")"
  if (( restored > 0 )); then
    echo "   attach: tmux attach -t <name>   (or prefix+s)"
  fi
  # Non-zero when anything that should have come back did not: a reboot script
  # running `wts restore` read success with every session failed.
  if (( failed )); then
    exit 1
  fi
  exit 0
fi

# ─── Subcommand: stop ────────────────────────────────────────────────────────
# Kill the tmux session and nothing else: the worktree, the branch and the
# registry entry stay, so `wts restore <name>` brings the session back. `rm` is
# the full teardown. No git call here, so unlike `rm` it works from any
# directory: the switcher popup calls it from wherever tmux started it.

if [[ "$1" == "stop" ]]; then
  if [[ $# -ne 2 ]]; then
    echo "Usage: wts stop <name>" >&2
    exit 1
  fi

  # Session name: slashes sanitized, as at creation (team/foo → team-foo).
  SESSION="${2//\//-}"

  # A live session with exactly this name wins over typo tolerance. The
  # switcher also lists sessions wts never registered ("3", another project),
  # and resolving "3" through the registry would land on a registered "auth-3".
  if ! tmux has-session -t "=$SESSION" 2>/dev/null; then
    if resolved=$(registry_resolve_name "$SESSION"); then
      SESSION="$resolved"
    else
      exit 1
    fi
    if ! tmux has-session -t "=$SESSION" 2>/dev/null; then
      echo "→ no tmux session '$SESSION'" >&2
      exit 1
    fi
  fi

  # Never the current session: killing it detaches this client, and closes the
  # switcher popup when that is the caller. Same rule as wts gc. Checked after
  # resolution, so a typo that resolves to the current session is refused too.
  # #S is only meaningful under $TMUX: outside a client it names the last used
  # session.
  if [[ -n "${TMUX:-}" && "$(tmux display-message -p '#S' 2>/dev/null)" == "$SESSION" ]]; then
    echo "wts: '$SESSION' is the current session, not stopped (switch away first)" >&2
    exit 1
  fi

  # "Stopped", the verb of the command: the README and the popup said "kill"
  # for the same key, the CLI "stop", and nobody could tell they were one thing.
  tmux kill-session -t "=$SESSION"
  echo "→ session '$SESSION' stopped (tmux session closed)"
  if registry_has "$SESSION"; then
    echo "→ worktree kept, wts restore $SESSION restarts it"
  fi
  exit 0
fi

# ─── Subcommand: pr ──────────────────────────────────────────────────────────
# `gh pr view <branch> --web` in the session's repository. gh rather than a URL
# built from the remote: it finds the PR by head branch (merged and closed ones
# too), and works on a GitHub Enterprise remote. The switcher's ctrl-o calls this.

if [[ "$1" == "pr" ]]; then
  # --refresh: the cache behind the PR column, for every session or the ones
  # named. Names go through the resolver as everywhere else; wts-pr does the rest.
  if [[ " ${*:2} " == *" --refresh "* ]]; then
    typeset -a PR_ARGS=()
    for a in "${@:2}"; do
      if [[ "$a" == -* ]]; then
        PR_ARGS+=("$a")
      elif [[ "${PR_ARGS[-1]:-}" == --if-older ]]; then
        PR_ARGS+=("$a")
      elif resolved=$(registry_resolve_name "${a//\//-}"); then
        PR_ARGS+=("$resolved")
      else
        exit 1
      fi
    done
    exec "$WTS_LIBEXEC/wts-pr" "${PR_ARGS[@]}"
  fi
  if [[ $# -gt 2 ]]; then
    echo "Usage: wts pr [name] | wts pr --refresh [--json] [name...]" >&2
    exit 1
  fi

  if [[ $# -eq 2 ]]; then
    # Session name: slashes sanitized, as at creation (team/foo → team-foo).
    SESSION="${2//\//-}"
  elif [[ -n "${TMUX:-}" ]]; then
    # #S is only meaningful under $TMUX: outside a client it names the last
    # used session, which is not "the session I am in".
    SESSION=$(tmux display-message -p '#S' 2>/dev/null)
  else
    echo "Usage: wts pr <name> (no name needed inside a tmux session)" >&2
    exit 1
  fi

  if ! registry_available || [[ ! -s "$WTS_DB" ]]; then
    echo "wts: '$SESSION' is not a wts session" >&2
    exit 1
  fi
  if resolved=$(registry_resolve_name "$SESSION"); then
    SESSION="$resolved"
  else
    exit 1
  fi
  # The switcher also lists tmux sessions wts never created, and ctrl-o works
  # on any row: say so instead of asking gh about an unknown branch.
  if ! db_has_session "$SESSION"; then
    echo "wts: '$SESSION' is not a wts session" >&2
    exit 1
  fi
  BRANCH=$(db_session_field "$SESSION" branch)
  REPO_ROOT=$(db_session_field "$SESSION" repo_root)
  if [[ -z "$BRANCH" || ! -d "$REPO_ROOT" ]]; then
    echo "wts: '$SESSION' has no branch or repository in the registry" >&2
    exit 1
  fi

  if ! command -v gh >/dev/null 2>&1; then
    echo "wts: gh not found (brew install gh)" >&2
    exit 1
  fi

  # gh's own line ("Opening … in your browser.") is the success message. On
  # failure its stderr is the reason, and names the branch (no PR for it, not
  # logged in): one line, prefixed, so the popup shows something readable.
  if out=$(cd "$REPO_ROOT" && gh pr view "$BRANCH" --web 2>&1); then
    [[ -n "$out" ]] && print -r -- "$out"
    exit 0
  fi
  print -u2 -r -- "wts: ${out:-gh pr view failed for branch '$BRANCH'}"
  exit 1
fi

# ─── Subcommand: rm ──────────────────────────────────────────────────────────

if [[ "$1" == "rm" ]]; then
  if [[ $# -lt 2 ]]; then
    echo "Usage: wts rm <name> [-f]" >&2
    exit 1
  fi

  NAME="$2"
  FORCE=false
  # `--force` is the spelling people guess first: accept both.
  case "${3:-}" in
    -f|--force) FORCE=true ;;
    "") ;;
    *) echo "wts: unknown option '${3}' (use -f)" >&2; exit 1 ;;
  esac

  # Session/worktree name: slashes sanitized (e.g. team/foo → team-foo)
  SESSION="${NAME//\//-}"
  if [[ -z "$SESSION" ]]; then
    echo "wts: empty session name" >&2
    exit 1
  fi

  # Typo tolerance, but never on trust. The resolver matches substrings both
  # ways, so `wts rm api-v2` with no such session landed on `api` — and `-f`
  # force-removed it, with one line on stderr for all warning. An exact registry
  # name goes through; a guess is shown and confirmed, and refused outright when
  # nobody is there to confirm it (the switcher, a script).
  if ! registry_has "$SESSION"; then
    if resolved=$(registry_resolve_name "$SESSION"); then
      if [[ "$resolved" != "$SESSION" ]]; then
        if [[ -t 0 && -t 2 ]]; then
          if ! read -q "?Remove '$resolved' (matched from '$SESSION')? [y/N] "; then
            print -u2
            exit 1
          fi
          print -u2
        else
          echo "wts: no session '$SESSION' — did you mean '$resolved'? (rm takes the exact name when not interactive)" >&2
          exit 1
        fi
        SESSION="$resolved"
      fi
    else
      exit 1
    fi
  fi

  # Never the current session: killing it detaches this client and, from the
  # switcher, closes the popup in the middle of the teardown. Same rule as
  # `wts stop` and gc. #S is only meaningful under $TMUX.
  if [[ -n "${TMUX:-}" && "$(tmux display-message -p '#S' 2>/dev/null)" == "$SESSION" ]]; then
    echo "wts: '$SESSION' is the current session, not removed (switch away first)" >&2
    exit 1
  fi

  # Where the worktree is: the registry knows, the current directory does not.
  # `--show-toplevel` from inside a worktree named that worktree, and the path
  # derived from it (`<worktree>-worktrees/<name>`) existed nowhere: the tmux
  # session was killed, "no worktree" printed, and the registry row dropped —
  # the real worktree and its branch left behind, unlisted. A session of
  # another repository (the switcher lists them all) went the same way. Only a
  # name the registry never saw falls back to the repository at hand.
  REG_BRANCH=""
  if registry_has "$SESSION"; then
    worktree_path=$(db_session_field "$SESSION" worktree)
    repo_root=$(db_session_field "$SESSION" repo_root)
    REG_BRANCH=$(db_session_field "$SESSION" branch)
    # The recorded root may itself be a worktree (a session created from inside
    # another one), possibly gone since: git is asked from whichever of the two
    # still exists, and every git call below runs from the main worktree.
    if [[ -d "$worktree_path" ]]; then
      repo_root=$(main_worktree_of "$worktree_path")
    elif [[ -d "$repo_root" ]]; then
      repo_root=$(main_worktree_of "$repo_root")
    fi
  else
    if ! git rev-parse --git-dir >/dev/null 2>&1; then
      echo "wts: '$SESSION' is not a registered session, and $PWD is not a git repository" >&2
      exit 1
    fi
    repo_root=$(main_worktree_of "$(git rev-parse --show-toplevel)")
    repo_name=$(basename "$repo_root")
    worktree_base="${WTS_WORKTREES_BASE:-$(dirname "$repo_root")/${repo_name}-worktrees}"
    worktree_path="${worktree_base:A}/${SESSION}"
  fi

  if ! registry_has "$SESSION" && [[ ! -d "$worktree_path" ]] \
     && ! tmux has-session -t "=$SESSION" 2>/dev/null; then
    echo "wts: no session, worktree or registry entry named '$SESSION'" >&2
    exit 1
  fi

  # Before anything is killed: `git worktree remove` refuses a worktree with
  # changes, and learning that once the agent's session was gone left it dead
  # with its work half torn down. -f is the caller saying the changes go.
  if [[ -d "$worktree_path" && "$FORCE" != true ]]; then
    dirty=$(git -C "$worktree_path" --no-optional-locks status --porcelain 2>/dev/null | wc -l | tr -d ' ')
    if (( ${dirty:-0} > 0 )); then
      echo "wts: $worktree_path has ${dirty} modified or untracked file(s)" >&2
      echo "     commit or stash them, or: wts rm $SESSION -f" >&2
      exit 1
    fi
  fi

  # Whether the branch landed in the base, squash included (merge_verdict in
  # wts-db.zsh, gc's test). It names the archive's outcome, and lets step 3
  # delete a squash-merged branch, which `branch -d` refuses: ctrl-d on a row
  # the switcher shows as merged ended on "not merged (use -f)", the branch
  # left behind for gc. Asked under -f too: -f deletes the branch either way,
  # but a squash-merged session archived `abandoned` lied about how it ended.
  LANDED=""
  RM_BRANCH="$REG_BRANCH"
  if [[ -d "$worktree_path" ]]; then
    RM_BRANCH=$(git -C "$worktree_path" rev-parse --abbrev-ref HEAD 2>/dev/null) || RM_BRANCH="$REG_BRANCH"
  fi
  if [[ -n "$RM_BRANCH" && "$RM_BRANCH" != HEAD && -d "$repo_root" ]]; then
    merge_base_of "$repo_root"
    merge_scope "$repo_root" "$MERGE_BASE" "$MERGE_BASE_REF" "$RM_BRANCH"
    if merge_verdict "$RM_BRANCH"; then
      LANDED="$REPLY"
    fi
  fi

  # 1. Kill the tmux session
  if tmux has-session -t "=$SESSION" 2>/dev/null; then
    tmux kill-session -t "=$SESSION"
    echo "→ tmux session '$SESSION' killed"
  else
    echo "→ no tmux session '$SESSION'"
  fi

  # -f is the caller saying the branch may go whatever it holds: abandoned,
  # unless it did land.
  if [[ -n "$LANDED" ]]; then
    retro_outcome="$LANDED"
  elif [[ "$FORCE" == true ]]; then
    retro_outcome=abandoned
  else
    retro_outcome=removed
  fi
  RETRO_FACTS=""

  # From here to the archive below, the row has no worktree: say that it is
  # being torn down, so a listing run meanwhile leaves it alone (registry_prune).
  if registry_has "$SESSION"; then
    db_q "INSERT OR REPLACE INTO kv VALUES
          ($(sql_str "teardown:$SESSION"), strftime('%s', 'now'))" >/dev/null 2>&1 || true
  fi

  # 2. Remove the worktree (read its branch first)
  if [[ -d "$worktree_path" ]]; then
    BRANCH=$(git -C "$worktree_path" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")

    # Collect the archive facts while the worktree is still here: below, it is
    # removed before the conversations are even reported, so anywhere that reads
    # more natural is a directory that no longer exists. No model call on this
    # path — `wts rm` is synchronous with a human waiting for their prompt, and
    # is often used on work that is being abandoned. `wts retro` writes the text
    # later; three git reads and one INSERT is what nobody notices.
    # Every step here is guarded: this file runs under `set -e`, a missing
    # origin/HEAD is normal in a fresh repository, and losing `wts rm` to a
    # failed archive would be a poor trade.
    if [[ -z "${WTS_NO_ARCHIVE:-}" && -x "$WTS_LIBEXEC/wts-retro" ]]; then
      base_for_retro="${WTS_BASE_BRANCH:-}"
      if [[ -z "$base_for_retro" ]]; then
        base_for_retro=$(git -C "$repo_root" symbolic-ref --quiet --short \
                           refs/remotes/origin/HEAD 2>/dev/null || true)
        base_for_retro="${base_for_retro#origin/}"
      fi
      RETRO_FACTS=$(mktemp "${TMPDIR:-/tmp}/wts-rm-retro.XXXXXX" 2>/dev/null || true)
      if [[ -n "$RETRO_FACTS" ]]; then
        "$WTS_LIBEXEC/wts-retro" collect "$SESSION" "$worktree_path" "$BRANCH" \
          "$base_for_retro" "$retro_outcome" > "$RETRO_FACTS" 2>/dev/null || true
      fi
    fi

    # .wts/ is git-ignored, and `git worktree remove` leaves ignored files
    # behind: without this, every session that had a document would leave a
    # husk folder for `wts gc` to find. Never a symlink, never anything else.
    if [[ -d "$worktree_path/.wts" && ! -L "$worktree_path/.wts" ]]; then
      rm -rf -- "$worktree_path/.wts"
    fi

    # Deleting a 150k-file worktree takes git ten seconds, silently.
    echo "→ removing worktree $worktree_path…"
    wt_status=0
    if [[ "$FORCE" == true ]]; then
      git -C "$repo_root" worktree remove --force "$worktree_path" || wt_status=$?
    else
      git -C "$repo_root" worktree remove "$worktree_path" || wt_status=$?
    fi
    if (( wt_status != 0 )); then
      # git has said why on stderr (submodules, a lock). The registry row stays:
      # the session is gone, `wts restore` brings it back on this worktree.
      echo "⚠ worktree $worktree_path not removed — registry kept, wts restore $SESSION restarts the session" >&2
      [[ -n "${RETRO_FACTS:-}" ]] && rm -f "$RETRO_FACTS"
      exit 1
    fi
    echo "→ worktree $worktree_path removed"
  else
    echo "→ no worktree $worktree_path"
    # The branch the registry recorded: a worktree deleted by hand leaves a
    # prunable entry in git and a branch nobody else will clean up. Deleted
    # under the same rules as below (-d unless -f), so unmerged work is refused.
    BRANCH="$REG_BRANCH"
    if [[ -d "$repo_root" ]]; then
      git -C "$repo_root" worktree prune 2>/dev/null || true
    fi
    # Archived all the same, from what the registry knows: `wts ls` archives
    # such a session before it drops the row, and this path dropped it with its
    # notes, brief and task link unrecorded — whichever command came first
    # decided whether the session left a trace.
    if registry_has "$SESSION" && [[ -z "${WTS_NO_ARCHIVE:-}" && -x "$WTS_LIBEXEC/wts-retro" ]]; then
      RETRO_FACTS=$(mktemp "${TMPDIR:-/tmp}/wts-rm-retro.XXXXXX" 2>/dev/null || true)
      if [[ -n "$RETRO_FACTS" ]]; then
        registry_bare_facts "$retro_outcome" > "$RETRO_FACTS" 2>/dev/null || true
        RETRO_BARE=true
      fi
    fi
  fi

  # 3. Delete the branch
  if [[ -n "$BRANCH" && "$BRANCH" != "HEAD" && -d "$repo_root" ]]; then
    if [[ "$FORCE" == true ]]; then
      git -C "$repo_root" branch -D "$BRANCH" 2>/dev/null && \
        echo "→ branch $BRANCH deleted" || \
        echo "→ branch $BRANCH not found"
    elif [[ -n "$LANDED" && "$BRANCH" == "$RM_BRANCH" ]]; then
      # -D, as gc does: a squashed branch is not "merged" in git's sense, while
      # every one of its commits has an equivalent in the base.
      git -C "$repo_root" branch -D "$BRANCH" >/dev/null 2>&1 && \
        echo "→ branch $BRANCH deleted ($LANDED)" || \
        echo "→ branch $BRANCH not found"
    else
      git -C "$repo_root" branch -d "$BRANCH" 2>/dev/null && \
        echo "→ branch $BRANCH deleted" || \
        echo "⚠ branch $BRANCH not merged (use -f to force)"
    fi
  fi

  # 4. Point at the Claude conversations tied to this worktree. They are NOT
  # deleted, but the worktree they reference is gone: say where to find them
  # (claude --resume).
  if [[ -n "${worktree_path:-}" ]]; then
    proj=$(claude_project_dir "$worktree_path")
    if [[ -d "$proj" ]]; then
      n=$(print -rl -- "$proj"/*.jsonl(N) | grep -c . || true)
      if (( n > 0 )); then
        echo "→ $n conversation(s) kept in $proj"
      fi
    fi
  fi

  # 5. Archive, then remove from the registry. In that order: the archive row is
  # built from the registry row, the brief and the notes, which the next line
  # deletes. This is the index `wts rm` used to destroy.
  if [[ -n "${RETRO_FACTS:-}" && -s "$RETRO_FACTS" ]]; then
    if store_err=$("$WTS_LIBEXEC/wts-retro" store "$SESSION" < "$RETRO_FACTS" 2>&1 >/dev/null); then
      if [[ -n "${RETRO_BARE:-}" ]]; then
        echo "→ archived (wts log), from the registry alone: the worktree was already gone"
      else
        echo "→ archived (wts log) — retrospective pending: wts retro"
      fi
    else
      echo "⚠ not archived${store_err:+: $(first_line "$store_err")}"
    fi
  fi
  if [[ -n "${RETRO_FACTS:-}" ]]; then
    rm -f "$RETRO_FACTS"
  fi
  # Status 1 when the row is still there (registry_del has said why): the
  # session is torn down, and wts still lists it.
  registry_del "$SESSION" || exit 1

  exit 0
fi

# ─── Subcommand: gc ──────────────────────────────────────────────────────────

if [[ "$1" == "gc" ]]; then
  shift
  if [[ ! -x "$WTS_LIBEXEC/wts-gc" ]]; then
    echo "wts: $WTS_LIBEXEC/wts-gc not found" >&2
    exit 1
  fi
  exec "$WTS_LIBEXEC/wts-gc" "$@"
fi

# ─── Subcommands: log, retro ─────────────────────────────────────────────────
# The work journal. Both read the `archive` table, which no teardown deletes, so
# both are repository-independent: the database is global and an archived session
# outlives the checkout it came from.

if [[ "$1" == "log" ]]; then
  shift
  if [[ ! -x "$WTS_LIBEXEC/wts-log" ]]; then
    echo "wts: $WTS_LIBEXEC/wts-log not found" >&2
    exit 1
  fi
  registry_init
  exec "$WTS_LIBEXEC/wts-log" "$@"
fi

if [[ "$1" == "retro" ]]; then
  shift
  if [[ ! -x "$WTS_LIBEXEC/wts-retro" ]]; then
    echo "wts: $WTS_LIBEXEC/wts-retro not found" >&2
    exit 1
  fi
  registry_init
  exec "$WTS_LIBEXEC/wts-retro" write "$@"
fi

# The task layer. No typo tolerance on the arguments here, deliberately:
# `registry_resolve_name` matches on substrings, and `wts task link "rate
# limiting"` is a search phrase for Things, not an approximate session name — it
# would happily turn one into the other. Session names are matched exactly, in
# wts-task.
if [[ "$1" == "task" ]]; then
  shift
  if [[ ! -x "$WTS_LIBEXEC/wts-task" ]]; then
    echo "wts: $WTS_LIBEXEC/wts-task not found" >&2
    exit 1
  fi
  registry_init
  exec "$WTS_LIBEXEC/wts-task" "$@"
fi

# ─── Subcommand: doc ─────────────────────────────────────────────────────────
# The library of reusable context documents. `use` is the only verb that names a
# session, so the name is resolved here, where the registry and its typo
# tolerance live; every other verb goes straight to the helper.

if [[ "$1" == "doc" ]]; then
  if [[ ! -x "$WTS_LIBEXEC/wts-doc" ]]; then
    echo "wts: $WTS_LIBEXEC/wts-doc not found" >&2
    exit 1
  fi
  shift
  if [[ "${1:-}" == "use" ]]; then
    shift
    DOC_SLUG="${1:-}"
    (( $# > 0 )) && shift
    DOC_SESSION="${1:-}"
    if [[ -z "$DOC_SESSION" ]]; then
      # #S is only meaningful under $TMUX: outside a client it names the last
      # used session, which is not "the session I am in".
      [[ -n "${TMUX:-}" ]] && DOC_SESSION=$(tmux display-message -p '#S' 2>/dev/null || echo "")
      if [[ -z "$DOC_SESSION" ]]; then
        echo "Usage: wts doc use <slug> <session> (no session needed inside one)" >&2
        exit 1
      fi
    fi
    DOC_SESSION="${DOC_SESSION//\//-}"
    if ! registry_available || [[ ! -s "$WTS_DB" ]]; then
      echo "wts: '$DOC_SESSION' is not a wts session" >&2
      exit 1
    fi
    if resolved=$(registry_resolve_name "$DOC_SESSION"); then
      DOC_SESSION="$resolved"
    else
      exit 1
    fi
    DOC_WT=$(db_session_field "$DOC_SESSION" worktree)
    DOC_SUB=$(db_session_field "$DOC_SESSION" subdir)
    if [[ -z "$DOC_WT" || ! -d "$DOC_WT" ]]; then
      echo "wts: '$DOC_SESSION' has no worktree in the registry" >&2
      exit 1
    fi
    DOC_WD="$DOC_WT"
    if [[ -n "$DOC_SUB" && -d "$DOC_WT/$DOC_SUB" ]]; then
      DOC_WD="$DOC_WT/$DOC_SUB"
    fi
    exec "$WTS_LIBEXEC/wts-doc" use "$DOC_SLUG" "$DOC_SESSION" "$DOC_WT" "$DOC_WD"
  fi
  exec "$WTS_LIBEXEC/wts-doc" "$@"
fi

# ─── Subcommand: db ──────────────────────────────────────────────────────────
# The state database, for the Claude agents running in wts sessions (and for
# you). Everything is readable; the only thing writable from here is `notes`,
# keyed by the caller's session: the other tables are wts's own, and an agent
# rewriting them would desynchronize the registry from the worktrees.
# `--session <other>` writes as another session, from a terminal only: `wts db`
# is a verb an agent runs without a prompt (WTS_CLAUDE_ALLOW), and with it any
# agent could rewrite or delete what another one had left for the rest.

if [[ "$1" == "db" ]]; then
  shift
  db_available || { echo "wts: sqlite3 is required for 'db'" >&2; exit 1 }
  db_init || exit 1

  sub="${1:-help}"
  (( $# )) && shift
  db_session=""
  db_json=0
  db_all=0
  typeset -a db_args db_words
  db_args=()
  while (( $# )); do
    case "$1" in
      --session)   db_session="${2:-}"; shift ;;
      --session=*) db_session="${1#--session=}" ;;
      --json)      db_json=1 ;;
      --all)       db_all=1 ;;
      *)           db_args+=("$1") ;;
    esac
    shift
  done

  # The session a note belongs to: --session, else the one this command runs in.
  # With `write`, --session may only name the caller's own session unless a
  # person is typing (see above): a terminal on stdin, which is what an agent's
  # Bash tool lacks. Not stderr too — a caller that hides it would refuse a
  # person (the Things guard did, for three releases).
  db_need_session() {  # [write]
    local own
    if [[ -n "$db_session" ]]; then
      if ! db_has_session "$db_session"; then
        echo "wts db: '$db_session' is not a registered session (wts ls)" >&2
        exit 1
      fi
      if [[ "${1:-}" == write ]]; then
        own=$(db_current_session) || own=""
        if [[ "$db_session" != "$own" && ! -t 0 ]]; then
          echo "wts db: '$db_session' is another session: its notes are written from its own worktree, or from a terminal" >&2
          exit 2
        fi
      fi
      return 0
    fi
    db_session=$(db_current_session) && return 0
    echo "wts db: not inside a wts session; pass --session <name>" >&2
    exit 1
  }

  # Output mode: JSON on request, a box for a human, tab-separated with a
  # header for a program (an agent's Bash tool is not a terminal).
  typeset -a db_mode
  if (( db_json )); then db_mode=(-json)
  elif [[ -t 1 ]]; then db_mode=(-box)
  else db_mode=(-tabs -header)
  fi

  # The user tables, one name per line. Names come from wts's own schema, so a
  # line split is safe; they still go through db_ident before reaching SQL.
  db_table_names() {
    _db -readonly -safe "$WTS_DB" \
      "SELECT name FROM sqlite_master WHERE type = 'table'
         AND name NOT LIKE 'sqlite\_%' ESCAPE '\' ORDER BY name"
  }

  # A double-quoted SQL identifier. Only called on a name db_need_table has
  # found in sqlite_master: a table name typed by a caller is never trusted.
  db_ident() {
    local dq='"'
    print -r -- "$dq${1//$dq/$dq$dq}$dq"
  }

  db_need_table() {
    local n
    n=$(_db -readonly -safe "$WTS_DB" \
      "SELECT count(*) FROM sqlite_master WHERE type = 'table'
         AND name NOT LIKE 'sqlite\_%' ESCAPE '\' AND name = $(sql_str "$1")")
    if [[ "$n" != 1 ]]; then
      echo "wts db: no table '$1' (wts db tables)" >&2
      exit 1
    fi
  }

  # One SELECT per table, joined: a count needs the table's name as an
  # identifier, which no single query over sqlite_master can supply.
  db_tables_sql() {
    local t sql=""
    for t in ${(f)"$(db_table_names)"}; do
      sql+="${sql:+ UNION ALL }SELECT $(sql_str "$t") AS \"table\",
        (SELECT count(*) FROM $(db_ident "$t")) AS \"rows\",
        (SELECT count(*) FROM pragma_table_info($(sql_str "$t"))) AS \"columns\""
    done
    print -r -- "${sql:-SELECT NULL AS \"table\" WHERE 0} ORDER BY 1"
  }

  # The rows of a table for the picker, newest first: every column cut to 24
  # characters on one line, so a prompt or a note does not break the list.
  db_rows_sql() {
    local c cols="rowid AS \"#\""
    for c in ${(f)"$(_db -readonly -safe "$WTS_DB" \
                      "SELECT name FROM pragma_table_info($(sql_str "$1")) ORDER BY cid")"}; do
      cols+=", substr(replace(replace(coalesce(CAST($(db_ident "$c") AS TEXT), ''),
               char(10), ' '), char(9), ' '), 1, 24) AS $(db_ident "$c")"
    done
    print -r -- "SELECT $cols FROM $(db_ident "$1") ORDER BY rowid DESC"
  }

  # One record, one field per line whatever stdout is: a box of one row and
  # twenty columns is wider than any terminal.
  # db_row <-line|-json> <table> <rowid>: the table already checked.
  db_row() {
    local out
    out=$(_db -readonly -safe "$1" "$WTS_DB" \
      "SELECT * FROM $(db_ident "$2") WHERE rowid = $3")
    if [[ -z "$out" ]]; then
      echo "wts db: no row $3 in '$2'" >&2
      exit 1
    fi
    print -r -- "$out"
  }

  case "$sub" in
    path)
      print -r -- "$WTS_DB" ;;

    schema)
      if (( ${#db_args} > 1 )); then
        echo "Usage: wts db schema [<table>]" >&2
        exit 2
      fi
      if (( ${#db_args} == 0 )); then
        _db -readonly "$WTS_DB" '.schema'
      else
        db_need_table "${db_args[1]}"
        _db -readonly -safe "$WTS_DB" \
          "SELECT sql FROM sqlite_master
            WHERE tbl_name = $(sql_str "${db_args[1]}") AND sql IS NOT NULL"
      fi ;;

    tables)
      if (( ${#db_args} )); then
        echo "Usage: wts db tables [--json]" >&2
        exit 2
      fi
      _db -readonly -safe "${db_mode[@]}" "$WTS_DB" "$(db_tables_sql)" ;;

    row)
      if (( ${#db_args} != 2 )); then
        echo "Usage: wts db row <table> <rowid> [--json]" >&2
        exit 2
      fi
      if [[ "${db_args[2]}" != <-> ]]; then
        echo "wts db: rowid must be a number, not '${db_args[2]}'" >&2
        exit 1
      fi
      db_need_table "${db_args[1]}"
      if (( db_json )); then
        db_row -json "${db_args[1]}" "${db_args[2]}"
      else
        db_row -line "${db_args[1]}" "${db_args[2]}"
      fi ;;

    browse)
      if (( ${#db_args} > 1 )); then
        echo "Usage: wts db browse [<table>]" >&2
        exit 2
      fi
      # A picker needs a terminal to draw on and to read keys from; stdout may
      # well be captured (the record picked is printed there).
      if [[ ! -t 0 || ! -t 2 ]] || (( ! ${+commands[fzf]} )); then
        echo "wts db browse: needs a terminal and fzf; without them use" \
             "wts db tables, then wts db row <table> <rowid>" >&2
        exit 2
      fi
      db_fixed="${db_args[1]:-}"
      if [[ -n "$db_fixed" ]]; then
        db_need_table "$db_fixed"
      fi
      # Two fzf calls in a loop, not one fzf with reload binds: going back is
      # leaving the inner picker, and nothing runs in fzf's background group.
      while true; do
        if [[ -n "$db_fixed" ]]; then
          db_table="$db_fixed"
        else
          db_pick=$(_db -readonly -safe -column -header "$WTS_DB" "$(db_tables_sql)" |
            fzf --reverse --header-lines=2 --no-sort \
                --header 'enter: rows of the table   esc: quit' \
                --preview "${(q)WTS_SELF} db schema {1}" \
                --preview-window=right,50%,wrap) || exit 0
          # An array, then [1]: a one-word line split as ${${=x}[1]} stays a
          # scalar, and [1] is its first character.
          db_words=(${=db_pick})
          db_table="${db_words[1]:-}"
          db_need_table "$db_table"
        fi
        db_pick=$(_db -readonly -safe -column -header "$WTS_DB" "$(db_rows_sql "$db_table")" |
          fzf --reverse --header-lines=2 --no-sort \
              --header "${db_table}: enter prints the row   esc: back" \
              --preview "${(q)WTS_SELF} db row ${(q)db_table} {1}" \
              --preview-window=right,60%,wrap) || {
          if [[ -n "$db_fixed" ]]; then
            exit 0
          fi
          continue
        }
        # A row whose columns are all empty lists as its rowid alone: 14 read
        # as ${${=x}[1]} is 1, and the wrong record would print.
        db_words=(${=db_pick})
        db_rowid="${db_words[1]:-}"
        if [[ "$db_rowid" == <-> ]]; then
          db_row -line "$db_table" "$db_rowid"
          exit 0
        fi
      done ;;

    sql)
      if (( ${#db_args} != 1 )); then
        echo 'Usage: wts db sql "<SELECT ...>" [--json]' >&2
        exit 2
      fi
      # -readonly: no write reaches wts's tables. -safe: no .shell, no ATTACH,
      # no readfile()/writefile(): a query stays a query.
      _db -readonly -safe "${db_mode[@]}" "$WTS_DB" "${db_args[1]}" ;;

    get)
      if (( ${#db_args} != 1 )); then
        echo "Usage: wts db get <key> [--session <name>]" >&2
        exit 2
      fi
      db_need_session
      db_ro "SELECT value FROM notes WHERE session = $(sql_str "$db_session")
                                       AND key = $(sql_str "${db_args[1]}")" ;;

    set)
      if (( ${#db_args} != 2 )); then
        echo "Usage: wts db set <key> <value|-> [--session <name>]" >&2
        exit 2
      fi
      db_need_session write
      db_value="${db_args[2]}"
      [[ "$db_value" == - ]] && db_value="$(cat)"
      db_q "INSERT INTO notes (session, key, value, updated_at)
            VALUES ($(sql_str "$db_session"), $(sql_str "${db_args[1]}"),
                    $(sql_str "$db_value"), strftime('%Y-%m-%dT%H:%M:%SZ', 'now'))
            ON CONFLICT(session, key) DO UPDATE SET
              value = excluded.value, updated_at = excluded.updated_at" >/dev/null
      echo "→ $db_session/${db_args[1]}" >&2 ;;

    del)
      if (( ${#db_args} != 1 )); then
        echo "Usage: wts db del <key> [--session <name>]" >&2
        exit 2
      fi
      db_need_session write
      db_q "DELETE FROM notes WHERE session = $(sql_str "$db_session")
                                AND key = $(sql_str "${db_args[1]}")" >/dev/null ;;

    notes)
      if (( db_all )); then
        db_where="1"
      else
        db_need_session
        db_where="session = $(sql_str "$db_session")"
      fi
      _db -readonly "${db_mode[@]}" "$WTS_DB" \
        "SELECT session, key, value, updated_at FROM notes WHERE $db_where
         ORDER BY updated_at DESC, session, key" ;;

    help|-h|--help)
      print -r -- 'Usage: wts db <command>
  path                          where the database is
  tables [--json]               its tables, with their row and column counts
  schema [<table>]              the CREATE statements (of one table)
  row <table> <rowid> [--json]  one record, one field per line
  browse [<table>]              pick a table, then a row, in fzf (a terminal only)
  sql "<SELECT ...>" [--json]   any read-only query, over every table
  notes [--all] [--json]        this session'"'"'s notes (--all: every session'"'"'s)
  get <key>                     one note of this session
  set <key> <value|->           write a note ('"'"'-'"'"' reads stdin)
  del <key>                     remove a note
  --session <name>              another session'"'"'s notes (default: the one you are in);
                                set and del as another session: from a terminal only' ;;

    *)
      echo "wts db: unknown command '$sub' (wts db help)" >&2
      exit 2 ;;
  esac
  exit 0
fi

# session_json <name> <true|false: started by this call> — what a program needs
# after a creation, from the registry row it just wrote. A proposed name is only
# known once wts has made it unique, so an agent cannot guess it from the phrase.
session_json() {
  db_ro "SELECT json_object('version', 1, 'name', name, 'branch', branch,
           'worktree', worktree, 'repo_root', repo_root, 'layout', profile,
           'prompt', prompt, 'docs', json(docs),
           'task', coalesce((SELECT task FROM task_links WHERE session = name), ''),
           'started', json($(sql_str "$2")))
         FROM sessions WHERE name = $(sql_str "$1")" 2>/dev/null
}

# Created detached, never attached: --detach, or no terminal on stdin. The
# normal flow ends with `switch-client` under $TMUX, and run from an agent's
# pane that moved the human's terminal to the new session. Without a terminal
# there is nobody to attach anyway. --json implies it: whoever reads JSON is a
# program. Its progress lines then go to stderr, the JSON alone to stdout.
detach_mode() {
  if $JSON_OUT; then
    DETACH=true
    exec 3>&1 1>&2
  fi
  if [[ ! -t 0 ]]; then
    DETACH=true
  fi
  return 0
}

# ─── Subcommand: new ─────────────────────────────────────────────────────────
# Batch creation. Why: `wts a & wts b & wts c` does NOT work, because the
# normal flow ends with `exec tmuxinator start`: the first call replaces the
# process and the next ones are orphaned. Here each session is started with
# --no-attach (through WTS_NO_ATTACH), then the first one is attached.

if [[ "$1" == "new" ]]; then
  shift
  strip_doc_args "$@"
  set -- "${DOC_REST[@]}"
  detach_mode
  # A bare --doc is resolved once here: left to the children, the picker would
  # open once per session of the batch.
  if (( ${#DOC_REQ} )) && [[ -x "$WTS_LIBEXEC/wts-doc" ]]; then
    for i in {1..${#DOC_REQ}}; do
      if [[ -z "${DOC_REQ[i]}" ]]; then
        DOC_REQ[i]=$("$WTS_LIBEXEC/wts-doc" pick) || exit 1
      fi
    done
    DOC_REQ=("${(@)DOC_REQ:#}")
  fi
  # Same for a bare --task: resolved once, or the Things picker would open once
  # per session and the batch could end up spread over several tasks.
  if [[ "${TASK_ASKED:-false}" == true && -z "$TASK_REQ" ]]; then
    if [[ ! -x "$WTS_LIBEXEC/wts-task" ]]; then
      echo "wts: $WTS_LIBEXEC/wts-task not found" >&2
      exit 1
    fi
    TASK_REQ=$("$WTS_LIBEXEC/wts-task" resolve "") || exit 1
    [[ -n "$TASK_REQ" ]] || { echo "wts: no task chosen" >&2; exit 1 }
  fi
  NEW_PROFILE="default"
  if [[ "${1:-}" == "-p" ]]; then
    [[ -n "${2:-}" ]] || { echo "wts: -p expects a layout" >&2; exit 1 }
    NEW_PROFILE="$2"; shift 2
  fi

  if (( $# < 1 )); then
    echo "Usage: wts new [-p layout] <name|\"phrase\"...>" >&2
    exit 1
  fi

  typeset -a started failed created_json json_opt
  started=(); failed=(); created_json=(); json_opt=()
  if $JSON_OUT; then
    json_opt=(--json)
  fi

  # Each session's final name comes back through a file: with a phrase, it is
  # only known once the child has proposed it (and made it unique). No
  # inherited descriptor: tmuxinator or the tmux server would keep it open.
  # Sequential creations: in parallel, two similar phrases could get the same
  # name, each passing the uniqueness check before the other.
  unset WTS_NAME_HINT
  mkdir -p "$WTS_STATE_DIR"
  session_out="$WTS_STATE_DIR/.new.$$"

  for n in "$@"; do
    echo "── $n ($NEW_PROFILE)"
    rm -f "$session_out"
    # WTS_TASK_ARG as well as the documents: strip_doc_args has always read it,
    # but nothing ever set it, so `wts new --task <id> a b` parsed the flag and
    # then created three sessions linked to nothing.
    # The child's stdout is captured only under --json, where it is the JSON
    # and nothing else; otherwise it is this command's progress, as it was.
    child_out=""
    if $JSON_OUT; then
      if child_out=$(WTS_NO_ATTACH=1 WTS_SESSION_OUT="$session_out" \
           WTS_DOC_ARGS="${(pj:\x1f:)DOC_REQ}" WTS_TASK_ARG="${TASK_REQ:-}" \
           "$WTS_SELF" "$n" "$NEW_PROFILE" --json); then
        child_ok=true
      else
        child_ok=false
      fi
    elif WTS_NO_ATTACH=1 WTS_SESSION_OUT="$session_out" \
         WTS_DOC_ARGS="${(pj:\x1f:)DOC_REQ}" WTS_TASK_ARG="${TASK_REQ:-}" \
         "$WTS_SELF" "$n" "$NEW_PROFILE"; then
      child_ok=true
    else
      child_ok=false
    fi
    if $child_ok; then
      if [[ -s "$session_out" ]]; then
        started+=("$(<"$session_out")")
      else
        started+=("${n//\//-}")
      fi
      if [[ -n "$child_out" ]]; then
        created_json+=("$child_out")
      fi
    else
      failed+=("$n")
    fi
  done
  rm -f "$session_out"

  echo "→ ${#started} session(s) started$( (( ${#failed} )) && echo ", ${#failed} failed: ${(j:, :)failed}")"

  if $JSON_OUT; then
    print -r -- "${(F)created_json}" | jq -sc '.' >&3
  fi
  if $DETACH; then
    if (( ${#failed} )); then
      exit 1
    fi
    exit 0
  fi
  if (( ${#started} )); then
    echo "   attaching: ${started[1]}"
    attach_or_switch "${started[1]}"
  fi
  exit 1
fi

# ─── Normal flow ─────────────────────────────────────────────────────────────

strip_doc_args "$@"
set -- "${DOC_REST[@]}"
if (( $# < 1 )); then
  echo "wts: nothing to create (see: wts help)" >&2
  exit 2
fi
detach_mode
# `wts auth-form --help` asked for a layout named `--help`.
for _a in "$@"; do
  if [[ "$_a" == (-h|--help) ]]; then
    usage
    exit 0
  fi
done
unset _a

# ─── A typo is not a session ─────────────────────────────────────────────────
# `wts lsit` created a branch, a worktree and a tmux session named `lsit`, and
# started an agent in it. A single bare word close to a command, that names no
# session and no branch, is far likelier a slip than a new piece of work: say so
# and create nothing. Exit 2, as for an unknown option.
#
# Close means one edit for a word of three or four letters, two from five on,
# none under three (every two-letter word is one edit from `ls`, `pr`, `rm`,
# `gc` or `db`). The words people type for a command wts calls otherwise count
# only exactly or with two letters swapped: `lint` must stay a session name.
# Only `wts <word>` alone: any second word (a layout, `new`) is the way to say
# "yes, a session by that name".
closest_command() {  # <word> → the command, or failure
  local w="${1:l}"
  [[ "$w" =~ '^[a-z][a-z-]*$' ]] || return 1
  (( ${#w} >= 3 )) || return 1
  local c
  { for c in "${WTS_COMMANDS[@]}"; do print -r -- "$c $c"; done
    print -rl -- "list ls" "remove rm" "delete rm" "kill stop" "check doctor"
  } | awk -v q="$w" "$WTS_LEV_AWK"'
    function sorted(s,   n, i, j, t, a) {
      n = split(s, a, "")
      for (i = 2; i <= n; i++) { t = a[i]; for (j = i - 1; j > 0 && a[j] > t; j--) a[j+1] = a[j]; a[j+1] = t }
      t = ""; for (i = 1; i <= n; i++) t = t a[i]; return t
    }
    BEGIN { max = (length(q) >= 5) ? 2 : 1; best = 99 }
    {
      d = lev(q, $1)
      if ($1 != $2 && !(d == 0 || (d == 1 && sorted(q) == sorted($1)))) next
      if (d <= max && d < best) { best = d; cmd = $2 }
    }
    END { if (best < 99) { print cmd; exit 0 } exit 1 }'
}

if (( $# == 1 )) && _guess=$(closest_command "$1"); then
  _branch_hit=""
  if git rev-parse --git-dir >/dev/null 2>&1; then
    _branch_hit=$(git for-each-ref --count=1 --format='%(refname)' \
                    "refs/heads/$1" "refs/heads/*/$1" \
                    "refs/remotes/origin/$1" "refs/remotes/origin/*/$1" 2>/dev/null || true)
  fi
  if [[ -z "$_branch_hit" ]] && ! registry_has "$1" \
     && ! tmux has-session -t "=$1" 2>/dev/null; then
    echo "wts: '$1' is not a command — did you mean 'wts $_guess'?" >&2
    echo "     nothing was created. A session named '$1': wts $1 default" >&2
    exit 2
  fi
fi
unset _guess _branch_hit

# A phrase (an argument containing whitespace, in position 1 or 2) describes
# the task: it is removed from the positionals and handed to Claude
# ($WTS_PROMPT). No session, branch or layout name contains whitespace, so the
# detection cannot capture a legitimate argument. The context (position 3 and
# beyond) keeps its meaning: `wts sentry-X sentry "timeout on /api"`.
#   wts <name> "<phrase>" [layout] [context...]   name given: as before
#   wts "<phrase>" [layout] [context...]          name proposed by wts-name
PROMPT=""
NAME=""
if [[ "$1" == *[[:space:]]* ]]; then
  PROMPT="$1"; shift
elif [[ "${2:-}" == *[[:space:]]* ]]; then
  NAME="$1"; PROMPT="$2"; shift 2
else
  NAME="$1"; shift
fi
PROFILE="${1:-default}"
(( $# > 0 )) && shift
CONTEXT="$*"

# Newlines and tabs flattened: the phrase is typed in one go into the pane and
# stored in the registry.
PROMPT="${PROMPT//[[:cntrl:]]/ }"
if [[ -z "$NAME" && -z "${PROMPT//[[:space:]]/}" ]]; then
  echo "wts: empty phrase" >&2
  exit 1
fi
# tmux rewrites `.` and `:` in a session name (to `_`), so `has-session -t
# "=v1.2"` never matched the session it had just made: every re-run started a
# duplicate instead of attaching. Refused before anything exists.
if [[ "$NAME" == *[.:]* ]]; then
  echo "wts: '$NAME' cannot be a session name: tmux rewrites '.' and ':' in it" >&2
  echo "     use '-' instead: wts ${NAME//[.:]/-} …" >&2
  exit 2
fi

# ─── Layout ──────────────────────────────────────────────────────────────────
# Fail before creating the worktree if the layout does not exist.

if ! LAYOUT_FILE=$(layout_file "$PROFILE"); then
  echo "wts: layout '$PROFILE' not found" >&2
  typeset -a _layouts
  _layouts=(${${(f)"$(layout_list)"}%%$'\t'*})
  if (( ${#_layouts} )); then
    echo "     available: ${(j:, :)_layouts}" >&2
  else
    echo "     available: none ($WTS_USER_LAYOUTS, $WTS_BUILTIN_LAYOUTS)" >&2
  fi
  # `wts fix the login`: without quotes the phrase is split and "the" is taken
  # for a layout.
  if [[ -z "$PROMPT" && -n "$CONTEXT" ]]; then
    echo "     a phrase? quote it: wts \"$NAME $PROFILE $CONTEXT\"" >&2
  fi
  exit 1
fi

BRANCH_PREFIX=$(branch_prefix_of "$LAYOUT_FILE")

branch_for() {
  print -r -- "${BRANCH_PREFIX}$1"
}

# ─── Repo & worktree ─────────────────────────────────────────────────────────

if ! git rev-parse --git-dir >/dev/null 2>&1; then
  echo "wts: not a git repository" >&2
  exit 1
fi

repo_root=$(main_worktree_of "$(git rev-parse --show-toplevel)")
if [[ "$repo_root" != "$(git rev-parse --show-toplevel)" ]]; then
  echo "→ launched from a worktree, creating from $repo_root"
fi
repo_name=$(basename "$repo_root")
worktree_base="${WTS_WORKTREES_BASE:-$(dirname "$repo_root")/${repo_name}-worktrees}"
# Canonical: a WTS_WORKTREES_BASE with a trailing slash, or through a symlink,
# stored a path the collectors then compared as a string with git's canonical
# one and never matched — the agent column showed `-`, and gc's busy guard did
# not know an agent was there.
worktree_base="${worktree_base:A}"

# ─── Base branch ─────────────────────────────────────────────────────────────
# Priority: $WTS_BASE_BRANCH > origin/HEAD > main > master > current HEAD

detect_base_branch() {
  local head_ref
  head_ref=$(git -C "$repo_root" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)
  if [[ -n "$head_ref" ]]; then
    # origin/main → main
    echo "${head_ref#origin/}"
    return
  fi

  local candidate
  for candidate in main master; do
    if git -C "$repo_root" show-ref --verify --quiet "refs/heads/$candidate"; then
      echo "$candidate"
      return
    fi
  done

  git -C "$repo_root" rev-parse --abbrev-ref HEAD 2>/dev/null || true
}

BASE_BRANCH="${WTS_BASE_BRANCH:-$(detect_base_branch)}"

if [[ -z "$BASE_BRANCH" ]]; then
  echo "wts: cannot determine the base branch (set WTS_BASE_BRANCH)" >&2
  exit 1
fi

if ! git -C "$repo_root" rev-parse --verify --quiet "$BASE_BRANCH" >/dev/null; then
  echo "wts: base branch '$BASE_BRANCH' not found (set WTS_BASE_BRANCH)" >&2
  exit 1
fi

# ─── Task (--task) ───────────────────────────────────────────────────────────
# Before the documents, for the same reason they come before the naming call: a
# task that cannot be resolved must fail while nothing exists yet, and its picker
# must open before any wait rather than behind one. Resolved to an id here; the
# link is written after registry_put, since it references the session row.

typeset -g TASK_ID
TASK_ID=""
if [[ "${TASK_ASKED:-false}" == true ]]; then
  if [[ ! -x "$WTS_LIBEXEC/wts-task" ]]; then
    echo "wts: $WTS_LIBEXEC/wts-task not found" >&2
    exit 1
  fi
  if ! TASK_ID=$("$WTS_LIBEXEC/wts-task" resolve "$TASK_REQ"); then
    # `--task` always takes the next argument, so a layout typed after it is read
    # as a task. The same mistake as with --doc, and worth naming as precisely.
    if [[ -n "$TASK_REQ" ]] && layout_file "$TASK_REQ" >/dev/null 2>&1; then
      echo "wts: '--task $TASK_REQ' — '$TASK_REQ' is a layout, not a task." >&2
      echo "     layout then task:  wts ${NAME:-<name>} $TASK_REQ --task <id>" >&2
      echo "     task then layout:  wts ${NAME:-<name>} --task=<id> $TASK_REQ" >&2
    fi
    exit 1
  fi
  if [[ -z "$TASK_ID" ]]; then
    echo "wts: no task chosen" >&2
    exit 1
  fi
  # A task the author has already described IS the phrase. Without this,
  # `wts fix-audit --task <id>` started the agent on nothing at all: the task
  # reached the registry and the context file, and the one place the agent
  # actually reads first — its own command line — said nothing about the work.
  # Before the naming call, so an unnamed `wts "<phrase>" --task <id>` is
  # unaffected (its phrase was parsed above and wins).
  if [[ -z "$PROMPT" ]]; then
    PROMPT=$("$WTS_LIBEXEC/wts-task" title "$TASK_ID" 2>/dev/null) || PROMPT=""
    PROMPT="${PROMPT//[[:cntrl:]]/ }"
  fi
fi

# ─── Documents (--doc) ───────────────────────────────────────────────────────
# Resolved here, after the layout, the repository and the base branch have been
# validated and before the naming call: an unknown document must fail while
# nothing exists yet — no branch, no worktree, no model call — and the picker
# must open before the "naming…" wait rather than behind it.

typeset -a DOC_SLUGS
DOC_SLUGS=()
if (( ${#DOC_REQ} )); then
  if [[ ! -x "$WTS_LIBEXEC/wts-doc" ]]; then
    echo "wts: $WTS_LIBEXEC/wts-doc not found" >&2
    exit 1
  fi
  for _req in "${DOC_REQ[@]}"; do
    if [[ -z "$_req" ]]; then
      _slug=$("$WTS_LIBEXEC/wts-doc" pick) || exit 1
      [[ -n "$_slug" ]] || continue
    elif ! _slug=$("$WTS_LIBEXEC/wts-doc" resolve "$_req"); then
      # `--doc` always takes the next argument, so a layout typed after it is
      # read as a document. It is the one mistake worth naming precisely.
      if layout_file "$_req" >/dev/null 2>&1; then
        echo "wts: '--doc $_req' — '$_req' is a layout, not a document." >&2
        echo "     layout then doc:  wts ${NAME:-<name>} $_req --doc <slug>" >&2
        echo "     doc then layout:  wts ${NAME:-<name>} --doc=<slug> $_req" >&2
      else
        echo "wts: '--doc $_req' — not a document, a URL or a readable file" >&2
        echo "     the library: wts doc ls" >&2
      fi
      exit 1
    fi
    DOC_SLUGS+=("$_slug")
  done
fi

# The URLs the task carries in its notes — the Notion page, the meeting minutes,
# the Slack thread — become context documents too, after the explicit --doc ones:
# they are the material the agent would otherwise be told to go and find.
#
# WTS_NO_LLM for these, deliberately: wts-doc then records each one as a POINTER
# instead of fetching it. A task carries one to three links, the fetch model is
# sonnet with a 90 s cap, and paying that at creation would put minutes in front
# of a starting agent. A pointer is also simply likelier to work — a Slack
# permalink or a private Notion page is exactly what the sandboxed fetch cannot
# read and the agent in the pane can. `wts doc sync` fetches them later.
if [[ -n "${TASK_ID:-}" && -x "$WTS_LIBEXEC/wts-doc" ]]; then
  integer _task_docs=0
  # The documents the author attached to the task itself (`wts task doc`) come
  # first: they are already in the library and already fetched, so a pointer to
  # the same page found in the notes below is skipped as a duplicate rather than
  # replacing a document wts can actually read.
  while IFS= read -r _slug; do
    [[ -n "$_slug" ]] || continue
    if (( ${DOC_SLUGS[(Ie)$_slug]} == 0 )); then
      DOC_SLUGS+=("$_slug")
      (( ++_task_docs ))
    fi
  done < <("$WTS_LIBEXEC/wts-task" docs "$TASK_ID" 2>/dev/null)
  while IFS= read -r _url; do
    [[ -n "$_url" ]] || continue
    if _slug=$(WTS_NO_LLM=1 "$WTS_LIBEXEC/wts-doc" resolve "$_url" 2>/dev/null); then
      # A document already attached by --doc must not be listed twice. (Ie) and
      # not (r): the reverse subscript yields nothing on an empty array, which
      # `set -u` reports as an unset parameter.
      if [[ -n "$_slug" ]] && (( ${DOC_SLUGS[(Ie)$_slug]} == 0 )); then
        DOC_SLUGS+=("$_slug")
        (( ++_task_docs ))
      fi
    fi
  done < <("$WTS_LIBEXEC/wts-task" links "$TASK_ID" 2>/dev/null)
  if (( _task_docs )); then
    echo "→ task: $_task_docs document(s) from the task attached as context"
  fi
fi

# ─── Session name ────────────────────────────────────────────────────────────
# Phrase without a name: wts-name proposes a slug. Placed after the cheap checks
# (layout, repo, base): the model is never called for a creation bound to fail.
# wts-fresh computes it during its fetch and passes it through WTS_NAME_HINT.

if [[ -z "$NAME" ]]; then
  slug="${WTS_NAME_HINT:-}"
  if [[ ! "$slug" =~ '^[a-z0-9][a-z0-9-]*$' ]]; then
    # Up to WTS_NAME_TIMEOUT (30 s) behind one line, and Ctrl-C used to abort
    # the whole creation — the one key anybody presses while waiting. Now it
    # cuts the wait short: the terminal's SIGINT reaches wts-name and its
    # `claude` (same process group), the trap keeps wts alive, and the name is
    # derived from the phrase locally, which is what a timeout gives anyway.
    _naming_cut=0
    _naming_t0=$SECONDS
    trap '_naming_cut=1' INT
    if [[ -t 2 ]]; then
      echo "→ naming… (Ctrl-C: derive it from the phrase now)"
    else
      echo "→ naming…"
    fi
    slug=$("$WTS_LIBEXEC/wts-name" "$PROMPT") || slug=""
    if (( _naming_cut )) || [[ -z "$slug" ]]; then
      slug=$(WTS_NO_LLM=1 "$WTS_LIBEXEC/wts-name" "$PROMPT" 2>/dev/null) || slug=""
      # A line of its own: the terminal has just echoed `^C` where the cursor was.
      if (( _naming_cut )); then
        echo
      fi
      echo "→ naming interrupted after $(( SECONDS - _naming_t0 ))s: '$slug', from the phrase"
    elif (( SECONDS - _naming_t0 >= 3 )); then
      echo "→ named in $(( SECONDS - _naming_t0 ))s"
    fi
    trap - INT
    unset _naming_cut _naming_t0
    if [[ -z "$slug" ]]; then
      echo "wts: no name could be derived from the phrase; name it: wts <name> \"<phrase>\"" >&2
      exit 1
    fi
  fi

  # A guessed name must NEVER land on an existing branch: the resolution below
  # would silently check it out (cases 1 and 2) and the agent would start from
  # another session's work. Suffix -2, -3… until the name is free everywhere.
  # Local remote refs are not enough (wts-fresh only fetches the base): a single
  # ls-remote with a trailing pattern covers every suffix at once.
  remote_heads=$(perl -e 'alarm shift; exec @ARGV' 5 \
    git -C "$repo_root" ls-remote --heads origin "$(branch_for "$slug")*" 2>/dev/null \
    | awk '{ sub(/^refs\/heads\//, "", $2); print $2 }' || true)

  name_taken() {
    local b
    b=$(branch_for "$1")
    [[ -e "$worktree_base/$1" ]] && return 0
    registry_has "$1" && return 0
    tmux has-session -t "=$1" 2>/dev/null && return 0
    git -C "$repo_root" show-ref --verify --quiet "refs/heads/$b" && return 0
    git -C "$repo_root" show-ref --verify --quiet "refs/remotes/origin/$b" && return 0
    print -r -- "$remote_heads" | grep -qxF -- "$b" && return 0
    return 1
  }

  for candidate in "$slug" "$slug"-{2..9}; do
    if ! name_taken "$candidate"; then
      NAME="$candidate"
      break
    fi
  done
  if [[ -z "$NAME" ]]; then
    echo "wts: no free name from '$slug' to '$slug-9'" >&2
    echo "     name it yourself: wts <name> \"<phrase>\"" >&2
    exit 1
  fi
  echo "→ name: $NAME"
fi

BRANCH=$(branch_for "$NAME")

# Session/worktree name: slashes sanitized (branches like team/foo → team-foo)
SESSION="${NAME//\//-}"
worktree_path="${worktree_base}/${SESSION}"

# A name the registry holds for ANOTHER repository is refused, whoever typed
# it: the row is keyed on the name alone, so registry_put would overwrite the
# other session's paths, and the "already running, attaching" branch below
# would then attach to ITS tmux session — nothing started here, and the other
# worktree gone from the registry. Session names are global to the tmux
# server. Compared on git's common directory, not on repo_root: a session
# created from inside another worktree used to record that worktree as its root.
if registry_has "$SESSION"; then
  other_root=$(db_session_field "$SESSION" repo_root)
  if [[ -n "$other_root" && -d "$other_root" ]]; then
    other_common=$(git -C "$other_root" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)
    this_common=$(git -C "$repo_root" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)
    if [[ -n "$other_common" && -n "$this_common" && "${other_common:A}" != "${this_common:A}" ]]; then
      echo "wts: '$SESSION' is already a session of $other_root" >&2
      echo "     session names are global to the tmux server: pick another one, e.g. ${repo_name}-${SESSION}" >&2
      exit 1
    fi
  fi
fi

# A name the registry still holds for a worktree that is gone, about to get a
# NEW branch: another piece of work under a name used before. Its row is
# archived and dropped first (registry_prune). registry_put upserts on the name
# alone, so the new session was born with the old one's creation date, notes,
# events, brief, task link and PR state — and the transcript lookups, bounded
# by that date, reached back into the previous conversations. When the branch
# still exists the worktree is being brought back for the same work, and the
# row is that work's: kept.
if registry_has "$SESSION" && [[ ! -d "$worktree_path" ]] \
   && ! git -C "$repo_root" show-ref --verify --quiet "refs/heads/$BRANCH"; then
  registry_prune "$SESSION"
fi

# What the session needs to start, checked while nothing exists: tmuxinator was
# discovered missing by the `exec` at the very end, after the branch and the
# worktree had been created and the registry row written — a husk, every time.
# `wts doctor` checks the rest.
if ! command -v tmuxinator >/dev/null 2>&1; then
  echo "wts: tmuxinator not found — nothing was created (brew install tmuxinator; wts doctor)" >&2
  exit 1
fi
if ! command -v tmux >/dev/null 2>&1; then
  echo "wts: tmux not found — nothing was created (brew install tmux; wts doctor)" >&2
  exit 1
fi

mkdir -p "$worktree_base"

if [[ ! -d "$worktree_path" ]]; then
  echo "→ creating worktree $worktree_path (branch $BRANCH)"
  if git -C "$repo_root" show-ref --verify --quiet "refs/heads/$BRANCH"; then
    # Existing local branch → checkout
    git -C "$repo_root" worktree add "$worktree_path" "$BRANCH"
  elif { echo "  → checking origin for $BRANCH…";
         # A round trip on every new branch, once with nothing on screen and
         # no timeout: on a slow link this hung. Same 5-second cap as the
         # uniqueness sweep above; a timeout means "not found", i.e. a new
         # branch, which is what a failed check meant already.
         perl -e 'alarm shift; exec @ARGV' 5 \
           git -C "$repo_root" ls-remote --exit-code --heads origin "$BRANCH" >/dev/null 2>&1; }; then
    # Existing branch on origin (review) → fetch + tracking checkout
    echo "  → branch found on origin, checking out with tracking"
    git -C "$repo_root" fetch --quiet origin "+refs/heads/${BRANCH}:refs/remotes/origin/${BRANCH}"
    git -C "$repo_root" worktree add --track -b "$BRANCH" "$worktree_path" "origin/$BRANCH"
  else
    # New branch from the base.
    # --no-track: when the base is a remote ref (WTS_BASE_BRANCH=origin/main,
    # which wts-fresh sets), `worktree add -b` would make origin/main the new
    # branch's upstream: `git status` would announce "behind origin/main",
    # `git pull` would merge the base, and `wts gc` would never see `[gone]`.
    # No effect when the base is a local branch: git tracks nothing then
    # (branch.autoSetupMerge=true).
    git -C "$repo_root" worktree add --no-track -b "$BRANCH" "$worktree_path" "$BASE_BRANCH"
  fi
else
  echo "→ existing worktree: $worktree_path"
fi

# ─── Working subdirectory (optional) ─────────────────────────────────────────
# When $WTS_SUBDIR is set (e.g. by direnv in a monorepo), panes start in that
# subdirectory of the worktree instead of its root.

WORKDIR="$worktree_path"
if [[ -n "${WTS_SUBDIR:-}" ]]; then
  if [[ -d "$worktree_path/$WTS_SUBDIR" ]]; then
    WORKDIR="$worktree_path/$WTS_SUBDIR"
  else
    echo "⚠ WTS_SUBDIR='$WTS_SUBDIR' not found in the worktree, starting at the root" >&2
  fi
fi

# ─── Context documents ───────────────────────────────────────────────────────
# Written after the worktree exists and before the layout is rendered. The path
# is relative to the pane's working directory, because Claude Code resolves an
# `@` reference from the pane's cwd.

# A task with notes but no document still gets a context file: its title, status
# and the author's notes are exactly what the agent needs first, and the layout
# already tells it to read this file. The task is passed as an id rather than
# looked up from task_links, which is only written below — after registry_put,
# because it references the session row.
WTS_DOC=""
# An array and not `${TASK_ID:+--task "$TASK_ID"}`: zsh does not word-split an
# unquoted expansion, so that form hands materialize ONE argument reading
# "--task <id>", which is not the flag and is then looked up as a document slug.
typeset -a TASK_OPT
TASK_OPT=()
if [[ -n "${TASK_ID:-}" ]]; then
  TASK_OPT=(--task "$TASK_ID")
fi
if (( ${#DOC_SLUGS} )) || (( ${#TASK_OPT} )); then
  if WTS_DOC=$("$WTS_LIBEXEC/wts-doc" materialize "$worktree_path" "$WORKDIR" \
                 "${TASK_OPT[@]}" "${DOC_SLUGS[@]}"); then
    echo "→ context: ${#DOC_SLUGS} document(s) in $WTS_DOC"
  else
    echo "⚠ the context document could not be written" >&2
    WTS_DOC=""
  fi
fi

# ─── The phrase, as a file ───────────────────────────────────────────────────
# The layout used to type `claude '<phrase>'` into the pane, and tmuxinator
# types it before the pane's shell is ready: the tty is still in canonical
# mode, which keeps 1024 bytes of a line (MAX_CANON on macOS) and drops the
# rest. A phrase of about 1 KB once escaped lost its closing quote, the shell
# waited for it, and claude never started. The pane now reads the phrase from
# this file (`claude "$(cat …)"`), a line of fixed length. Same directory and
# ignore rule as the context document (wts-doc materialize).
WTS_PROMPT_FILE=""
if [[ -n "$PROMPT" ]] && mkdir -p "$worktree_path/.wts" 2>/dev/null; then
  if [[ ! -f "$worktree_path/.wts/.gitignore" ]]; then
    print -r -- '*' > "$worktree_path/.wts/.gitignore" 2>/dev/null || true
  fi
  if print -r -- "$PROMPT" > "$worktree_path/.wts/prompt" 2>/dev/null; then
    WTS_PROMPT_FILE="$worktree_path/.wts/prompt"
  fi
fi

# ─── tmuxinator ──────────────────────────────────────────────────────────────

# Variables exposed to the YAML layout through ERB (ENV['WTS_*'])
export WTS_NAME="$SESSION"
export WTS_ROOT="$worktree_path"
export WTS_WORKDIR="$WORKDIR"
export WTS_CONTEXT="$CONTEXT"
export WTS_PROMPT="$PROMPT"
export WTS_PROMPT_FILE
export WTS_DOC

# ─── Registry ────────────────────────────────────────────────────────────────
# Recorded before the exec: exec replaces the current process.

DOCS_JSON="[]"
if (( ${#DOC_SLUGS} )); then
  DOCS_JSON=$(printf '%s\n' "${DOC_SLUGS[@]}" | jq -R . | jq -sc .) || DOCS_JSON="[]"
fi
registry_put "$SESSION" "$PROFILE" "$repo_root" "$worktree_path" "$BRANCH" \
  "${WTS_SUBDIR:-}" "$CONTEXT" "$PROMPT" "$DOCS_JSON"

# After registry_put: task_links references the session row. Idempotent, so an
# `wts <name> --task <id>` re-run on a live session just repoints the link.
if [[ -n "${TASK_ID:-}" ]]; then
  if "$WTS_LIBEXEC/wts-task" link "$TASK_ID" "$SESSION" >/dev/null 2>&1; then
    echo "→ task: $("$WTS_LIBEXEC/wts-task" title "$TASK_ID" 2>/dev/null)"
  else
    echo "⚠ task $TASK_ID not linked" >&2
  fi
fi

# `wts new` reads the chosen name back here (it may have been proposed, then
# suffixed).
if [[ -n "${WTS_SESSION_OUT:-}" ]]; then
  print -r -- "$SESSION" > "$WTS_SESSION_OUT"
fi

# Detached (--detach, --json, no terminal, or WTS_NO_ATTACH from `wts new`):
# without it, the `exec` below would make any chaining impossible, and from an
# agent's pane it would move the human's terminal.
if $DETACH; then
  started_now=false
  if tmux has-session -t "=$SESSION" 2>/dev/null; then
    echo "→ tmux session '$SESSION' already running"
  elif start_detached "$LAYOUT_FILE" "$SESSION"; then
    echo "→ session '$SESSION' started"
    started_now=true
  else
    exit 1
  fi
  if $JSON_OUT; then
    session_json "$SESSION" "$started_now" >&3
  fi
  exit 0
fi

# Idempotence: if the session already exists, attach to it
if tmux has-session -t "=$SESSION" 2>/dev/null; then
  echo "→ tmux session '$SESSION' already running, attaching"
  attach_or_switch "$SESSION"
else
  exec tmuxinator start --project-config "$LAYOUT_FILE" --name "$SESSION" --suppress-tmux-version-warning
fi
