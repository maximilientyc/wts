#!/usr/bin/env zsh
# wts-status — state engine: registry + git + tmux + claude agents -> JSON
#
# Usage: wts-status [--json | --table [--wide] | --fzf] [--no-git] [name...]
#
#   --json  (default) JSON array, one object per registered worktree
#   --table colored column rendering for `wts ls`
#   --wide  with --table: TOKENS, COST and MODEL too (`wts ls --wide`), read
#           from the usage table that wts brief and the archive fill. --json
#           carries the same as `usage`, except with --no-git (null there).
#           CTX is the context window in use, from the status line's gauges
#           (context_pct, rate_limits, cost_reported_usd in --json, null
#           without `wts setup claude --statusline`)
#   --fzf   sorted lines (stuck first, merged last) for wts-switch, fields separated by
#           \x1f: TAB is an IFS whitespace and would collapse empty fields (an
#           agent without a tmux pane would shift every column).
#   --no-git  agents and tmux only: the git columns are 0 in --json and "-" in
#           the presentation formats. What prefix+a and the switcher's first
#           fill need, in 50 ms instead of the seconds a `git status` on every
#           worktree costs on a large repository.
#   name... only these registered sessions (wts brief <name>).
#
# Principle: a single collection pass (one claude call, one tmux call), then
# rendering. No format may fail because a tool is missing: the affected
# columns become null/"-" and the rest is displayed.

# No `set -e`: git/tmux/claude legitimately fail (worktree gone, tmux server
# down, claude not in PATH) and we want to degrade, not die.
set -uo pipefail

# `git status` takes <gitdir>/index.lock BEFORE it scans and holds it until it
# has written the refreshed index back. This collector statuses every registered
# worktree, on every `wts ls`, every switcher refresh (every 2 s) and every
# prefix+a — so an agent's `git add` in one of those worktrees died with "Unable
# to create index.lock: File exists", and a pass killed mid-scan (the switcher's
# poller replaces the one in flight) left a zero-byte lock behind for good,
# breaking every write in that worktree until someone deleted it by hand.
#
# With optional locks off the refresh stays in memory: no lock file is ever
# created, so there is nothing to contend for and nothing to leave behind. The
# only thing given up is persisting the stat cache — a write this collector had
# no business making in someone else's worktree — and fsmonitor still answers,
# so a status on a 95k-file repository stays at ~0.1 s.
export GIT_OPTIONAL_LOCKS=0

source "${0:A:h}/wts-db.zsh"
CLAUDE_SESSIONS_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/sessions"

# An agent reports `working` but its pane has not changed for this long: it is
# marked `stale`. Without this watchdog, a Ctrl-C leaves a session shown as
# `working` forever and the table becomes a lie.
STALE_AFTER=${WTS_STALE_AFTER:-10}

zmodload zsh/datetime 2>/dev/null
PASS_T0=${EPOCHREALTIME:-0}
first_root=""   # repository of the first session: the slow-pass hint checks its config

FORMAT=json
WITH_GIT=true
WIDE=false
typeset -a ONLY
ONLY=()
while (( $# )); do
  case "$1" in
    --json)   FORMAT=json ;;
    --table)  FORMAT=table ;;
    --fzf)    FORMAT=fzf ;;
    # --line: one line for a tmux status bar ("wts: 2 blocked · 1 idle"), so
    # never git — it runs every status-interval.
    --line)   FORMAT=line; WITH_GIT=false ;;
    --no-git) WITH_GIT=false ;;
    --wide)   WIDE=true ;;
    -*) print -u2 "wts-status: unknown option '$1' (--json|--table|--wide|--fzf|--line|--no-git)"; exit 2 ;;
    *)  ONLY+=("$1") ;;
  esac
  shift
done
NOW=${EPOCHSECONDS:-$(date +%s)}

if ! command -v jq >/dev/null 2>&1; then
  print -u2 "wts-status: jq is required"
  exit 1
fi

db_available || { print -u2 "wts-status: sqlite3 is required"; exit 1; }
# The registry, read once: the main pass and the prompt merge below share it.
REGISTRY=$(registry_json)
# Same rule as the empty-objects guard further down, and for the same reason:
# only --json has a representation of "nothing". This shortcut used to print
# "[]" whatever the format, and the switcher read that line as a session named
# "[]" — invisible while the registry always had a session in it, a junk row the
# moment it does not (a fresh install, or tasks queued and no session yet).
if [[ "$REGISTRY" == '{}' ]]; then
  [[ "$FORMAT" == "json" ]] && print '[]'
  exit 0
fi

# ─── Global collection (one call per tool) ───────────────────────────────────

# `claude agents --json` has a heterogeneous shape: `background` sessions carry
# .state (blocked/working/done/failed), `interactive` ones carry .status
# (busy/idle). Both are normalized below.
agents_json=$(claude agents --json 2>/dev/null)
if ! print -r -- "$agents_json" | jq -e 'type == "array"' >/dev/null 2>&1; then
  agents_json='[]'
fi

# <claude dir>/sessions/<pid>.json carries a `tmux` field = "session:@window.%pane".
# Undocumented: used to target the exact pane, never as a source of state.
# `(N)`: without Claude Code the directory is empty or missing, and a bare glob
# would print zsh's "no matches found" on stderr.
typeset -a session_files
session_files=("$CLAUDE_SESSIONS_DIR"/*.json(N))
sessions_map=""
if (( ${#session_files} )); then
  sessions_map=$(cat "${session_files[@]}" 2>/dev/null \
    | jq -s 'map(select(type == "object" and .sessionId != null))
             | map({key: .sessionId, value: {tmux: .tmux, name: .name}})
             | from_entries' 2>/dev/null)
fi
[[ -n "$sessions_map" ]] || sessions_map='{}'

tmux_alive=$(tmux list-sessions -F '#{session_name}' 2>/dev/null)

# ─── Agent events (wts-hook) ─────────────────────────────────────────────────
# What the agent reported itself: the latest row per (session, event), one
# query for every session. They give `claude agents` what it lacks — since when
# (the event that put the agent in its state) and what it waits for — and stand
# in for it when it cannot be asked. Split, not `read -d`: this runs inside the
# switcher's reload (see db_rows in wts-db.zsh).
# A `start` of kind compact is left out: a compaction (often in the middle of a
# turn) changes nothing about what the agent is doing, so the state stays what
# the events before it said. Ties in the same second go to the later row: a
# /clear writes its `end` and its `start` together, and the start is the word.
typeset -A ev_at ev_kind ev_msg ev_sid ev_last ev_last_at ev_last_id ev_last_kind
if db_available && [[ -s "$WTS_DB" ]]; then
  ev_rows=$(db_rows "SELECT e.session, e.event, e.kind, e.message, e.claude_session, e.at, e.id
                     FROM agent_events e
                     WHERE e.id = (SELECT id FROM agent_events
                                   WHERE session = e.session AND event = e.event
                                     AND NOT (event = 'start' AND kind = 'compact')
                                   ORDER BY at DESC, id DESC LIMIT 1)" 2>/dev/null)
  for ev_row in "${(@ps:\x1e:)ev_rows}"; do
    ev_f=("${(@ps:\x1f:)ev_row}")
    [[ -n "${ev_f[1]:-}" && -n "${ev_f[2]:-}" ]] || continue
    ev_at[${ev_f[1]}:${ev_f[2]}]="${ev_f[6]:-0}"
    if [[ "${ev_f[2]}" == notification ]]; then
      ev_kind[${ev_f[1]}]="${ev_f[3]:-}"
      ev_msg[${ev_f[1]}]="${ev_f[4]:-}"
    fi
    if (( ${ev_f[6]:-0} > ${ev_last_at[${ev_f[1]}]:-0} ||
          ( ${ev_f[6]:-0} == ${ev_last_at[${ev_f[1]}]:-0} && ${ev_f[7]:-0} > ${ev_last_id[${ev_f[1]}]:-0} ) )); then
      ev_last_at[${ev_f[1]}]="${ev_f[6]:-0}"
      ev_last_id[${ev_f[1]}]="${ev_f[7]:-0}"
      ev_last[${ev_f[1]}]="${ev_f[2]}"
      ev_last_kind[${ev_f[1]}]="${ev_f[3]:-}"
      [[ -n "${ev_f[5]:-}" ]] && ev_sid[${ev_f[1]}]="${ev_f[5]}"
    fi
  done
fi

# ─── Helpers ─────────────────────────────────────────────────────────────────

# The three helpers below memoize per repository. They hand their result back
# in REPLY rather than on stdout: called as `$(detect_base …)`, the memo was
# written in the command substitution's subshell and lost, so `branch --merged`
# (0.15 s warm, 0.7 s cold over 3000 refs), which the merged test used to be,
# ran once per session instead of once per pass, a third of the tick on a
# large repository.
typeset -A base_cache base_ref_cache base_tip_cache

# Base branch of a repository (same priority order as `wts`). -> REPLY
detect_base() {
  local root="$1" head_ref candidate
  if (( ${+base_cache[$root]} )); then
    REPLY="${base_cache[$root]}"
    return
  fi
  local base="${WTS_BASE_BRANCH:-}"
  if [[ -z "$base" ]]; then
    head_ref=$(git -C "$root" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null)
    if [[ -n "$head_ref" ]]; then
      base="${head_ref#origin/}"
    else
      for candidate in main master; do
        if git -C "$root" show-ref --verify --quiet "refs/heads/$candidate"; then
          base="$candidate"; break
        fi
      done
    fi
  fi
  base_cache[$root]="$base"
  REPLY="$base"
}

# What git is actually asked about: origin/<base> when it exists, otherwise the
# local base. Same rule, and same reason, as wts-gc and wts-brief: the local copy
# of the base lags behind — 333 commits and 3 days, on the repository that
# motivated this — so `diff <base>...HEAD` credited a branch with no commits of
# its own with 2782 files and 92k insertions, `rev-list --left-right` reported a
# ^333 that belonged to the remote, and `branch --merged` missed everything
# merged since the last local pull. It is also 10x faster: git walks the branch's
# delta instead of three days of history.
#
# Only the comparison changes; `base` keeps reporting the short name, because
# wts-brief reads it and derives "origin/$base" itself.
#
# show-ref on refs/remotes/origin/$base also covers WTS_BASE_BRANCH=origin/main,
# which wts-fresh exports: refs/remotes/origin/origin/main does not exist, so the
# ref is left alone instead of being prefixed twice.
base_ref_for() { # -> REPLY
  local root="$1" base="$2"
  local key="$root::$base"
  if (( ! ${+base_ref_cache[$key]} )); then
    base_ref_cache[$key]="$base"
    if [[ -n "$base" ]] \
       && git -C "$root" show-ref --verify --quiet "refs/remotes/origin/$base"; then
      base_ref_cache[$key]="origin/$base"
    fi
  fi
  REPLY="${base_ref_cache[$key]}"
}

# Tip of the base, cached per repository. -> REPLY
base_tip_of() {
  local root="$1" ref="$2"
  local key="$root::$ref"
  if (( ! ${+base_tip_cache[$key]} )); then
    base_tip_cache[$key]=$(git -C "$root" rev-parse --verify --quiet "$ref^{commit}" 2>/dev/null)
  fi
  REPLY="${base_tip_cache[$key]}"
}

# Whether the branch landed in the base, squash included: merge_verdict in
# wts-db.zsh, the test gc tears down on. It reads diffs, so its answer is kept
# in merge_checks against the two tips it was computed for and only computed
# again when one of them moves — on a tick, that is one rev-parse per session.
# `branch --merged` alone, which this was, read false for every squash merge
# and true for a session created a second ago (no commit yet: an ancestor).
typeset -A mc_tip mc_base mc_merged
if [[ -s "$WTS_DB" ]]; then
  for mc_row in "${(@ps:\x1e:)$(db_rows "SELECT session, tip, base_tip, merged FROM merge_checks" 2>/dev/null)}"; do
    mc_f=("${(@ps:\x1f:)mc_row}")
    [[ -n "${mc_f[1]:-}" ]] || continue
    mc_tip[${mc_f[1]}]="${mc_f[2]:-}" mc_base[${mc_f[1]}]="${mc_f[3]:-}" mc_merged[${mc_f[1]}]="${mc_f[4]:-}"
  done
fi
merged_verdict() { # <session> <repo_root> <branch> <base> <base_ref> -> REPLY
  local name="$1" root="$2" branch="$3" base="$4" ref="$5" tip btip
  tip=$(git -C "$root" rev-parse --verify --quiet "refs/heads/$branch" 2>/dev/null)
  base_tip_of "$root" "$ref"; btip="$REPLY"
  REPLY=""
  [[ -n "$tip" && -n "$btip" ]] || return 0
  if [[ "${mc_tip[$name]:-}" == "$tip" && "${mc_base[$name]:-}" == "$btip" ]]; then
    REPLY="${mc_merged[$name]:-}"
    return 0
  fi
  merge_check "$name" "$root" "$branch" "$base" "$ref" "$tip" "$btip"
  mc_tip[$name]="$tip" mc_base[$name]="$btip" mc_merged[$name]="$REPLY"
  return 0
}

# The pull request of each session, as wts-pr last cached it: a database read,
# never gh, so it costs the tick nothing. Rows where gh found no PR stay out:
# `pr` is null for them, as for a session never refreshed.
typeset -A pr_json
if [[ -s "$WTS_DB" ]]; then
  for pr_row in "${(@ps:\x1e:)$(db_rows "SELECT p.session, $WTS_PR_JSON FROM pr_state p
                                        WHERE p.number IS NOT NULL" 2>/dev/null)}"; do
    pr_f=("${(@ps:\x1f:)pr_row}")
    [[ -n "${pr_f[1]:-}" && -n "${pr_f[2]:-}" ]] && pr_json[${pr_f[1]}]="${pr_f[2]}"
  done
fi

# ─── Main pass ───────────────────────────────────────────────────────────────

typeset -a objects
objects=()

while IFS= read -r name && IFS= read -r profile && IFS= read -r repo_root \
      && IFS= read -r worktree && IFS= read -r branch && IFS= read -r subdir \
      && IFS= read -r context && IFS= read -r created_at; do
  [[ -n "$name" ]] || continue
  [[ -n "$first_root" ]] || first_root="$repo_root"

  # --- tmux -----------------------------------------------------------------
  local_alive=false
  if print -r -- "$tmux_alive" | grep -qxF -- "$name" 2>/dev/null; then
    local_alive=true
  fi

  # --- git ------------------------------------------------------------------
  exists=false; dirty=0; ahead=0; behind=0; added=0; removed=0; merged=false
  base=""; base_ref=""
  if [[ -d "$worktree" ]]; then
    exists=true
  fi
  if $exists && $WITH_GIT; then
    dirty=$(git -C "$worktree" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
    detect_base "$repo_root"; base="$REPLY"
    base_ref_for "$repo_root" "$base"; base_ref="$REPLY"
    if [[ -n "$base_ref" ]] && git -C "$worktree" rev-parse --verify --quiet "$base_ref" >/dev/null 2>&1; then
      counts=$(git -C "$worktree" rev-list --left-right --count "$base_ref...HEAD" 2>/dev/null)
      if [[ -n "$counts" ]]; then
        behind=${counts%%[[:space:]]*}
        ahead=${counts##*[[:space:]]}
      fi
      shortstat=$(git -C "$worktree" diff --shortstat "$base_ref...HEAD" 2>/dev/null)
      [[ "$shortstat" =~ '([0-9]+) insertion' ]] && added="${match[1]}"
      [[ "$shortstat" =~ '([0-9]+) deletion' ]] && removed="${match[1]}"
      merged_verdict "$name" "$repo_root" "$branch" "$base" "$base_ref"
      [[ -n "$REPLY" ]] && merged=true
    fi
  elif $exists; then
    # --no-git: the last verdict, whatever the tips are now. Not a count that
    # would read as a claim, and without it the first fill of the switcher
    # sorted a merged session among the live ones until the full pass.
    [[ -n "${mc_merged[$name]:-}" ]] && merged=true
  fi

  # --- Claude agent ---------------------------------------------------------
  # Join on cwd INSIDE the worktree (not equal): WTS_SUBDIR starts the panes in
  # a subdirectory of the worktree. One jq for every field of the record: with
  # one per field this loop spawned ten per session, a fifth of a second at
  # eight sessions and growing with them.
  agent_state=null; agent_waiting=null; agent_name=null
  agent_session=null; agent_pane=null; stale=false
  raw=""; sid=""

  # Both spellings of the path: the registry keeps what wts was given (a
  # WTS_WORKTREES_BASE with a trailing slash, a symlinked folder, /tmp) and the
  # agent reports the canonical one. Compared as strings only, the agent never
  # matched — `-` in the column, and gc did not know a worker was there.
  IFS=$'\x1f' read -r raw agent_waiting agent_name agent_session sid < <(
    print -r -- "$agents_json" | jq -r --arg wt "$worktree" --arg wta "${worktree:A}" '
      map(select(.cwd == $wt or (.cwd | startswith($wt + "/"))
                 or .cwd == $wta or (.cwd | startswith($wta + "/")))) | first
      | if . == null then empty else
          [ ((.state // .status // "") | ascii_downcase),
            (.waitingFor // null | tojson),
            (.name // null | tojson),
            (.sessionId // null | tojson),
            (.sessionId // "") ]
          | join("\u001f") end' 2>/dev/null)
  agent_waiting=${agent_waiting:-null}; agent_name=${agent_name:-null}
  agent_session=${agent_session:-null}

  # --- events: the state when claude could not be asked ---------------------
  # Not a second opinion: when `claude agents` answers, its word is the state
  # and the events only date it. Without it (no claude on PATH, an agent it
  # does not list) the last event decides — prompt: working, stop: idle, a
  # notification that needs a human: blocked — unless it is older than twelve
  # hours, which is an agent that died without saying so.
  # An `end` is the agent saying so: stopped, whatever its age. It used to
  # leave no state at all, and `wts wait` reads no state as "not started yet":
  # waiting for an agent that had quit timed out every time, for good. A
  # `start` after it (SessionStart: a /clear, or claude run again in the pane)
  # is an agent waiting for its first prompt: idle. Until it was recorded, the
  # `end` stayed the last word and that agent read stopped, `wts send` refusing
  # it without --force. An `end` of kind clear with no start after it still
  # reads idle: a wts upgraded by brew runs this collector before `wts setup
  # claude --install` adds the start hook, and /clear must not read stopped there.
  agent_source=null; agent_since=null
  p_at=${ev_at[${name}:prompt]:-0}; s_at=${ev_at[${name}:stop]:-0}
  n_at=${ev_at[${name}:notification]:-0}; n_kind="${ev_kind[$name]:-}"
  e_at=${ev_at[${name}:end]:-0}; st_at=${ev_at[${name}:start]:-0}
  ev_state=""
  if [[ -n "$raw" || "$agent_session" != "null" ]]; then
    agent_source='"agents"'
  elif [[ "${ev_last[$name]:-}" == end && "${ev_last_kind[$name]:-}" != clear ]]; then
    ev_state=stopped
  elif [[ -n "${ev_last[$name]:-}" ]] && (( NOW - ${ev_last_at[$name]:-0} < 43200 )); then
    case "${ev_last[$name]}" in
      prompt) ev_state=working ;;
      stop)   ev_state=idle ;;
      start)  ev_state=idle ;;
      end)    ev_state=idle ;;
      notification)
        if needs_human "$n_kind"; then ev_state=blocked
        elif [[ "$n_kind" == idle_prompt ]]; then ev_state=idle
        elif (( p_at > s_at )); then ev_state=working
        else ev_state=idle
        fi ;;
    esac
  fi
  if [[ -n "$ev_state" ]]; then
    raw="$ev_state"
    sid="${ev_sid[$name]:-}"
    [[ -n "$sid" ]] && agent_session=$(jq -nc --arg s "$sid" '$s')
    agent_source='"events"'
  fi

  if [[ -n "$raw" || "$agent_session" != "null" ]]; then

    # `state` (background) and `status` (interactive) mapped to one vocabulary.
    # Interactive sessions report `status: waiting` while a question or a permission
    # prompt waits for an answer: it needs a human, exactly like `state: blocked`.
    case "$raw" in
      blocked|waiting) agent_state='"blocked"' ;;
      busy|working)   agent_state='"working"' ;;
      idle)           agent_state='"idle"' ;;
      done)           agent_state='"done"' ;;
      failed)         agent_state='"failed"' ;;
      stopped)        agent_state='"stopped"' ;;
      "")             agent_state=null ;;
      # Outside the closed list `status --json` promises (CLAUDE.md): an agent
      # reading the contract would meet a state it cannot know. null, and the
      # value kept once in kv for `wts doctor` to name.
      *)              agent_state=null
                      db_q "INSERT OR IGNORE INTO kv VALUES
                            ($(sql_str "agent_state.unknown:$raw"), $(sql_str "$sid"))" \
                        >/dev/null 2>&1 ;;
    esac

    if [[ -n "$sid" ]]; then
      pane_ref=$(print -r -- "$sessions_map" | jq -r --arg s "$sid" '.[$s].tmux // empty')
      if [[ -n "$pane_ref" ]]; then
        agent_pane=$(jq -nc --arg p "$pane_ref" '$p')
        pane_id="%${pane_ref##*.%}"

        # Staleness watchdog: pane hash compared with the previous tick.
        if [[ "$agent_state" == '"working"' ]]; then
          # Only a capture that succeeded: a dead pane hashed as the empty text,
          # the same every tick, read `stuck?` for good and gc held its worktree.
          cur=""
          if pane_text=$(tmux capture-pane -p -t "$pane_id" 2>/dev/null); then
            cur=$(print -r -- "$pane_text" | hash_stdin)
          fi
          now=$(date +%s)
          # Split, not `read -d`: this runs inside the switcher's reload, where
          # `read -d` stops the process (see db_rows in wts-db.zsh).
          prev=$(db_rows "SELECT hash, since FROM pane_hashes
                          WHERE agent_session = $(sql_str "$sid")" 2>/dev/null)
          prev_f=("${(@ps:\x1f:)${prev%$'\x1e'}}")
          prev_hash="${prev_f[1]:-}" prev_ts="${prev_f[2]:-}"
          if [[ -n "$cur" && -n "$prev_hash" && "$cur" == "$prev_hash" ]]; then
            (( now - ${prev_ts:-$now} >= STALE_AFTER )) && stale=true
          elif [[ -n "$cur" ]]; then
            db_q "INSERT OR REPLACE INTO pane_hashes VALUES
                  ($(sql_str "$sid"), $(sql_str "$cur"), $now)" >/dev/null 2>&1
          fi
        fi
      fi
    fi
  fi

  # --- since when, and waiting for what ------------------------------------
  # `since` is the event that put the agent in its state: the prompt for
  # working, the notification for blocked (or the prompt, when the notification
  # predates it — an old permission already answered), the stop for idle. The
  # waiting-for text comes from the notification when claude gave none.
  case "$agent_state" in
    '"working"') (( p_at )) && agent_since=$p_at ;;
    '"blocked"')
      if (( n_at >= p_at )) && needs_human "$n_kind"; then agent_since=$n_at
      elif (( p_at )); then agent_since=$p_at
      fi ;;
    '"idle"')
      if [[ "${ev_last[$name]:-}" == start ]] && (( st_at )); then agent_since=$st_at
      elif [[ "${ev_last[$name]:-}" == end ]] && (( e_at )); then agent_since=$e_at
      elif [[ "$n_kind" == idle_prompt ]] && (( n_at > s_at )); then agent_since=$n_at
      elif (( s_at )); then agent_since=$s_at
      fi ;;
    # Only when the `end` is what said so: `claude agents` can report stopped
    # for an agent whose last recorded exit is a previous conversation's.
    '"stopped"') [[ "$ev_state" == stopped ]] && (( e_at )) && agent_since=$e_at ;;
  esac
  if [[ "$agent_state" == '"blocked"' && "$agent_waiting" == null && -n "${ev_msg[$name]:-}" ]] \
     && (( n_at >= p_at )); then
    agent_waiting=$(jq -nc --arg m "${ev_msg[$name]}" '$m')
  fi

  objects+=("$(jq -nc \
    --argjson agent_since "$agent_since" --argjson agent_source "$agent_source" \
    --arg name "$name" --arg profile "$profile" --arg repo_root "$repo_root" \
    --arg worktree "$worktree" --arg branch "$branch" --arg subdir "$subdir" \
    --arg context "$context" --arg created_at "$created_at" --arg base "$base" \
    --argjson tmux_alive "$local_alive" --argjson exists "$exists" \
    --argjson dirty "${dirty:-0}" --argjson ahead "${ahead:-0}" \
    --argjson behind "${behind:-0}" --argjson added "${added:-0}" \
    --argjson removed "${removed:-0}" --argjson merged "$merged" \
    --argjson agent_state "$agent_state" --argjson agent_waiting_for "$agent_waiting" \
    --argjson agent_name "$agent_name" --argjson agent_session "$agent_session" \
    --argjson agent_pane "$agent_pane" --argjson stale "$stale" \
    --argjson pr "${pr_json[$name]:-null}" \
    '{name:$name, profile:$profile, branch:$branch, base:$base,
      repo_root:$repo_root, worktree:$worktree, subdir:$subdir,
      context:$context, created_at:$created_at,
      exists:$exists, tmux_alive:$tmux_alive,
      dirty:$dirty, ahead:$ahead, behind:$behind,
      added:$added, removed:$removed, merged:$merged,
      agent_state:$agent_state, agent_waiting_for:$agent_waiting_for,
      agent_name:$agent_name, agent_session:$agent_session,
      agent_pane:$agent_pane, stale:$stale,
      agent_since:$agent_since, agent_source:$agent_source, pr:$pr}')")

done < <(jq -r '$ARGS.positional as $only
  | to_entries | sort_by(.key)[]
  | select(($only | length) == 0 or (.key | IN($only[])))
  | [.key, (.value.profile // "-"), (.value.repo_root // ""),
     (.value.worktree // ""), (.value.branch // "-"), (.value.subdir // ""),
     (.value.context // ""), (.value.created_at // "")] | .[]' <<< "$REGISTRY" --args "${ONLY[@]}")

# Empty registry: only --json has a representation ("[]"); the presentation
# formats must emit nothing, otherwise they pollute the caller's list.
if (( ${#objects} == 0 )); then
  [[ "$FORMAT" == "json" ]] && print '[]'
  exit 0
fi

# Sort: whatever needs a human first, and among equals the one waiting longest.
# A merged session last, whatever its agent says: the work landed, and what is
# left is a ctrl-d.
SORT_KEY='def rank:
  if .merged or .pr.state == "merged" then 6
  elif .stale then 0
  elif .agent_state == "blocked" then 1
  elif .agent_state == "failed" then 2
  elif .agent_state == "idle" then 3
  elif .agent_state == "working" then 4
  else 5 end;
sort_by(rank, (.agent_since // 9e15), .name)'

all=$(printf '%s\n' "${objects[@]}" | jq -s "$SORT_KEY")

# Starting phrase (`wts "<phrase>"`): merged here from the registry, not in the
# main pass, whose "one field per line" stream would be shifted by a multiline
# phrase.
# The task this session serves rides along for the same reason: one more field
# off the registry, and the collection loop above stays untouched.
# `usage: null` here, filled in below when it is computed: without it --no-git
# left the key out, where the contract says null — `.usage == null` is true of
# a missing key too, which is how a check on it passed.
# The status line's gauges ride along too (agent_gauges, written by `wts-hook
# statusline` when the user opted into it): one read, and null everywhere
# without it. Not for --line, which counts states only.
gauges_map='{}'
if [[ "$FORMAT" != line ]]; then
  gauges_map=$(db_ro "$(gauges_json_sql)" 2>/dev/null)
  [[ "$gauges_map" == '{'* ]] || gauges_map='{}'
fi
if merged=$(print -r -- "$all" | jq --slurpfile reg <(print -r -- "$REGISTRY") \
      --argjson g "$gauges_map" \
      'map(. + {prompt: ($reg[0][.name].prompt // ""),
                task: ($reg[0][.name].task // ""),
                task_title: ($reg[0][.name].task_title // ""),
                usage: null,
                context_pct: ($g[.name].context_pct // null),
                rate_limits: ($g[.name].rate_limits // null),
                cost_reported_usd: ($g[.name].cost_reported_usd // null)})' 2>/dev/null); then
  all="$merged"
fi

# Tokens and cost, from the usage table only: the transcripts are summed by wts
# brief and at teardown, never here — a 20 MB transcript is half a second of jq,
# and this pass runs on every switcher tick. Not for --fzf or --line either: the
# switcher shows none of it, and one query less is one query less every 2 s.
# Nor with --no-git, which prefix+a and wts wait poll for agent states alone:
# usage is then null, like the git columns are zero.
if { [[ "$FORMAT" == json ]] && $WITH_GIT; } || { [[ "$FORMAT" == table ]] && $WIDE; }; then
  usage_map=$(db_ro "SELECT json_group_object(name, json($(usage_json_sql s.name s.created_at)))
                     FROM sessions s" 2>/dev/null)
  [[ -n "$usage_map" ]] || usage_map='{}'
  if merged=$(print -r -- "$all" | jq --argjson u "$usage_map" \
        'map(. + {usage: ($u[.name] // null)})' 2>/dev/null); then
    all="$merged"
  fi
fi

# SUBJECT: the name Claude gave the conversation, otherwise the starting phrase
# (restored session, agent not relaunched yet), otherwise the context. `//` is
# not enough: jq lets an empty string through.
#
# A leading "@ " marks a session that serves a task ("at" a task). Not "*",
# which it was: the switcher puts a `*` after the current session's NAME, as
# tmux does for its current window, and one sign meaning two things in two
# columns of the same row read as one meaning. Only a sign, not the task
# title: at 50 shared characters the title would evict the conversation name,
# which is the more useful of the two day to day — the grouped view is
# `wts task ls`. ASCII, because macOS `column -t` counts bytes, and truncated
# AFTER the sign is prepended, or a linked row would be two columns wider than
# the others and both the switcher layout and the header-width test would break.
# The task title is the last resort, not a competitor: it only shows when the
# agent, the phrase and the context are all empty, where the alternative is a
# cell holding nothing but the sign, which reads as a rendering fault.
SUBJECT='def subject: (if (.task_title // "") != "" then "@ " else "" end)
  + ([.agent_name, .prompt, .context, .task_title]
     | map(select(type == "string" and . != "")) | (.[0] // ""))
  | gsub("[\\t\\n\\r]"; " ")
  | if length > 50 then .[0:49] + "…" else . end;'

# --wide: TOKENS is every token the API counted (input, output, cache writes
# and reads: the reads dominate an agent's), COST their API list price ("~"
# when a model has no price in wts-db.zsh, so the sum is short), MODEL the one
# that cost the most, without "claude-" and the date. "-": never summed yet.
USAGE_CELLS='def human: if . >= 1e9 then "\(. / 1e8 | floor / 10)G"
                     elif . >= 1e6 then "\(. / 1e5 | floor / 10)M"
                     elif . >= 1e3 then "\(. / 1e3 | floor)k" else tostring end;
def usage_cells: if .usage == null then ["-", "-", "-"] else
  [ (.usage.tokens | human),
    ((if .usage.cost_complete then "$" else "~$" end)
     + (.usage.cost_usd * 100 | round / 100 | tostring
        | if test("\\.[0-9]$") then . + "0" elif test("\\.") then . else . + ".00" end)),
    (.usage.model // "-" | sub("^claude-"; "") | sub("-[0-9]{8}$"; "")) ] end;'

# --no-git: the git columns read "-" (unknown), never "+0/-0 clean" (a claim).
case "$FORMAT" in
  json)  print -r -- "$all" ;;
  # fzf: a dead tmux session reads "stopped" whatever the agent record says. The
  # row is about the session, and `claude agents` can still list a record whose
  # cwd is that worktree, which would show a ghost "working". --json keeps the
  # raw facts.
  # Fields 7 and 8, since (epoch) and waiting-for, feed the preview's header.
  # Field 9 is the PR column (db_pr_labels in wts-db.zsh, which the switcher's
  # skeleton reads too), field 10 the repository root (the switcher's REPO
  # column, named there without a fork), field 11 the context window in use,
  # rounded, empty without a status line reading, and the subject stays last.
  fzf)   typeset -a label_pairs=()
         for pr_row in "${(@ps:\x1e:)$(db_pr_labels)}"; do
           pr_f=("${(@ps:\x1f:)pr_row}")
           [[ -n "${pr_f[1]:-}" && -n "${pr_f[2]:-}" ]] && label_pairs+=("${pr_f[1]}" "${pr_f[2]}")
         done
         labels_json=$(jq -nc 'reduce range(0; $ARGS.positional | length; 2) as $i
                                 ({}; . + {($ARGS.positional[$i]): $ARGS.positional[$i + 1]})' \
                         --args "${label_pairs[@]}")
         print -r -- "$all" | jq -r --argjson git "$WITH_GIT" --argjson labels "${labels_json:-"{}"}" "$SUBJECT"'.[]
           | [ .name,
               (if (.tmux_alive | not) then "stopped"
                elif .stale then "stuck?" else (.agent_state // "-") end),
               .branch,
               (if $git then "+\(.added)/-\(.removed)" + (if .ahead > 0 then " ^\(.ahead)" else "" end) else "-" end),
               (if ($git | not) then "-" elif .dirty > 0 then "dirty" else "clean" end),
               (.agent_pane // ""),
               (.agent_since // "" | tostring),
               (.agent_waiting_for | if type == "string" then . elif . == null then "" else tojson end
                | gsub("[\\t\\n\\r\u001f\u001e]"; " ")),
               ($labels[.name] // ""),
               (.repo_root // ""),
               (.context_pct | if type == "number" then round | tostring else "" end),
               subject ]
           | join("")' ;;
  # One line for a status bar, empty when nobody needs you: dead tmux sessions
  # and working agents are not news.
  line)  print -r -- "$all" | jq -r '
           [ .[] | select(.tmux_alive) ] as $live
           | [ (($live | map(select(.stale)) | length) as $n
                | if $n > 0 then "\($n) stuck" else empty end),
               (($live | map(select((.stale | not) and .agent_state == "blocked")) | length) as $n
                | if $n > 0 then "\($n) blocked" else empty end),
               (($live | map(select(.agent_state == "failed")) | length) as $n
                | if $n > 0 then "\($n) failed" else empty end),
               (($live | map(select((.stale | not) and .agent_state == "idle")) | length) as $n
                | if $n > 0 then "\($n) idle" else empty end) ]
           | if length == 0 then "" else "wts: " + join(" · ") end' ;;
  # REPO only when the sessions span several repositories: with one, it would
  # repeat the same word on every row. Named after git's common directory, not
  # repo_root, which is a worktree for a session created from inside one.
  table) typeset -a repo_pairs=()
         r="" c=""
         for r in "${(@f)$(print -r -- "$all" | jq -r '.[].repo_root // empty' | sort -u)}"; do
           [[ -n "$r" ]] || continue
           c=$(git -C "$r" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || c=""
           if [[ "$c" == */.git ]]; then c="${c:h}"; fi
           [[ -n "$c" ]] || c="$r"
           repo_pairs+=("$r" "${${c:t}%.git}")
         done
         repos_json=$(jq -nc 'reduce range(0; $ARGS.positional | length; 2) as $i
                                ({}; . + {($ARGS.positional[$i]): $ARGS.positional[$i + 1]})' \
                        --args "${repo_pairs[@]}")
         # AGENT carries since when ("blocked 4m", the switcher's own format), and
         # --wide the question a blocked agent waits on: README has `wts ls` tell
         # "for how long, and on what question", and the table had neither —
         # both were in --json and in the switcher preview only.
         print -r -- "$all" | jq -r --argjson git "$WITH_GIT" --argjson wide "$WIDE" \
             --argjson now "$NOW" \
             --argjson repos "${repos_json:-"{}"}" "$SUBJECT$USAGE_CELLS"'
           def age: if . == null then "" else ([$now - ., 0] | max) as $s
             | if $s < 60 then " \($s)s"
               elif $s < 3600 then " \($s / 60 | floor)m"
               elif $s < 86400 then " \($s / 3600 | floor)h\(($s % 3600) / 60 | floor)m"
               else " \($s / 86400 | floor)d" end end;
           def ctx: .context_pct | if type == "number" then "\(round)%" else "-" end;
           def waiting: (.agent_waiting_for // "")
             | (if type == "string" then . else tojson end)
             | gsub("[\\t\\n\\r]"; " ")
             | if length > 40 then .[0:39] + "…" elif . == "" then "-" else . end;
           ([$repos[]] | unique | length > 1) as $multi
           | (["SESSION"] + (if $multi then ["REPO"] else [] end)
              + ["AGENT","BRANCH","DELTA","DIRTY","TMUX"]
              + (if $wide then ["TOKENS","COST","MODEL","CTX","WAITING"] else [] end)
              + ["SUBJECT"] | @tsv),
           (.[] | [ .name ]
                + (if $multi then [$repos[.repo_root // ""] // "-"] else [] end)
                + [
                    ((if .stale then "stuck?" else (.agent_state // "-") end)
                     + (if .agent_state == null then "" else (.agent_since | age) end)),
                    .branch,
                    (if $git then "+\(.added)/-\(.removed)" + (if .ahead > 0 then " ^\(.ahead)" else "" end) else "-" end),
                    (if ($git | not) then "-" elif .dirty > 0 then "yes" else "no" end),
                    (if .tmux_alive then "running" else "stopped" end) ]
                + (if $wide then usage_cells + [ctx, waiting] else [] end)
                + [ (subject | if . == "" then "-" else . end) ] | @tsv)' \
         | column -t -s $'\t' ;;
esac

# A slow pass is almost always `git status` walking large worktrees without
# fsmonitor: 0.5 s against 0.04 s per 150k-file worktree, measured in
# docs/big-repo-analysis.md. Say so on stderr, only to a human, and only while
# the repository has not enabled it.
if [[ "$FORMAT" == table && -t 2 && -n "$first_root" ]] && $WITH_GIT; then
  pass_s=$(( EPOCHREALTIME - PASS_T0 ))
  if (( pass_s > 3 )) \
     && [[ "$(git -C "$first_root" config --get core.fsmonitor 2>/dev/null)" != true ]]; then
    print -u2 -r -- "→ ${pass_s%%.*} s collecting: \`wts setup git\` shows two git settings that make this ~10x faster"
  fi
fi
