#!/usr/bin/env zsh
# wts-hook — Claude Code hooks: what the agent reports about itself, recorded
#
# Installed by `wts setup claude --install` on six events, one verb each:
#   SessionStart     -> wts-hook start          a conversation starts (next to
#                                               wts-context): startup, resume,
#                                               clear or compact, in `kind`
#   UserPromptSubmit -> wts-hook prompt         a turn starts
#   Stop             -> wts-hook stop           the turn is over
#   Notification     -> wts-hook notification   waiting for a permission or an answer
#   SessionEnd       -> wts-hook end            the agent is gone
#   PostToolUse      -> wts-hook touch          a file was edited (Edit, Write,
#                                               MultiEdit, NotebookEdit)
#
# Each one inserts a row into `agent_events`, keyed by the wts session found
# from the pane ($TMUX_PANE) or the working directory. That is what makes the
# state exact and timestamped: wts-status polls `claude agents --json` for the
# state and reads these rows for since-when and waiting-for — and for the state
# itself when claude cannot be asked. Until this existed the only clock wts had
# was a pane hash for `working` agents, and "blocked" had no age. `start` is
# what tells an agent started again in the same pane (or a /clear) from one that
# quit: without it the `end` of the previous conversation was the last word, and
# the agent read stopped until its first prompt.
#
# Outside a wts session it exits 0 without a word: the hook is user-wide.
#
# It prints on stdout in two places only, both on purpose, both through fd 3
# (stdout itself goes to /dev/null right after the payload is read):
#   prompt  the news (deliver_news below): the notes the same repository's
#           other agents left that this one has not been told, the files it
#           edited that one of them has edited too, the sessions that finished
#           and the notes they left; five lines per kind at most, nothing when
#           there is nothing new. Claude Code adds a UserPromptSubmit hook's
#           stdout to the conversation, which is exactly the point: a note
#           written an hour after SessionStart otherwise reached nobody who did
#           not poll.
#   touch   the same news, at every edit, as PostToolUse's additionalContext
#           JSON (one object): a working agent hears of them mid-turn, and the
#           second editor of a file at the edit itself. Silence otherwise.
# Nothing else may ever reach stdout, and every path exits 0: a non-zero exit
# from a Stop hook is read as "block the turn and hand stderr to the model".
# WTS_CONTEXT_QUIET=1 silences both, like the SessionStart hook.
#
# Every event also records $TMUX_PANE in agent_panes: the hook runs in the
# agent's own environment, so this is the one exact answer to "which pane is
# the agent", which `wts send` and the switcher's reply type into. With it, the
# payload's transcript_path: the transcript the brief, the retrospective, `wts
# tail` and `wts pr` read, named by Claude Code rather than derived from the
# worktree's path (db_session_transcript).
#
# Attention: a `notification` (permission, question) and a `stop` also ring the
# pane's bell — tmux flags the window — and post a desktop banner, unless the
# pane is already under the user's eyes (terminal in front, session attached,
# window active). WTS_NOTIFY=0 turns both off, `bell` or `banner` keeps one.
# The banner names the wts session, which is what a generic notifier cannot do.
#
# One more verb, and not a hook: `statusline` is Claude Code's statusLine
# command, installed apart by `wts setup claude --statusline` (opt-in, never by
# --install: a user has one status line, and it may be someone else's). It
# records the gauges its payload carries (agent_gauges: context window in use,
# rate limits, Claude Code's own cost of the conversation) and prints the
# agent's status line, which is its whole job — the one verb that writes to
# stdout. See statusline() below.
#
# Usage: wts-hook start|prompt|stop|notification|end|touch|statusline
#        (payload as JSON on stdin)

set -uo pipefail
zmodload zsh/datetime 2>/dev/null

source "${0:A:h}/wts-db.zsh"

EVENT="${1:-}"
case "$EVENT" in
  start|prompt|stop|notification|end|touch|statusline) ;;
  *) exit 0 ;;
esac

# The payload, read only when stdin is redirected: a manual run must not hang.
payload=""
[[ -t 0 ]] || payload=$(cat 2>/dev/null)

# ─── statusline: the gauges, and the agent's status line ─────────────────────
# Claude Code runs it at every refresh of its status line (each new message,
# debounced to a few hundred ms), so it is held to one sqlite3 process and no
# other: the payload is parsed by SQLite's own JSON functions rather than jq,
# the session is found from the directories in SQL rather than asked of tmux,
# and the write and the read share the connection. ~10 ms where the hook path
# (jq, tmux, db_init) would cost five processes.
#
# In a wts session:  wts <session> · <model> · ctx N% · k session(s) need you
#                    · m unseen note(s)    (a count of zero is left out)
# Elsewhere:         <model> · ctx N%      (and nothing is written)
#
# "Need you" is a session whose last hook event is a notification that needs a
# human (WTS_NEEDS_HUMAN), less than twelve hours old: the collector's reading
# without `claude agents`, which is too slow to ask here. An unseen note is one
# the same repository's sessions left that this agent's hooks have not handed
# it yet (the notes stream of `seen`): its next prompt will.
#
# Always exits 0 and prints at most one line: whatever fails, the user keeps a
# status line, if only the model's name.
statusline() {
  db_available || return 0
  local now=${EPOCHSECONDS:-$(date +%s)}
  local j="$payload"
  [[ -n "$j" ]] || j='{}'
  local P="CASE WHEN json_valid($(sql_str "$j")) THEN $(sql_str "$j") ELSE '{}' END"
  local model="coalesce(json_extract(j, '\$.model.display_name'), json_extract(j, '\$.model.id'), '')"
  local ctx="coalesce(CAST(round(json_extract(j, '\$.context_window.used_percentage')) AS INTEGER), '')"
  # The directories to match a worktree against: the payload's, then the
  # process's own, each with and without macOS's /private (a worktree under
  # /tmp is registered as one and reported as the other). Then the name Claude
  # Code was given (--name, which the layouts set to the session's).
  local sql="CREATE TEMP TABLE p AS SELECT $P AS j;
CREATE TEMP TABLE d AS
  WITH raw(dir) AS (
    SELECT json_extract(j, '\$.workspace.current_dir') FROM p
    UNION ALL SELECT json_extract(j, '\$.cwd') FROM p
    UNION ALL SELECT json_extract(j, '\$.workspace.project_dir') FROM p
    UNION ALL VALUES ($(sql_str "$PWD")), ($(sql_str "${PWD:A}")))
  SELECT dir FROM raw WHERE dir LIKE '/%'
  UNION SELECT substr(dir, 9) FROM raw WHERE dir LIKE '/private/%'
  UNION SELECT '/private' || dir FROM raw WHERE dir LIKE '/%';
CREATE TEMP TABLE me AS SELECT coalesce(
    (SELECT s.name FROM sessions s, d
      WHERE s.worktree != ''
        AND substr(d.dir || '/', 1, length(s.worktree) + 1) = s.worktree || '/'
      ORDER BY length(s.worktree) DESC LIMIT 1),
    (SELECT name FROM sessions WHERE name = (SELECT json_extract(j, '\$.session_name') FROM p))
  ) AS name, (SELECT j FROM p) AS j;
INSERT INTO agent_gauges (session, claude_session, model, cost_usd, context_pct, rate_5h, rate_7d, at)
  SELECT name, coalesce(json_extract(j, '\$.session_id'), ''), coalesce(json_extract(j, '\$.model.id'), ''),
         json_extract(j, '\$.cost.total_cost_usd'),
         json_extract(j, '\$.context_window.used_percentage'),
         json_extract(j, '\$.rate_limits.five_hour.used_percentage'),
         json_extract(j, '\$.rate_limits.seven_day.used_percentage'), $now
  FROM me WHERE name IS NOT NULL AND json_extract(j, '\$.session_id') IS NOT NULL
  ON CONFLICT(session, claude_session) DO UPDATE SET
    model = excluded.model, cost_usd = excluded.cost_usd, context_pct = excluded.context_pct,
    rate_5h = excluded.rate_5h, rate_7d = excluded.rate_7d, at = excluded.at;
SELECT coalesce(me.name, ''), $model, $ctx,
  (SELECT count(*) FROM sessions s
    WHERE s.name != coalesce(me.name, '')
      AND EXISTS (SELECT 1 FROM agent_events e
                  WHERE e.id = (SELECT x.id FROM agent_events x WHERE x.session = s.name
                                ORDER BY x.at DESC, x.id DESC LIMIT 1)
                    AND e.event = 'notification' AND e.kind IN $(sql_list "${WTS_NEEDS_HUMAN[@]}")
                    AND e.at > $now - 43200)),
  (SELECT count(*) FROM sessions r, notes n JOIN sessions a ON a.name = n.session
    WHERE r.name = me.name AND n.session != r.name AND a.repo_root = r.repo_root
      AND CAST(strftime('%s', n.updated_at) AS INTEGER) >= CAST(strftime('%s', r.created_at) AS INTEGER)
      AND NOT EXISTS (SELECT 1 FROM seen m
                      WHERE m.session = r.name AND m.stream = 'notes'
                        AND m.ref = n.session || char(31) || n.key AND m.mark = n.value
                        AND m.at >= CAST(strftime('%s', r.created_at) AS INTEGER)
                        AND m.at >= CAST(strftime('%s', a.created_at) AS INTEGER)))
FROM me;"
  local out=""
  if [[ -s "$WTS_DB" ]]; then
    # Fails on a database an older wts left without agent_gauges or seen: then
    # db_init, once, and again. Not before: its fast path is a process of its own.
    if ! out=$(_db -ascii "$WTS_DB" "$sql" 2>/dev/null); then
      out=""
      db_init >/dev/null 2>&1 && out=$(_db -ascii "$WTS_DB" "$sql" 2>/dev/null)
    fi
  fi
  # No database, or one that cannot be read: the payload alone.
  [[ -n "$out" ]] || out=$(_db -ascii :memory: "SELECT '', $model, $ctx, 0, 0 FROM (SELECT $P AS j)" 2>/dev/null)
  local -a f
  f=("${(@ps::)${out%$''}}")
  local me="${f[1]:-}" m="${f[2]:-}" c="${f[3]:-}" k="${f[4]:-0}" n="${f[5]:-0}"
  local -a parts
  parts=()
  [[ -n "$me" ]] && parts+=("wts $me")
  [[ -n "$m" ]] && parts+=("$m")
  [[ "$c" == <-> ]] && parts+=("ctx $c%")
  if [[ -n "$me" ]]; then
    [[ "$k" == <-> ]] && (( k )) && parts+=("$k session(s) need you")
    [[ "$n" == <-> ]] && (( n )) && parts+=("$n unseen note(s)")
  fi
  print -r -- "${(pj: · :)parts//[[:cntrl:]]/ }"
  return 0
}
if [[ "$EVENT" == statusline ]]; then
  statusline
  exit 0
fi

# From here on nothing may reach stdout (see the header); fd 3 is the channel
# to the conversation, for the two messages that are its purpose.
exec 3>&1 >/dev/null

db_available || exit 0
[[ -s "$WTS_DB" ]] || exit 0

# transcript_path is in every payload; agent_id only in a subagent's tool call.
sid="" kind="" msg="" cwd="" file="" transcript="" agent_id=""
if [[ -n "$payload" ]] && command -v jq >/dev/null 2>&1; then
  IFS=$'\x1f' read -r sid kind msg cwd file transcript agent_id < <(print -r -- "$payload" | jq -r '
    [ (.session_id // ""),
      (.notification_type // .reason // .source // ""),
      ((.message // "") | gsub("[\\t\\n\\r\u001f\u001e]"; " ")),
      (.cwd // ""),
      ((.tool_input.file_path // .tool_input.notebook_path // "") | gsub("[\\t\\n\\r\u001f\u001e]"; " ")),
      ((.transcript_path // "") | gsub("[\\t\\n\\r\u001f\u001e]"; " ")),
      ((.agent_id // "") | tostring | gsub("[\\t\\n\\r\u001f\u001e]"; " "))
    ] | join("\u001f")' 2>/dev/null)
fi
# Only an absolute path to a transcript: it is read back as a file by name.
[[ "$transcript" == /*.jsonl ]] || transcript=""
# Claude Code runs a hook from the project directory, which is the worktree
# (or its WTS_SUBDIR); the payload's cwd is the same thing, and wins when the
# hook is run from elsewhere.
if [[ -n "$cwd" && -d "$cwd" ]]; then
  cd -- "$cwd" 2>/dev/null || true
fi
me=$(db_current_session) || exit 0
[[ -n "$me" ]] || exit 0

now=${EPOCHSECONDS:-$(date +%s)}
quiet=false
[[ -n "${WTS_CONTEXT_QUIET:-}" ]] && quiet=true

# db_init first: this hook may be the first wts code to open a database an
# older wts left at an earlier schema, without the seen table (9) or the
# transcript column (10). Its fast path is one PRAGMA. When it fails, the pane
# is still recorded the old way and the turn goes on without news.
db_ready=false
db_init >/dev/null 2>&1 && db_ready=true

# The agent's pane, from its own environment, and its transcript (see the
# header). An event without a transcript keeps the one already recorded.
if [[ -n "${TMUX_PANE:-}" ]]; then
  if $db_ready; then
    db_q "INSERT INTO agent_panes (session, claude_session, pane, at, transcript)
          VALUES ($(sql_str "$me"), $(sql_str "$sid"), $(sql_str "$TMUX_PANE"), $now,
                  $(sql_str "$transcript"))
          ON CONFLICT(session) DO UPDATE SET
            claude_session = CASE WHEN excluded.claude_session = '' THEN agent_panes.claude_session
                                  ELSE excluded.claude_session END,
            transcript = CASE WHEN excluded.transcript = '' THEN agent_panes.transcript
                              ELSE excluded.transcript END,
            pane = excluded.pane, at = excluded.at" >/dev/null 2>&1
  else
    db_q "INSERT INTO agent_panes (session, claude_session, pane, at)
          VALUES ($(sql_str "$me"), $(sql_str "$sid"), $(sql_str "$TMUX_PANE"), $now)
          ON CONFLICT(session) DO UPDATE SET
            claude_session = CASE WHEN excluded.claude_session = '' THEN agent_panes.claude_session
                                  ELSE excluded.claude_session END,
            pane = excluded.pane, at = excluded.at" >/dev/null 2>&1
  fi
fi

cut120() {
  local v="${1//[[:cntrl:]]/ }"
  (( ${#v} > 120 )) && v="${v[1,119]}…"
  print -r -- "$v"
}

# ─── News: what the other sessions did since this agent last heard ──────────
# Three streams, marked in `seen` as they are delivered (schema 9): the notes of
# the same repository's sessions, the files this agent edited that one of them
# has edited too, and the sessions of the repository that finished. A note used
# to count as new when its updated_at was later than the reader's previous
# prompt, to the second: one rewritten in the second it was read was lost, a
# working agent heard of it only at its next turn, the first editor of a file
# was never told a sibling edited it too, and a note died with its author.
#
# Prints the lines, nothing when there is nothing new. Called on every prompt
# and every edit, so the common case costs one read-only query; only when it
# finds something are the siblings computed (git calls) and the marks written.
deliver_news() {
  local R c row i k
  R=$(sql_str "$me")
  # The reader's own birth: a mark written before it belongs to an earlier
  # session of the same name, a note older than it was shown by SessionStart,
  # and a session that finished by then (in the same second included: the rm
  # that made room for this one) is not news.
  c="(SELECT CAST(strftime('%s', created_at) AS INTEGER) FROM sessions WHERE name = $R)"
  # Nine columns: stream, mark, then the stream's own. The ref is not one of
  # them: notes and overlap refs hold char(31), the field separator, and are
  # rebuilt below from their two halves.
  local out
  out=$(db_rows "
    WITH amark AS (SELECT coalesce(
           (SELECT CAST(mark AS INTEGER) FROM seen
            WHERE session = $R AND stream = 'archive' AND ref = '' AND at >= $c),
           (SELECT max(id) FROM archive
            WHERE CAST(strftime('%s', finished_at) AS INTEGER) <= $c),
           0) AS id)
    SELECT 'notes', n.value, n.session, n.key, n.value, '', '', '',
           -CAST(strftime('%s', n.updated_at) AS INTEGER)
    FROM notes n JOIN sessions a ON a.name = n.session
    WHERE n.session != $R
      AND CAST(strftime('%s', n.updated_at) AS INTEGER) >= $c
      AND NOT EXISTS (SELECT 1 FROM seen m
                      WHERE m.session = $R AND m.stream = 'notes'
                        AND m.ref = n.session || char(31) || n.key AND m.mark = n.value
                        AND m.at >= $c AND m.at >= CAST(strftime('%s', a.created_at) AS INTEGER))
    UNION ALL
    SELECT 'overlap', '1', o.session, o.path, s.branch, $now - o.at, '', '', o.at
    FROM touches t
    JOIN touches o ON o.path = t.path AND o.session != t.session
    JOIN sessions s ON s.name = o.session
    WHERE t.session = $R
      AND NOT EXISTS (SELECT 1 FROM seen m
                      WHERE m.session = $R AND m.stream = 'overlap'
                        AND m.ref = o.session || char(31) || o.path
                        AND m.at >= $c AND m.at >= CAST(strftime('%s', s.created_at) AS INTEGER))
    UNION ALL
    SELECT 'archive', '', a.id, a.session, a.outcome, a.pr_url, a.repo_root,
           coalesce((SELECT group_concat(key || ': ' || value, '; ')
                     FROM json_each(CASE WHEN json_valid(a.notes) THEN a.notes ELSE '{}' END)), ''),
           a.id
    FROM archive a, amark
    WHERE a.id > amark.id AND a.session != $R AND $c IS NOT NULL
    ORDER BY 1, 9" 2>/dev/null) || return 0
  [[ -n "$out" ]] || return 0

  # Something is new: is it this repository's? Another repository's rows are
  # marked too, without a word, or every edit would find them again.
  local -a rows sibs f
  rows=() sibs=()
  for row in "${(@ps:\x1e:)out}"; do
    [[ -n "$row" ]] && rows+=("$row")
  done
  (( ${#rows} )) || return 0
  sibs=("${(@f)$(db_repo_siblings "$me")}")
  sibs=("${(@)sibs:#}")
  local myroot mycommon root show ref sql=""
  myroot=$(db_session_field "$me" repo_root)
  db_common_of "$myroot" >/dev/null
  mycommon="${_WTS_COMMON[$myroot]}"
  for (( i = 1; i <= ${#rows}; i++ )); do
    f=("${(@ps:\x1f:)rows[i]}")
    show=0
    if [[ "${f[1]}" == archive ]]; then
      ref=$(sql_str "${f[3]:-}")
      root="${f[7]:-}"
      if [[ -n "$root" ]]; then
        db_common_of "$root" >/dev/null
        [[ "${_WTS_COMMON[$root]}" == "$mycommon" ]] && show=1
      fi
    else
      ref="$(sql_str "${f[3]:-}") || char(31) || $(sql_str "${f[4]:-}")"
      (( ${sibs[(Ie)${f[3]:-}]} )) && show=1
    fi
    sql+="INSERT INTO cand VALUES ($i, $(sql_str "${f[1]}"), $ref, $(sql_str "${f[2]:-}"), $show);"$'\n'
  done

  # Read and mark in one write transaction: two hooks of the same agent (a
  # prompt and an edit, or parallel edits) wait on BEGIN IMMEDIATE, and the
  # second finds the first one's marks and delivers nothing.
  local got
  got=$(db_rows_rw "BEGIN IMMEDIATE;
    CREATE TEMP TABLE cand (i INTEGER, stream TEXT, ref TEXT, mark TEXT, show INTEGER);
    $sql
    DELETE FROM cand WHERE stream != 'archive' AND EXISTS (
      SELECT 1 FROM seen m WHERE m.session = $R AND m.stream = cand.stream
        AND m.ref = cand.ref AND m.mark = cand.mark AND m.at >= $c);
    DELETE FROM cand WHERE stream = 'archive' AND CAST(ref AS INTEGER) <= coalesce(
      (SELECT CAST(mark AS INTEGER) FROM seen
       WHERE session = $R AND stream = 'archive' AND ref = '' AND at >= $c), 0);
    SELECT i FROM cand WHERE show = 1 ORDER BY i;
    INSERT OR REPLACE INTO seen (session, stream, ref, mark, at)
      SELECT $R, stream, ref, mark, $now FROM cand WHERE stream != 'archive';
    INSERT OR REPLACE INTO seen (session, stream, ref, mark, at)
      SELECT $R, 'archive', '', max(CAST(ref AS INTEGER)), $now FROM cand
      WHERE stream = 'archive' HAVING count(*) > 0;
    COMMIT;" 2>/dev/null) || return 0

  local -a notes overlap finished
  notes=() overlap=() finished=()
  local what sub
  for k in "${(@ps:\x1e:)got}"; do
    [[ "$k" == <-> ]] || continue
    f=("${(@ps:\x1f:)rows[k]}")
    case "${f[1]}" in
      notes)
        notes+=("- ${f[3]}/${f[4]}: $(cut120 "${f[5]:-}")") ;;
      overlap)
        # by_sub: the edit that ran this hook was a subagent's, and it is the
        # file of this line. The agent reading the news did not make that edit
        # itself, and may not know which file it was.
        sub=""
        [[ -n "$by_sub" && "${f[4]}" == "$by_sub" ]] && sub=" (by a subagent)"
        overlap+=("wts: ${f[4]}$sub was edited by session \`${f[3]}\` too (branch ${f[5]:--}, first edited it $(age_ago "${f[6]:-}")).") ;;
      archive)
        what="${f[5]:-unknown}"
        if [[ "${f[6]:-}" =~ '/pull/([0-9]+)' ]]; then what+=", PR #${match[1]}"; fi
        if [[ -n "${f[8]:-}" ]]; then
          finished+=("wts: session \`${f[4]}\` finished ($what) — the notes it left: $(cut120 "${f[8]}")")
        else
          finished+=("wts: session \`${f[4]}\` finished ($what), and left no notes.")
        fi ;;
    esac
  done
  # Five lines per stream at most: this lands in the agent's context.
  if (( ${#notes} )); then
    print -r -- "wts: new notes from the other sessions on this repository:"
    print -rl -- "${(@)notes[1,5]}"
    (( ${#notes} > 5 )) && print -r -- "- (… $(( ${#notes} - 5 )) more: wts db notes --all)"
  fi
  if (( ${#overlap} )); then
    print -rl -- "${(@)overlap[1,5]}"
    (( ${#overlap} > 5 )) && print -r -- "wts: (… $(( ${#overlap} - 5 )) more: wts db sql \"select * from touches\")"
    print -r -- "Read their notes (wts db notes --all) before going further, and leave one if your change affects them (wts db set <key> \"<one line>\")."
  fi
  if (( ${#finished} )); then
    print -rl -- "${(@)finished[1,5]}"
    (( ${#finished} > 5 )) && print -r -- "wts: (… $(( ${#finished} - 5 )) more: wts log)"
  fi
  return 0
}

# ─── touch: a file edited ────────────────────────────────────────────────────
# Not an agent_events row: an agent edits dozens of files a turn, and the
# events are about its state. One touches row per (session, path), the first
# time. The news are looked at on every edit, not only a new file's: that is
# how a working agent hears of a note before its turn is over, and how the
# first editor of a file hears that a sibling edited it too. The overlap itself
# is one of the news, marked like the rest: once per sibling and file.
# A subagent's edit carries agent_id: its path is kept in by_sub, and the
# overlap line about it says "(by a subagent)".
by_sub=""
if [[ "$EVENT" == touch ]]; then
  if [[ -n "$file" ]]; then
    wt=$(db_session_field "$me" worktree)
    [[ "$file" == /* ]] || file="$PWD/$file"
    rel=""
    if [[ -n "$wt" ]]; then
      for root in "$wt" "${wt:A}"; do
        for f in "$file" "${file:A}"; do
          if [[ "$f" == "$root"/* ]]; then rel="${f#$root/}"; break 2; fi
        done
      done
    fi
    # Outside the worktree: not this repository's file, not recorded.
    if [[ -n "$rel" ]]; then
      [[ -n "$agent_id" ]] && by_sub="$rel"
      db_q "INSERT OR IGNORE INTO touches (session, path, at)
            VALUES ($(sql_str "$me"), $(sql_str "$rel"), $now)" >/dev/null 2>&1
    fi
  fi
  $quiet && exit 0
  $db_ready || exit 0
  text=$(deliver_news)
  [[ -n "$text" ]] || exit 0
  jq -cn --arg t "$text" \
    '{hookSpecificOutput: {hookEventName: "PostToolUse", additionalContext: $t}}' >&3 2>/dev/null
  exit 0
fi

db_q "INSERT INTO agent_events (session, claude_session, event, kind, message, at)
      VALUES ($(sql_str "$me"), $(sql_str "$sid"), $(sql_str "$EVENT"),
              $(sql_str "$kind"), $(sql_str "${msg[1,400]}"), $now);
      DELETE FROM agent_events WHERE at < $now - 7 * 86400;" >/dev/null 2>&1 || exit 0

# ─── prompt: the news, at the start of a turn ────────────────────────────────
# Only once db_init succeeded (above): the marks need the seen table.
if [[ "$EVENT" == prompt ]] && ! $quiet && $db_ready; then
  news=$(deliver_news)
  [[ -n "$news" ]] && print -u3 -r -- "$news"
fi

# ─── Attention ───────────────────────────────────────────────────────────────

mode="${WTS_NOTIFY:-1}"
[[ "$mode" == 0 ]] && exit 0
case "$EVENT" in
  # Only the kinds that need a human (needs_human in wts-db.zsh, the list the
  # collector reads `blocked` from), an untyped one from an older Claude Code,
  # and the idle reminder. The rest (auth_success, an elicitation completed, a
  # quota resume) are recorded above and disturb nobody.
  notification)
    needs_human "$kind" || [[ -z "$kind" || "$kind" == idle_prompt ]] || exit 0 ;;
  stop) ;;
  *) exit 0 ;;
esac

# Visible = the user is looking at this pane right now: a terminal in front
# (macOS only: lsappinfo), the session attached and the window active. Any
# doubt answers "not visible": one banner too many beats a missed one.
visible() {
  local st
  if [[ -n "${TMUX:-}" && -n "${TMUX_PANE:-}" ]]; then
    st=$(tmux display-message -p -t "$TMUX_PANE" '#{session_attached}:#{window_active}' 2>/dev/null)
    [[ "$st" == [1-9]*:1 ]] || return 1
  fi
  if command -v lsappinfo >/dev/null 2>&1; then
    local asn front ids
    asn=$(lsappinfo front 2>/dev/null) || return 1
    [[ -n "$asn" ]] || return 1
    front=$(lsappinfo info -only bundleid "$asn" 2>/dev/null | awk -F'"' '{print $4}')
    [[ -n "$front" ]] || return 1
    ids="${WTS_NOTIFY_TERMINALS:-com.googlecode.iterm2 com.apple.Terminal com.mitchellh.ghostty com.anthropic.claudefordesktop com.microsoft.VSCode dev.warp.Warp-Stable net.kovidgoyal.kitty com.github.wez.wezterm io.alacritty}"
    [[ " $ids " == *" $front "* ]] || return 1
  fi
  return 0
}
visible && exit 0

# The turn's length, from the last prompt: under ten seconds it says nothing.
fmt_duration() {
  local s="$1"
  if (( s < 60 )); then print -r -- "${s}s"
  elif (( s < 3600 )); then print -r -- "$(( s / 60 ))m$(( s % 60 ))s"
  else print -r -- "$(( s / 3600 ))h$(( (s % 3600) / 60 ))m"
  fi
}

case "$EVENT" in
  notification)
    # The idle reminder is not a question: the switcher reads that agent idle,
    # and its banner said "needs you", on the heels of the "is done" of the
    # same turn.
    if [[ "$kind" == idle_prompt ]]; then
      title="wts: $me is idle"
      body="${msg:-waiting for your next message}"
      sound="Pop"
    else
      title="wts: $me needs you"
      body="${msg:-waiting for your answer}"
      sound="Glass"
    fi
    ;;
  stop)
    title="wts: $me is done"
    body="turn finished"
    started=$(db_ro "SELECT max(at) FROM agent_events
                     WHERE session = $(sql_str "$me") AND event = 'prompt'" 2>/dev/null)
    if [[ "$started" == <-> ]] && (( now - started >= 10 && now - started < 86400 )); then
      body="turn finished in $(fmt_duration $(( now - started )))"
    fi
    sound="Pop"
    ;;
esac

# The bell: the pane's own terminal, so tmux flags the window (monitor-bell)
# and a theme that draws flags shows it. Nothing else is written there.
if [[ "$mode" == 1 || "$mode" == bell ]]; then
  { print -n '\a' > /dev/tty; } 2>/dev/null
fi

[[ "$mode" == 1 || "$mode" == banner ]] || exit 0

# A click on a terminal-notifier banner switches the tmux client to the
# session (WTS_NOTIFIER names the binary; the one on PATH is used otherwise).
# osascript's notification has no click action; notify-send is the Linux one.
sock=""
[[ -n "${TMUX:-}" ]] && sock=$(tmux display-message -p '#{socket_path}' 2>/dev/null)
notifier="${WTS_NOTIFIER:-}"
[[ -n "$notifier" && -x "$notifier" ]] || notifier=$(command -v terminal-notifier 2>/dev/null) || notifier=""
if [[ -n "$notifier" ]]; then
  typeset -a click
  click=()
  if [[ -n "$sock" && "$me" != *[\'\"\\]* && "$sock" != *[\'\"\\]* ]]; then
    click=(-execute "tmux -S '$sock' switch-client -t '=$me'")
  fi
  "$notifier" -title "$title" -message "$body" -group "wts-$me" -sound "$sound" \
    "${click[@]}" >/dev/null 2>&1 </dev/null &!
elif command -v osascript >/dev/null 2>&1; then
  # Backslashes dropped, quotes escaped: the text is interpolated into an
  # AppleScript string literal.
  t="${title//\\/}"; b="${body//\\/}"
  osascript -e "display notification \"${b//\"/\\\"}\" with title \"${t//\"/\\\"}\" sound name \"$sound\"" \
    >/dev/null 2>&1 </dev/null &!
elif command -v notify-send >/dev/null 2>&1; then
  notify-send -- "$title" "$body" >/dev/null 2>&1 </dev/null &!
fi
exit 0
