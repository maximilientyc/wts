#!/usr/bin/env zsh
# wts-context — Claude Code SessionStart hook: tell the agent about the others
#
# Installed by `wts setup claude`. Claude Code adds what a SessionStart hook
# prints to the new conversation's context, at startup and again after
# /clear, /compact and a resume, so an agent in a wts session learns — without
# anyone telling it — that other agents work in parallel on this machine, what
# they are doing, and that `wts db` reads and writes the state they share.
#
# Outside a wts session it prints nothing and exits 0: the hook is user-wide,
# and a Claude started anywhere else must not pay for it or see a word of it.
#
# Read from the database: no git status, no wts-status, no model call. A session
# start must never wait on a `git status` of every worktree; the agent can run
# `wts status --json` itself when it wants live agent states.
#
# Every line printed here is re-injected at each start, /clear, /compact and
# resume, so the output is kept to what can change what the agent does: the
# sessions of the SAME repository (another repository's cannot collide with
# this worktree), capped, and the directives about overlap only when such a
# session exists. It used to list fifteen sessions of any repository, ten
# notes, a task's notes uncapped and the MANDATORY block even under "No other
# wts session is registered" — 1 to 2k tokens, every time.
#
# Usage: wts-context
# Variables: WTS_CONTEXT_QUIET=1 — only who the agent is and its task's title

set -uo pipefail

WTS_BIN="${0:A:h}"
WTS_CMD="${0:A:h:h:h}/bin/wts"
source "$WTS_BIN/wts-db.zsh"

# stdin (the hook's JSON payload) is left unread: the session is found from
# the pane or the working directory, and draining it would hang a manual run
# whose stdin never closes.

db_available || exit 0
[[ -s "$WTS_DB" ]] || exit 0
me=$(db_current_session) || exit 0
# This may be the first wts code to open a database an older wts left at
# schema 8: the marks below need the seen table. Its fast path is one PRAGMA,
# and a failure costs the marks only (the next turn repeats a note), never the
# context.
db_ready=false
db_init >/dev/null 2>&1 && db_ready=true

# The agent's Bash tool may not have wts on its PATH (a pane's login shell
# rebuilds it): name it the way this hook was reached.
wts="wts"
if ! command -v wts >/dev/null 2>&1 && [[ -x "$WTS_CMD" ]]; then
  wts="$WTS_CMD"
fi

cut80() {
  local v="${1//[[:cntrl:]]/ }"
  (( ${#v} > 80 )) && v="${v[1,79]}…"
  print -r -- "$v"
}

IFS=$'\x1f' read -r -d $'\x1e' my_branch my_worktree my_repo my_task my_task_notes my_task_links my_task_id \
    my_linked_at my_linked_late \
  < <(db_rows "SELECT s.branch, s.worktree, s.repo_root,
                      coalesce(t.title, ''), coalesce(t.notes, ''),
                      coalesce((SELECT group_concat(json_extract(value, '\$.url'), ' ')
                                FROM json_each(t.links) WHERE json_valid(t.links)), ''),
                      coalesce(l.task, ''), substr(coalesce(l.linked_at, ''), 1, 10),
                      coalesce(unixepoch(l.linked_at) - unixepoch(s.created_at) > 300, 0)
               FROM sessions s
               LEFT JOIN task_links l ON l.session = s.name
               LEFT JOIN tasks t ON t.id = l.task
               WHERE s.name = $(sql_str "$me")")

print -r -- "# wts: you are in session \`$me\` (branch ${my_branch:--}, worktree $my_worktree)"
if [[ -n "${WTS_CONTEXT_QUIET:-}" ]]; then
  [[ -n "${my_task:-}" ]] \
    && print -r -- "Task: **$my_task** (\`$wts task show ${my_task_id:-<id>}\`)"
  exit 0
fi
print -r -- ""

# The task this session serves, when there is one. Worth the lines: the notes are
# where the author keeps the Notion pages, the meeting minutes and the Slack
# threads for this piece of work, and an agent that knows them does not have to be
# told to go and look for them. DB-only, like everything in this hook.
#
# This is also the ONLY channel that comes back: the agent's opening prompt and
# .wts/context.md are read once, and Claude Code re-runs SessionStart after
# /clear, /compact and a resume. So the task's own context is repeated here
# rather than assumed to be still in the window.
if [[ -n "${my_task:-}" ]]; then
  print -r -- "You are working on the task: **$my_task**"
  # Capped like the wts notes below: a Things task can carry a pasted log or a
  # meeting's minutes, and this was the one field printed whole. Lines kept as
  # lines — the author's list stays a list — each one cut, then a pointer to
  # the rest.
  if [[ -n "${my_task_notes:-}" ]]; then
    print -r -- "Its notes (the author's own, verbatim):"
    typeset -a note_lines
    note_lines=("${(@f)my_task_notes}")
    note_lines=("${(@)note_lines:#}")
    for nl in "${(@)note_lines[1,12]}"; do
      nl="${nl//[[:cntrl:]]/ }"
      (( ${#nl} > 200 )) && nl="${nl[1,199]}…"
      print -r -- "  $nl"
    done
    (( ${#note_lines} > 12 )) \
      && print -r -- "  (… $(( ${#note_lines} - 12 )) more line(s): \`$wts task show ${my_task_id:-<id>}\`)"
  fi
  # Notes kept on the task in wts rather than in Things. Newest last, capped like
  # everything else here: this is the one field in this file a user can grow
  # without limit, and it is the agent's context window that pays.
  if [[ -n "${my_task_id:-}" ]]; then
    task_note_n=0
    while IFS=$'\x1f' read -r -d $'\x1e' note_at note_body; do
      [[ -n "$note_body" ]] || continue
      (( task_note_n++ == 0 )) && print -r -- "Notes added in wts:"
      print -r -- "  ($note_at) $(cut80 "$note_body")"
    # The ten most recent, then back in order: DESC alone would print the newest
    # first, and these read as a running log.
    done < <(db_rows "SELECT substr(added_at, 1, 10), body FROM (
                        SELECT added_at, body FROM task_notes
                        WHERE task = $(sql_str "$my_task_id")
                        ORDER BY added_at DESC LIMIT 10)
                      ORDER BY added_at" 2>/dev/null)
  fi
  # The sessions that already tried, and what stopped them: without this a
  # retry rediscovers the flaky test and the wrong assumption the first one hit.
  # Three at most, each line cut by the renderer: this is re-injected at every
  # start, /clear and /compact.
  if [[ -n "${my_task_id:-}" ]]; then
    task_attempts=$(task_attempts_md "$my_task_id" 3 2>/dev/null) || task_attempts=""
    [[ -n "$task_attempts" ]] && print -r -- "$task_attempts" | sed -e '/^$/d' -e '2,$s/^/  /'
  fi
  # Selected since the task layer landed and never printed until now: the links
  # ARE the context, and the agent in this pane can often read a private page the
  # sandboxed `wts doc` fetch could not.
  if [[ -n "${my_task_links:-}" ]]; then
    print -r -- "Links it carries (read the ones you need):"
    for task_link in ${=my_task_links}; do
      [[ -n "$task_link" ]] && print -r -- "  $task_link"
    done
  fi
  # With the id, always: `wts task show` alone resolves the task through the
  # Things picker — a read of Things' container and an fzf with no terminal —
  # and this line is run by an agent, which may not open Things (CLAUDE.md).
  # `$wts`, not `wts`: the agent's Bash tool may not have it on its PATH.
  print -r -- "Other sessions may serve the same task: \`$wts task show ${my_task_id:-<id>}\` lists them."
  print -r -- "Add to it as you learn: \`$wts task note \"<what you found>\"\` — it outlives this session."
  # How the link was made, so a link the work has outgrown can be recognized:
  # a session keeps the task it was created for while the user moves it on to
  # the next piece of work, and the roadmap that asked for this line was
  # written by a session still introduced as the previous item's.
  if [[ -n "${my_linked_at:-}" ]]; then
    if [[ "${my_linked_late:-0}" == 1 ]]; then how="linked on $my_linked_at"; else how="linked at its creation, $my_linked_at"; fi
    print -r -- "This session was $how. If the work has moved on to something else: \`$wts task link <id>\`, or \`$wts task new \"<title>\"\` then link it."
  fi
  print -r -- ""
fi
# Same repository only: those are the sessions whose work can collide with
# yours. Not a comparison of repo_root: a session created from inside another
# worktree records that worktree as its root, so the repository is git's
# common directory (db_common_of in wts-db.zsh) — one rev-parse per distinct
# root, no status, a few ms. Its memo is filled in the loop below, not in a
# command substitution, which would lose it and run git once per session.
db_common_of "$my_repo" >/dev/null
my_common="${_WTS_COMMON[$my_repo]}"

# Claude Code's messages between sessions (claude_messaging in wts-db.zsh: the
# version and crossSessionInbound, cached in kv): when they work, each sibling
# line says the name its agent answers SendMessage on, read from Claude Code's
# own session files (claude_peer_names). Only a live agent gets one: a session
# whose agent is not running cannot be messaged, and is not listed by
# ListAgents either. Without them nothing is said, and the skill's wts send
# and wts wait are the way.
typeset -A peer_of
if claude_messaging "$my_worktree" >/dev/null 2>&1; then
  while IFS=$'\x1f' read -r pcwd pname; do
    [[ -n "$pcwd" && -n "$pname" && -z "${peer_of[$pcwd]:-}" ]] && peer_of[$pcwd]="$pname"
  done < <(claude_peer_names)
fi
# The name of the agent working in <worktree> (or a folder of it, WTS_SUBDIR),
# under either spelling of the path: the registry keeps what wts was given, the
# session file the resolved one.
peer_in() {  # <worktree>
  local wt c
  (( ${#peer_of} )) || return 1
  for wt in "$1" "${1:A}"; do
    for c in "${(@k)peer_of}"; do
      if [[ "$c" == "$wt" || "$c" == "$wt"/* ]]; then print -r -- "${peer_of[$c]}"; return 0; fi
    done
  done
  return 1
}

# Eight at most, newest first: a machine with fifty sessions must not flood the
# context, and the eighth most recent sibling is rarely the one that collides.
typeset -a siblings sibling_names
siblings=() sibling_names=()
while IFS=$'\x1f' read -r -d $'\x1e' name branch root wt prompt context brief brief_age; do
  [[ -n "$name" ]] || continue
  db_common_of "$root" >/dev/null
  [[ "${_WTS_COMMON[$root]}" == "$my_common" ]] || continue
  sibling_names+=("$name")
  (( ${#siblings} < 8 )) || continue
  line="- $name ($branch)"
  subject="$prompt"
  [[ -n "$subject" ]] || subject="$context"
  [[ -n "$subject" ]] && line+=": $(cut80 "$subject")"
  # "2h ago": a brief is a cache of the model's summary, and one written last
  # week reads exactly like one written a minute ago.
  [[ -n "$brief" ]] && line+=" — brief, $(age_ago "$brief_age"): $(cut80 "$brief")"
  if peer=$(peer_in "$wt"); then line+=" — reach \`$peer\` with SendMessage"; fi
  siblings+=("$line")
done < <(db_rows "SELECT s.name, s.branch, s.repo_root, s.worktree, s.prompt, s.context,
                         coalesce(replace(b.body, char(10), ' / '), ''),
                         coalesce(CAST(strftime('%s', 'now') AS INTEGER) - b.updated_at, '')
                  FROM sessions s LEFT JOIN briefs b ON b.session = s.name
                  WHERE s.name != $(sql_str "$me")
                  ORDER BY s.created_at DESC")

# Alone in this repository: nothing to collide with, so no directives either.
# One line says the database exists, for the day a sibling appears.
if (( ${#sibling_names} == 0 )); then
  print -r -- "No other wts session works on this repository. Shared state, if you need it: \`$wts db help\`."
  exit 0
fi

print -r -- "Other agents work in parallel on this repository, one per wts session (a git"
print -r -- "worktree + a tmux session each). Their shared state is a SQLite database: $WTS_DB"
print -r -- ""
print -r -- "Sessions on this repository (newest first):"
print -rl -- "${siblings[@]}"
(( ${#sibling_names} > ${#siblings} )) \
  && print -r -- "- (… $(( ${#sibling_names} - ${#siblings} )) more: \`$wts db sql \"select name, branch, prompt from sessions\"\`)"

# The notes of those sessions only, and five: notes are what an agent leaves for
# the others, and another repository's are about files this one does not have.
typeset -a notes
notes=()
while IFS=$'\x1f' read -r -d $'\x1e' session key value age; do
  [[ -n "$session" ]] || continue
  notes+=("- $session/$key ($(age_ago "$age")): $(cut80 "$value")")
done < <(db_rows "SELECT session, key, value,
                         CAST(strftime('%s', 'now') AS INTEGER) - CAST(strftime('%s', updated_at) AS INTEGER)
                  FROM notes
                  WHERE session IN $(sql_list "${sibling_names[@]}")
                  ORDER BY updated_at DESC LIMIT 5")
if (( ${#notes} )); then
  print -r -- ""
  print -r -- "Latest notes they left:"
  print -rl -- "${notes[@]}"
fi
# What this context carries counts as told: the next turn's hook (wts-hook,
# deliver_news) delivers only what is newer. Every sibling note and not only
# the five shown, as the hook does past its own five: the rest is one
# `wts db notes --all` away. The finished sessions are not marked: this context
# does not list them, and after a /clear one not yet delivered would be lost.
if $db_ready; then
  db_q "INSERT OR REPLACE INTO seen (session, stream, ref, mark, at)
        SELECT $(sql_str "$me"), 'notes', session || char(31) || key, value,
               CAST(strftime('%s', 'now') AS INTEGER)
        FROM notes WHERE session IN $(sql_list "${sibling_names[@]}")" >/dev/null 2>&1
fi

# The files this session has already edited and a sibling has too — the exact
# overlap, from the PostToolUse hook. Only after /clear, /compact or a resume
# can there be any; at a first start this prints nothing.
typeset -a overlap
overlap=()
while IFS=$'\x1f' read -r -d $'\x1e' opath osess; do
  [[ -n "$opath" ]] || continue
  overlap+=("- $opath (also: $osess)")
done < <(db_rows "SELECT mine.path, group_concat(theirs.session, ', ')
                  FROM touches mine JOIN touches theirs
                    ON theirs.path = mine.path AND theirs.session != mine.session
                  WHERE mine.session = $(sql_str "$me")
                    AND theirs.session IN $(sql_list "${sibling_names[@]}")
                  GROUP BY mine.path ORDER BY max(theirs.at) DESC LIMIT 6" 2>/dev/null)
if (( ${#overlap} )); then
  print -r -- ""
  print -r -- "Files you and another session have both edited:"
  print -rl -- "${(@)overlap[1,5]}"
  (( ${#overlap} > 5 )) && print -r -- "- (… more: $wts db sql \"select * from touches\")"
fi

# The rest is in the skill (`wts setup claude --install` installs it): this
# block is re-injected at every start, /clear and /compact, and a reference
# loaded when needed costs nothing until then. When a file you edit is also
# edited in one of these sessions, the PostToolUse hook says so at that moment.
cat <<EOF

If you edit a file one of them also edits, wts tells you then. When your change
affects them (a migration, a shared model, an API contract), leave one line:
  $wts db set <key> "<one line>"
Everything else — their notes, live states, sending to or waiting for another
agent — is in the wts skill (or: $wts help).
EOF
exit 0
