#!/usr/bin/env zsh
# wts-switch — fzf session picker, designed for `tmux display-popup -E`.
#
# Sessions known to the registry are listed first, sorted by urgency (stuck or
# blocked agent > idle > working), with a live preview of the agent's pane. Then
# the open TASKS — the work still to start first, then the work already served by
# a session — and last the tmux sessions unknown to the registry.
#
#   enter    switch to the session; on a task, choose: attach it to a session,
#            or start one from a prompt or a branch name (through wts-fresh)
#   tab      reply mode: type for the previewed agent, enter sends (fzf >= 0.45)
#            on a task: note mode, enter appends the line to its notes
#   esc      leave reply mode, or close the popup
#   ctrl-r   reload the list by hand
#   ctrl-d   delete the session (wts rm) and reload
#            on a local task: mark it done (wts task done), after a y/N prompt
#   ctrl-x   stop the session: its tmux session only (wts stop), after a y/N prompt
#   ctrl-o   open the session's pull request on GitHub (wts pr, needs gh)
#   ctrl-e   attach a context document to the session, or to the task
#   ctrl-t   new task: type its title, enter creates it (wts task new);
#            enter on an empty title pulls one from Things (wts task add)
#   ctrl-f   scroll the preview down half a page
#   ctrl-b   scroll the preview up half a page
#   ?        show or hide the full key list in the footer (fzf >= 0.65)
#
# That list is not only written here: wts-keys prints it under the list, so the
# keys are read from the popup itself. See the "Footer" section.
#
# The list and the preview refresh on their own every $WTS_SWITCH_REFRESH
# seconds (2 by default, 0 to turn it off). See the "Live refresh" section
# below for why it is wired this way.
#
# The preview window is as wide as the agent's pane, up to the half of the
# popup it starts with: see the "Preview width" section.
#
# `--next` (no UI): switch straight to the first agent that needs a human. The
# engine already sorts in that order, so it is the first line whose state is
# actionable.

set -uo pipefail

WTS_BIN="${0:A:h}"

# The tmux server's PATH may not contain wts (a popup sources no shell): use
# the wts installed next to this helper, and only fall back to the PATH.
WTS_CMD="${0:A:h:h:h}/bin/wts"
[[ -x "$WTS_CMD" ]] || WTS_CMD=$(command -v wts 2>/dev/null)

# History depth captured for the preview: enough for ctrl-b to go far back,
# little enough for the capture to stay instant.
SCROLLBACK="${WTS_SWITCH_SCROLLBACK:-2000}"

# The registry is read directly by the skeleton, which must not pay for wts-status.
source "$WTS_BIN/wts-db.zsh"

# The session to mark with " *". Global rather than a render_line argument: both
# producers set it once, and `set -u` would trip on it if it were only local.
typeset -g current=""

# Each line: <display> TAB <preview-target> TAB <session-name>
# fzf only shows field 1; fields 2 and 3 drive the preview and the switch.
#
# Three fields and not four, even now that a row may be a TASK rather than a
# session: a task row carries `task:<id>` in field 2 and leaves field 3 EMPTY.
# That is the same "not a session" signal the header row already uses, so every
# bind that takes {3} — ctrl-x, ctrl-o, ctrl-e, tab — is a no-op on a task
# without being told about tasks at all, and `wts status --fzf` keeps its shape.
# ctrl-d was the one exception and is now behind --rm, which reads {2} to
# close a task; see there.
#
# The producers collect rows with add_row and `emit` lays the table out in one
# go, every line exactly as wide as the list. The widths come from the rows
# themselves, so the skeleton below and the collected list — same registry, same
# tmux server — compute the same widths and the swap redraws nothing shifted.
# For that reason BOTH producers must list the same tasks, not just the same
# sessions.
# The header is the first TWO lines of the output (--header-lines=2) rather than
# a --header fixed at startup, so it is laid out again with the rows when a
# session appears or is deleted under the popup: the per-state counts, then the
# column titles. See "View" for the first.
#
# <kind> is empty for a registered session, `task` for a task and `tmux` for a
# tmux session the registry does not know. Only `task` empties field 3: a
# foreign tmux session is still somewhere to switch to.
typeset -ga rows
rows=()
SEP=$'\x1f'

add_row() { # <name> <agent> <branch> <delta> <subject> <preview-target> [<kind>] [<pr>] [<repo root>]
  rows+=("$1$SEP$2$SEP$3$SEP$4$SEP${5:-}$SEP$6$SEP${7:-}$SEP${8:-}$SEP${9:-}")
}

# The repository a session works on, by name: what `wts ls` calls REPO. Read
# from the worktree's `.git` file rather than asked of git, because this runs on
# every row of every 2-second tick: a linked worktree's `.git` says
# `gitdir: <main>/.git/worktrees/<name>`, and <main> is the repository. A
# session created from inside a worktree has that worktree as its repo_root, so
# the root alone would name the wrong thing. Memoized per process.
typeset -gA repo_names
repo_label() { # <repo root> -> REPLY
  local r="$1" line=""
  REPLY=""
  [[ -n "$r" ]] || return 0
  if [[ -n "${repo_names[$r]:-}" ]]; then REPLY="${repo_names[$r]}"; return 0; fi
  local main="$r"
  if [[ -f "$r/.git" ]]; then
    read -r line < "$r/.git" 2>/dev/null
    line="${line#gitdir: }"
    [[ "$line" == /*/worktrees/* ]] && main="${line%/worktrees/*}"
    [[ "$main" == */.git ]] && main="${main:h}"
  fi
  REPLY="${${main:t}%.git}"
  repo_names[$r]="$REPLY"
}

# Cut to <width> characters, the last one an ellipsis, into REPLY. zsh counts
# characters, not bytes, so `…` and accents pad like any other letter.
fit() { # <text> <width>
  REPLY="$1"
  (( ${#REPLY} > $2 )) && REPLY="${REPLY[1,$2-1]}…"
}

# The agent states, and "+123/-45 ^2".
AGENT_W=7
DELTA_W=10
# A repository name past this is cut: the column is there to tell two apart.
REPO_CAP=12

emit() {
  (( ${#rows} )) || return 0
  local width="${WTS_SWITCH_COLS:-120}"

  # Like `column -t`, but capped: a 60-character slug must not eat the subject.
  # The current session's `*` counts as part of its name.
  # The PR column only exists while some row has something to say in it: on a
  # machine without gh, or before the first refresh, it would be a blank column
  # taking ten characters from the subject.
  # The REPO column only exists while the sessions span several repositories,
  # as in `wts ls`: with one, it would repeat the same word on every row.
  #
  # Measured on ALL the rows, the ones the view hides included: ctrl-g then
  # redraws the same columns with rows missing, instead of a new layout.
  local -a f
  local -A seen_repo
  local raw mark name_w=7 branch_w=6 pr_w=0 repo_w=0
  for raw in "${rows[@]}"; do
    f=("${(@ps:\x1f:)raw}")
    mark=""; [[ "${f[7]:-}" != task && "$f[1]" == "$current" ]] && mark="*"
    (( ${#f[1]} + ${#mark} > name_w )) && name_w=$(( ${#f[1]} + ${#mark} ))
    (( ${#f[3]} > branch_w )) && branch_w=${#f[3]}
    (( ${#${f[8]:-}} > pr_w )) && pr_w=${#${f[8]:-}}
    if [[ -n "${f[9]:-}" ]]; then
      repo_label "$f[9]"
      seen_repo[$REPLY]=1
      (( ${#REPLY} > repo_w )) && repo_w=${#REPLY}
    fi
  done
  (( pr_w > 0 && pr_w < 2 )) && pr_w=2
  if (( ${#seen_repo} > 1 )); then
    (( repo_w < 4 )) && repo_w=4
    (( repo_w > REPO_CAP )) && repo_w=$REPO_CAP
  else
    repo_w=0
  fi
  # Four single-space gaps between five columns, five between six.
  local rest=$(( width - AGENT_W - DELTA_W - 4 ))
  (( pr_w )) && rest=$(( rest - pr_w - 1 ))
  (( repo_w )) && rest=$(( rest - repo_w - 1 ))
  (( rest < 24 )) && rest=24
  local cap=$(( rest * 45 / 100 ))
  (( cap < 12 )) && cap=12
  (( name_w > cap )) && name_w=$cap
  cap=$(( rest * 35 / 100 ))
  (( cap < 8 )) && cap=8
  (( branch_w > cap )) && branch_w=$cap
  local subject_w=$(( rest - name_w - branch_w ))
  local line_w=$(( name_w + AGENT_W + branch_w + DELTA_W + subject_w + 4 ))
  (( pr_w )) && line_w=$(( line_w + pr_w + 1 ))
  (( repo_w )) && line_w=$(( line_w + repo_w + 1 ))

  # The counts line first, padded like a row and with empty fields 2 and 3: it
  # is a header line, and fzf cuts every line at the same column.
  view_line
  fit "$REPLY" $line_w
  printf '%-*s\t\t\n' $line_w "$REPLY"

  # Then the column titles, with an empty field 6 so that they have 3 TAB fields
  # too. The `*` is appended after the cut, so a name too long for its column
  # keeps it.
  local name agent branch delta subject sess repo cells cell
  for raw in "SESSION${SEP}AGENT${SEP}BRANCH${SEP}DELTA${SEP}SUBJECT${SEP}${SEP}${SEP}PR${SEP}" "${rows[@]}"; do
    f=("${(@ps:\x1f:)raw}")
    # The view: a row it hides is not printed at all, rather than printed and
    # filtered by fzf, which would leave it to the query. The titles always pass.
    [[ -z "$f[6]" && -z "${f[7]:-}" ]] || view_shows "$f[2]" "${f[7]:-}" || continue
    # Field 3 is the session name, and only a session has one: a task row and
    # the header both leave it empty. This is what makes `enter` on a task go to
    # --start instead of switch-client, and every {3} bind a no-op there.
    sess=""
    [[ -n "$f[6]" && "${f[7]:-}" != task ]] && sess="$f[1]"
    mark=""; [[ -n "$sess" && "$f[1]" == "$current" ]] && mark="*"
    fit "$f[1]" $(( name_w - ${#mark} )); name="$REPLY$mark"
    # printf -v and not $(printf): a command substitution is a fork, per cell,
    # per row, every 2 seconds.
    printf -v cells '%-*s ' $name_w "$name"
    if (( repo_w )); then
      if [[ -z "$f[6]" && -z "${f[7]:-}" ]]; then repo=REPO
      elif [[ -n "${f[9]:-}" ]]; then repo_label "$f[9]"; repo=$REPLY
      else repo="-"; fi
      fit "$repo" $repo_w
      printf -v cell '%-*s ' $repo_w "$REPLY"; cells+=$cell
    fi
    fit "$f[2]" $AGENT_W;    agent=$REPLY
    fit "$f[3]" $branch_w;   branch=$REPLY
    fit "$f[4]" $DELTA_W;    delta=$REPLY
    fit "$f[5]" $subject_w;  subject=$REPLY
    printf -v cell '%-*s %-*s %-*s ' $AGENT_W "$agent" $branch_w "$branch" $DELTA_W "$delta"
    cells+=$cell
    if (( pr_w )); then
      fit "${f[8]:-}" $pr_w
      printf -v cell '%-*s ' $pr_w "$REPLY"; cells+=$cell
    fi
    printf '%s%-*s\t%s\t%s\n' "$cells" $subject_w "$subject" "$f[6]" "$sess"
  done
}

# ─── View (ctrl-g) ───────────────────────────────────────────────────────────
# Past ten sessions the list is longer than the popup, and the rows that need
# you are not all on screen: the urgency sort puts them first, but the working
# ones still push the tasks and the rest out of sight, and nothing said how many
# were waiting. So the first header line counts the sessions per agent state,
# and ctrl-g toggles between every row and only the sessions that need you —
# blocked, stuck, failed, idle, the same set `prefix+a` cycles through.
#
# Filtered by the producer, not by fzf: fzf's query belongs to the user, and a
# filter written into it would be erased by the first letter typed. The view is
# on-disk state like the scroll offset and the footer, so the poller's reload
# every 2 s keeps it. Per popup: a new popup shows everything, which is also
# what the skeleton can show, since it knows no agent state.
#
# The toggle must not wait for a collection pass (seconds on a large
# repository), so every pass of build_list leaves its rows in WTS_SWITCH_ROWS
# and the toggle re-emits those (--list-cached): the same rows, filtered the
# other way, at once. The next tick brings fresh ones.

NEEDS_STATES=(blocked "stuck?" failed idle)
# The order the counts are spelled in: what needs you first.
COUNT_STATES=(blocked "stuck?" failed idle working done stopped)

# Set by build_list only: the skeleton has no agent state, and filtering it
# would show an empty list until the collector returns.
typeset -g filtering=0

view_needs() { [[ -n "${WTS_SWITCH_VIEW:-}" && -f "$WTS_SWITCH_VIEW" ]] }

view_shows() { # <agent> <kind>
  (( filtering )) && view_needs || return 0
  [[ -z "$2" && -n "${NEEDS_STATES[(r)${(b)1}]:-}" ]]
}

# The counts line, into REPLY: every registered session, the hidden ones
# included, or the line could not say what the other view holds. ASCII only,
# like every display column.
view_line() {
  local raw st n total=0 needs=0
  local -a f parts needs_parts
  local -A count
  for raw in "${rows[@]}"; do
    f=("${(@ps:\x1f:)raw}")
    [[ -z "${f[7]:-}" ]] || continue
    (( total++ ))
    count[$f[2]]=$(( ${count[$f[2]]:-0} + 1 ))
  done
  for st in "${COUNT_STATES[@]}"; do
    n="${count[$st]:-0}"
    (( n )) || continue
    parts+=("$n $st")
    if [[ -n "${NEEDS_STATES[(r)${(b)st}]:-}" ]]; then
      needs_parts+=("$n $st")
      (( needs += n ))
    fi
  done
  local s=s; (( total == 1 )) && s=""
  if (( filtering )) && view_needs; then
    REPLY="needs you: $needs of $total"
    (( needs )) && REPLY+=" (${(j:, :)needs_parts})"
    REPLY+="  ^g all"
  elif (( ${#parts} )); then
    REPLY="$total session$s: ${(j:, :)parts}  ^g needs you"
  else
    # The skeleton: no agent state is known yet, only how many there are.
    REPLY="$total session$s"
  fi
}

view_prompt() {
  if view_needs; then print -rn -- "needs you> "; else print -rn -- "session> "; fi
}

# ctrl-g, through `transform` (fzf 0.45+): toggle, re-emit the cached rows,
# and say which view this is in the prompt as well as in the counts line.
view() { # $1 = verb
  [[ "${1:-}" == toggle && -n "${WTS_SWITCH_VIEW:-}" ]] || return 0
  if view_needs; then rm -f "$WTS_SWITCH_VIEW"; else : > "$WTS_SWITCH_VIEW"; fi
  print -rn -- "reload-sync('$WTS_BIN/wts-switch' --list-cached)+change-prompt($(view_prompt))+first"
}

# ─── Tasks ───────────────────────────────────────────────────────────────────
# The open work, at the bottom of the same list. Not a second
# view and not a nested tree: the switcher is the one place that has to stay
# scannable, and a task is a row like any other — `enter` on it starts a session
# instead of switching to one.
#
# A task a session already serves stays listed, after the ones still to start,
# with the count of its sessions in SUBJECT. It was hidden once, as a duplicate
# of that session's `@` row, and that hid the only way to start a second session
# on it: `enter` on the task row. Only tasks wts already holds — one query on
# its own database, no `wts-things`, no git, no model, because this runs inside
# the 2-second refresh. `ctrl-t` is how a Things
# task gets in.
#
# ASCII only in the display columns: `emit` pads them to an exact character count
# and the smoke test asserts it, but a glyph of East Asian Ambiguous width (U+25C6
# among them) is drawn two columns wide by some terminals — the row would look
# shifted while measuring correctly. The `task` in AGENT is the marker instead.
TASK_TITLE_W=30

task_rows() {
  [[ "${WTS_SWITCH_TASKS:-}" == 0 ]] && return 0
  db_available || return 0
  # Checked before it reaches the LIMIT: the only value in this query that is not
  # a literal comes from the environment, and a non-numeric one would make the
  # whole statement fail — silently, since the query is quiet by design.
  local limit="${WTS_SWITCH_TASKS:-10}"
  [[ "$limit" == <-> ]] || limit=10
  local id title area ctx att live delta subject out row
  local -a f
  # Split rather than `read -d`, which stops this very process under fzf's
  # reload: see db_rows in wts-db.zsh.
  out=$(db_rows "
    SELECT t.id, t.title, t.area,
           (SELECT count(*) FROM task_docs d WHERE d.task = t.id)
             + (SELECT count(*) FROM task_notes n WHERE n.task = t.id)
             + (SELECT count(*) FROM json_each(t.links) WHERE json_valid(t.links)),
           (SELECT count(*) FROM archive a WHERE a.task = t.id),
           (SELECT count(*) FROM task_links l WHERE l.task = t.id) AS live
      FROM tasks t
     WHERE t.status = 'open'
     ORDER BY live > 0, t.synced_at DESC, t.title
     LIMIT $limit" 2>/dev/null)
  for row in "${(@ps:\x1e:)out}"; do
    f=("${(@ps:\x1f:)row}")
    id="${f[1]:-}" title="${f[2]:-}" area="${f[3]:-}" ctx="${f[4]:-0}" att="${f[5]:-0}" live="${f[6]:-0}"
    [[ -n "$id" ]] || continue
    # Cut before add_row, not in `fit`: name_w is measured from the rows, so an
    # 80-character task title would push the name column to its cap and re-lay
    # out every session row the moment a task appeared.
    (( ${#title} > TASK_TITLE_W )) && title="${title[1,TASK_TITLE_W-1]}…"
    # Plain assignments and not `$( … && print … )`: this runs on every refresh,
    # and each command substitution is a fork per row.
    delta="-"
    (( ctx )) && delta="$ctx ctx"
    subject="$area"
    if (( live )); then
      subject="$live session(s)${area:+, $area}"
    elif [[ -z "$subject" ]] && (( att )); then
      subject="$att attempt(s)"
    fi
    add_row "${title:-$id}" "task" "-" "$delta" "$subject" "task:$id" task
  done
}

# tmux sessions missing from the registry (numbered sessions, other projects...).
unregistered() { # <names already listed, one per line>
  local s
  while IFS= read -r s; do
    [[ -n "$s" ]] || continue
    print -r -- "$1" | grep -qxF -- "$s" && continue
    add_row "$s" "-" "-" "" "(not in registry)" "$s" tmux
  done < <(tmux list-sessions -F '#{session_name}' 2>/dev/null)
}

# build_list [--no-git]: the collected list. --no-git is the switcher's first
# fill: agent states in a few tens of ms, the git columns as "-" until the
# poller's first full pass.
build_list() {
  local known=""
  local -a extra
  extra=("$@")
  current=$(tmux display-message -p '#S' 2>/dev/null)

  local since waiting pr repo meta=""
  if [[ -x "$WTS_BIN/wts-status" ]] && command -v jq >/dev/null 2>&1; then
    # \x1f (not whitespace): keeps empty fields, unlike TAB.
    while IFS=$'\x1f' read -r name agent branch delta dirty pane since waiting pr repo subject; do
      [[ -n "$name" ]] || continue
      known+="$name"$'\n'
      add_row "$name" "$agent" "$branch" "$delta" "${subject:-}" "${pane:-$name}" "" "${pr:-}" "${repo:-}"
      meta+="$name"$'\x1f'"$agent"$'\x1f'"${since:-}"$'\x1f'"${waiting:-}"$'\x1e'
    done < <("$WTS_BIN/wts-status" --fzf "${extra[@]}" 2>/dev/null)
  fi
  # Since-when and waiting-for are not list columns: the preview's header reads
  # them from here, the same way the scroll offset travels (see preview).
  if [[ -n "${WTS_SWITCH_META:-}" ]]; then
    print -rn -- "$meta" > "$WTS_SWITCH_META.tmp.$$" 2>/dev/null \
      && mv -f "$WTS_SWITCH_META.tmp.$$" "$WTS_SWITCH_META" 2>/dev/null
  fi

  # Tasks before the foreign tmux sessions: wts's own objects, and the bottom of
  # the list is where you look when nothing needs you.
  task_rows
  unregistered "$known"
  # For ctrl-g, which re-emits these rather than waiting for a pass: see "View".
  # \x1e between rows, which no field carries (wts-status strips it), and the
  # current session first, since emit marks it.
  if [[ -n "${WTS_SWITCH_ROWS:-}" ]]; then
    print -rn -- "$current"$'\x1e'"${(pj:\x1e:)rows}" > "$WTS_SWITCH_ROWS.tmp.$$" 2>/dev/null \
      && mv -f "$WTS_SWITCH_ROWS.tmp.$$" "$WTS_SWITCH_ROWS" 2>/dev/null
  fi
  filtering=1
  emit
}

# The rows of the last pass, emitted again under the current view. A popup that
# has not finished a pass yet collects one, which is what --list would do.
build_cached() {
  if [[ -n "${WTS_SWITCH_ROWS:-}" && -s "$WTS_SWITCH_ROWS" ]]; then
    local -a saved
    saved=("${(@ps:\x1e:)$(<"$WTS_SWITCH_ROWS")}")
    current="${saved[1]}"
    rows=("${(@)saved[2,-1]}")
    filtering=1
    emit
  else
    build_list
  fi
}

# The skeleton: registry and tmux only, no git and no claude call, so it costs
# about 10 ms instead of the collector's 1.6 s on a 95k-file repository. It is
# what fzf gets on stdin, so the popup is drawn before anything is collected and
# `start:reload-sync` swaps in the real list. Until this existed, build_list ran
# to completion first and the popup was an empty frame for 2 s (5 s cold) — the
# whole of what prefix+s felt like.
#
# The volatile columns show "-" rather than a remembered value: an agent state
# one refresh old is a lie the user would act on. The preview already works from
# a skeleton row, because a session name is a valid capture-pane target — the
# same fallback build_list uses when an agent has no pane.
build_skeleton() {
  local known="" name branch subject repo row
  local -a f
  local -A pr_label
  current=$(tmux display-message -p '#S' 2>/dev/null)

  # The PR column from the same query as the collector's (db_pr_labels): it is
  # cached state, not a volatile one, and a column that only appeared at the
  # swap would shift every row.
  if db_available; then
    for row in "${(@ps:\x1e:)$(db_pr_labels)}"; do
      f=("${(@ps:\x1f:)row}")
      [[ -n "${f[1]:-}" ]] && pr_label[${f[1]}]="${f[2]:-}"
    done
  fi

  if db_available && command -v jq >/dev/null 2>&1; then
    # Same SUBJECT rule as wts-status, minus the agent's conversation title,
    # which is unknowable without calling claude: at the swap the text only ever
    # gains a title, it never changes width.
    while IFS=$'\x1f' read -r name branch repo subject; do
      [[ -n "$name" ]] || continue
      known+="$name"$'\n'
      add_row "$name" "-" "${branch:--}" "-" "$subject" "$name" "" "${pr_label[$name]:-}" "$repo"
    done < <(jq -r 'to_entries | sort_by(.key)[]
      | [ .key,
          (.value.branch // "-"),
          (.value.repo_root // ""),
          ([.value.prompt, .value.context]
            | map(select(type == "string" and . != "")) | (.[0] // "")
            | gsub("[\\t\\n\\r]"; " ")
            | if length > 50 then .[0:49] + "…" else . end) ]
      | join("")' <<< "$(registry_json)" 2>/dev/null)
  fi

  # The same query as build_list, and not a cheaper one: the two lists are
  # compared column by column at the swap, so a task missing here would redraw
  # every row shifted the moment the collector returned.
  task_rows
  unregistered "$known"
  emit
}

# ─── Preview and scroll ──────────────────────────────────────────────────────
# The scroll offset cannot live inside fzf: the poller below pushes
# `refresh-preview` every 2 s, and fzf then recomputes the offset from
# --preview-window. Without a scroll spec it is 0, so a native
# `preview-page-up` would be undone within two seconds.
#
# So it lives outside fzf: the offset is on-disk state that the preview command
# reads itself to slice its capture. Scrolling becomes part of what is shown,
# not of how fzf shows it, so it survives `refresh-preview` untouched and it
# covers the real tmux history.
#
# Trade-off: ctrl-f and ctrl-b were `forward-char` and `backward-char` in the
# fzf query. The arrow keys remain, and queries are short here.

# State: <target> then <offset in lines from the bottom>. Changing target resets
# the offset to the default, so moving the cursor in the list brings the preview
# back to live without binding the `focus` event.
#
# The default is 0 — the bottom — for a pane, where the last line the agent wrote
# is the one that matters. A task reads the other way round (its title and status
# are at the top), so its preview passes the top as the default; `scroll` does not
# need to know, because `preview` clamps and writes the offset back before any
# key can be pressed on that row.
read_scroll() { # $1 = target, $2 = default offset ; prints the offset
  local target="$1" def="${2:-0}" stored_target stored_off
  [[ -n "${WTS_SWITCH_SCROLL:-}" && -f "$WTS_SWITCH_SCROLL" ]] || { print -r -- "$def"; return }
  { read -r stored_target; read -r stored_off } < "$WTS_SWITCH_SCROLL"
  [[ "$stored_target" == "$target" ]] || { print -r -- "$def"; return }
  print -r -- "${stored_off:-0}"
}

write_scroll() { # $1 = target, $2 = offset
  [[ -n "${WTS_SWITCH_SCROLL:-}" ]] || return
  print -rl -- "$1" "$2" > "$WTS_SWITCH_SCROLL"
}

# ─── Footer ──────────────────────────────────────────────────────────────────
# The keys are printed under the list, because nobody opens the README to
# remember `ctrl-x`: one line by default, the whole table (tmux bindings
# included) on `?`. Both come from wts-keys, the one place they are written, so
# the footer and `wts keys` cannot drift apart.
#
# fzf grew --footer in 0.65, and an unknown action makes fzf exit at once —
# in a popup, a frame that closes without a word. So everything here is gated
# on WTS_SWITCH_FOOTER, exported only when the installed fzf has the footer:
# the verbs below run in their own process, where the version is not known.
#
# Expanded or collapsed is on-disk state, like the scroll offset and the reply
# target: fzf has no variable of its own to hold it, and the poller's
# `reload-sync` every 2 s must not reset it.

footer_active() { [[ "${WTS_SWITCH_FOOTER:-}" == 1 ]] }

help_expanded() { [[ -n "${WTS_SWITCH_HELP:-}" && -f "$WTS_SWITCH_HELP" ]] }

footer_text() {
  local mode=collapsed
  if reply_active; then
    # `enter` appends to a task and sends to an agent: the footer has to say
    # which, or the one destructive-feeling key in the popup is a guess.
    if reply_new_task; then mode=newtask
    elif reply_on_task; then mode=note
    else mode=reply; fi
  elif help_expanded; then
    mode=expanded
  fi
  "$WTS_BIN/wts-keys" --footer "$mode" 2>/dev/null
}

# The action that repaints the footer, or nothing at all on an fzf without one.
# `|` as the delimiter, as for change-prompt: a `)` in the text would close the
# action early, and the text never contains a `|`.
footer_action() {
  footer_active || return 0
  print -rn -- "change-footer|$(footer_text)|"
}

# `?` toggles the full list. While the list is being filtered the query wins:
# `?` is a printable character, and the AGENT column has `stuck?` in it.
keys() { # $1 = verb, $2 = query
  [[ "$1" == "toggle" ]] || return 0
  if [[ -n "${2:-}" ]]; then
    print -r -- "put(?)"
    return
  fi
  if help_expanded; then rm -f "$WTS_SWITCH_HELP"; else : > "$WTS_SWITCH_HELP"; fi
  footer_action
}

# ─── Reply mode ──────────────────────────────────────────────────────────────
# The preview is a capture, not a terminal: there is no cursor to put in it. So
# answering an agent from the popup works the other way round: `tab` turns the
# query line into an input for the previewed session, `enter` pushes it with
# `send-keys`, and the poller's refresh shows the agent's reaction in place.
#
# The mode is pinned to one session, recorded on disk like the scroll offset:
# the poller re-sorts the list by urgency every 2 s, and a cursor kept by index
# would silently retarget the reply. A wrong `enter` in list mode only switches
# to the wrong session; a wrong reply types into the wrong agent's prompt.
#
# The same machinery carries a NOTE on a task. A task row has no pane to type
# into, but the thing that was missing was never the pane: it was a place to type
# prose without leaving the popup, which this already is. So `tab` on a task
# pins the task, and `enter` appends the line to its notes instead of sending it
# to an agent — which is how the context an author keeps in a task gets there.
#
# State: <pinned key> then <target at entry>. The key is a session name, or
# `task:<id>` for a note: a task has no session name to anchor on (field 3 of its
# row is empty, deliberately), and the id is what both the preview and the write
# need. The target is a fallback for when the cursor has drifted off that row.

# The keys reply mode turns off, in ONE place: they used to be two identical
# string literals in toggle and leave, and a key added to one only was left
# unbound for the rest of the popup.
# ctrl-g too: a reload under a pinned reply is harmless, but its change-prompt
# would overwrite the "reply to" one.
REPLY_UNBIND="ctrl-d,ctrl-x,ctrl-e,ctrl-t,ctrl-g"

reply_active() { [[ -n "${WTS_SWITCH_REPLY:-}" && -f "$WTS_SWITCH_REPLY" ]] }

read_reply() { # sets reply_name and reply_target in the caller's scope
  { read -r reply_name; read -r reply_target } < "$WTS_SWITCH_REPLY"
}

# Whether what is pinned is a task rather than a session, for the footer and for
# `send`. Cheap enough to ask twice; it is one read of a two-line file.
reply_on_task() {
  reply_active || return 1
  local reply_name reply_target
  read_reply
  [[ "$reply_name" == task:* ]]
}

# Whether ctrl-t's "new task" mode is what is pinned. Its key is `newtask:`,
# which neither a session name (tmux refuses a colon in one) nor `task:*` can be.
reply_new_task() {
  reply_active || return 1
  local reply_name reply_target
  read_reply
  [[ "$reply_name" == newtask: ]]
}

# What the prompt calls the pinned task. Short: the prompt sits in front of the
# query on one line.
task_label() { # $1 = task id
  local t
  t=$(db_ro "SELECT title FROM tasks WHERE id = $(sql_str "$1")" 2>/dev/null)
  t="${t//[[:cntrl:]]/ }"
  (( ${#t} > 28 )) && t="${t[1,27]}…"
  print -r -- "${t:-$1}"
}

# Free text onto the task, dated, through the same table `wts task note` writes.
# Written here rather than by execing wts-task: this runs inside fzf's
# `transform`, whose output IS an action chain — a helper printing "→ noted on …"
# on stdout would be read by fzf as an unknown action and close the popup.
note_task() { # $1 = task id, $2 = text
  local id="$1" text="$2"
  [[ -n "$id" && -n "${text//[[:space:]]/}" ]] || return 0
  db_q "INSERT INTO task_notes (task, body, added_at)
        VALUES ($(sql_str "$id"), $(sql_str "$text"),
                strftime('%Y-%m-%dT%H:%M:%SZ', 'now'))" >/dev/null 2>&1
}

# Where a preview, a scroll or a reply goes. The cursor's own target wins as
# long as the cursor is still on the pinned session: a row that was a skeleton
# at entry (bare session name) gains its agent pane on the next reload, and
# the reply should follow it.
resolve_target() { # $1 = cursor target, $2 = cursor name
  if reply_active; then
    local reply_name reply_target
    read_reply
    # A title being typed is pinned to nothing: the preview follows the cursor.
    if [[ "$reply_name" == newtask: ]]; then
      print -r -- "${1:-}"
      return
    fi
    if [[ "${2:-}" != "$reply_name" || -z "${1:-}" ]]; then
      print -r -- "$reply_target"
      return
    fi
  fi
  print -r -- "${1:-}"
}

# A pane target (session:@window.%pane) is already exact. A bare session name
# needs `=`, or `fix-login` would send into `fix-login-2` — and the trailing
# `:`: pane commands (send-keys, capture-pane) resolve `=name:` to the active
# pane but answer "can't find pane" to a plain `=name` (tmux 3.7).
tmux_target() { # $1 = target
  [[ "$1" == *%* ]] && print -r -- "$1" || print -r -- "=$1:"
}

# Status 1, and nothing typed, when the target is a bare session name whose
# agent pane wts does not know: `=name:` is the session's ACTIVE pane, the
# editor of the default layout, and a reply typed there plus Enter went into
# the user's buffer. The agent's pane comes from its own hooks or the collector.
send_reply() { # $1 = target, $2 = text
  local t="$1"
  if [[ "$t" != *%* ]]; then
    t=$(agent_pane_of "${t#=}") || return 1
  fi
  t=$(tmux_target "$t")
  [[ -n "$2" ]] && tmux send-keys -t "$t" -l -- "$2" 2>/dev/null
  # Text and newline in one read look like a multi-line paste to Claude Code,
  # which then inserts the newline instead of submitting.
  sleep 0.1
  tmux send-keys -t "$t" Enter 2>/dev/null
}

# Each verb prints an fzf action chain for `transform`, the only way fzf offers
# to make a key conditional: `enter` must keep switching outside reply mode.
# Placeholders in the output would be expanded by fzf, so none appear here.
reply() { # $1 = verb, then verb arguments
  local verb="$1"; shift
  # Chains are joined from an array and the footer action is added with
  # `${footer:+...}`: an fzf without a footer is handed no `change-footer`
  # rather than an action it would exit on.
  local footer=""
  local -a chain
  case "$verb" in
    toggle) # <target> <name>
      if reply_active; then reply leave; return; fi
      # A session anchors on its name; a task row has none (field 3 is empty by
      # design) and anchors on its `task:<id>` target instead. Anything else —
      # the header, an empty list — still pins nothing.
      local key="${2:-}" label="${2:-}"
      if [[ -z "$key" && "${1:-}" == task:* ]]; then
        key="$1"
        label=$(task_label "${1#task:}")
      fi
      [[ -n "$key" ]] || return
      print -rl -- "$key" "${1:-$key}" > "$WTS_SWITCH_REPLY"
      # Read after the state file is written: the footer is the reply line, and
      # it says "append" rather than "send" when what is pinned is a task.
      footer=$(footer_action)
      # `?` goes with ctrl-d and ctrl-x: unbound, it is typed into the reply
      # instead of opening the key list, which is what a reply needs it for.
      local switched="$REPLY_UNBIND"
      footer_active && switched="$switched,?"
      # `|` as the argument delimiter: `)` is legal in a tmux session name.
      local verbing="reply to"
      [[ "$key" == task:* ]] && verbing="note on"
      chain=(disable-search clear-query "unbind($switched)" refresh-preview
             ${footer:+"$footer"} "change-prompt|$verbing ${label//|/}> |")
      print -rn -- "${(j:+:)chain}"
      ;;
    new) # ctrl-t: the query becomes the title of a task to create
      if reply_active; then reply leave; return; fi
      print -rl -- "newtask:" "" > "$WTS_SWITCH_REPLY"
      footer=$(footer_action)
      local switched="$REPLY_UNBIND"
      footer_active && switched="$switched,?"
      chain=(disable-search clear-query "unbind($switched)" refresh-preview
             ${footer:+"$footer"} "change-prompt(new task> )")
      print -rn -- "${(j:+:)chain}"
      ;;
    leave)
      rm -f "$WTS_SWITCH_REPLY"
      local switched="$REPLY_UNBIND"
      footer_active && switched="$switched,?"
      # After the reply file is gone, so the footer is the list's again.
      footer=$(footer_action)
      chain=(enable-search clear-query "rebind($switched)" "change-prompt($(view_prompt))"
             refresh-preview ${footer:+"$footer"})
      print -rn -- "${(j:+:)chain}"
      ;;
    esc)
      if reply_active; then reply leave; else print -r -- "abort"; fi
      ;;
    send) # <query> <cursor target> <cursor name>
      if ! reply_active; then print -r -- "accept"; return; fi
      local reply_name reply_target
      read_reply
      if [[ "$reply_name" == newtask: ]]; then
        new_task_chain "${1:-}"
        return
      fi
      if [[ "$reply_name" == task:* ]]; then
        note_task "${reply_name#task:}" "${1:-}"
        # reload-sync as well: the row's `N ctx` count just changed, and
        # reload-sync keeps the cursor and the query where they are.
        print -r -- "clear-query+reload-sync('$WTS_BIN/wts-switch' --list)+refresh-preview"
        return
      fi
      if send_reply "$(resolve_target "${2:-}" "${3:-}")" "${1:-}"; then
        print -r -- "clear-query+refresh-preview"
      else
        # The text stays in the query: nothing was sent, nothing is lost.
        print -r -- "change-prompt(no agent pane known — not sent> )"
      fi
      ;;
  esac
}

# ─── New task (ctrl-t) ───────────────────────────────────────────────────────
# A task used to be created only from a terminal (`wts task new`), and the popup
# could only pull one in from Things — where Things can be read at all. So the
# work you think of while looking at the list had to wait until you left it.
# ctrl-t now pins a "new task" mode on the reply machinery: the query is the
# title, `enter` creates the task and puts the cursor on it, ready for `tab`
# (note), ctrl-e (document) or `enter` (start). An empty title is how the Things
# picker is still reached, where there is one.
#
# The cursor cannot be placed from this chain: `pos()` after `reload-sync` runs
# at once, on the OLD list — measured on fzf 0.74, `pos(8)` on a list of 3 being
# reloaded to 10 lands on 3. So the id goes to $WTS_SWITCH_FOCUS and the chain
# rebinds `load`, whose handler (--loaded) moves the cursor once the reloaded
# list is on screen.
new_task_chain() { # $1 = title
  setopt local_options extended_glob
  local title="$1" id="" self="$WTS_BIN/wts-switch"
  # Trimmed: a title typed with a trailing space would show in every listing.
  title="${title##[[:space:]]##}"
  title="${title%%[[:space:]]##}"
  if [[ -z "$title" ]]; then
    # Non-empty and not just `1`: `maybe` means Things was never probed, and a
    # key the user pressed is exactly the right place to find out — the picker
    # says why if there is nothing to pick from, and the answer is cached.
    if [[ -n "${WTS_SWITCH_THINGS:-}" ]]; then
      print -rn -- "$(reply leave)+execute('$self' --things)+reload('$self' --list)"
    else
      reply leave
    fi
    return
  fi
  if [[ -x "$WTS_BIN/wts-task" ]]; then
    id=$("$WTS_BIN/wts-task" new "$title" 2>/dev/null) || id=""
  fi
  # The new task has to be on screen for the cursor to land on it, and the
  # "needs you" view shows no task: back to every row, before `reply leave`
  # words the prompt.
  view_needs && rm -f "$WTS_SWITCH_VIEW"
  local -a chain
  chain=("$(reply leave)")
  if [[ "$id" == local:* && -n "${WTS_SWITCH_FOCUS:-}" ]]; then
    print -r -- "$id" > "$WTS_SWITCH_FOCUS"
    chain+=("rebind(load)")
  fi
  chain+=("reload-sync('$self' --list)")
  print -rn -- "${(j:+:)chain}"
}

# The row a task lands on, as fzf's `pos` counts it: 1-based, the two header
# lines excluded.
# Read from the skeleton — one query, no git — which lists the same rows in the
# same places as the collected list (the swap at startup depends on it), so the
# index holds for the list fzf has just loaded.
task_position() { # $1 = task id
  local line n=0
  while IFS= read -r line; do
    (( n++ ))
    if [[ "${${line#*$'\t'}%%$'\t'*}" == "task:$1" ]]; then
      print -r -- $(( n - 2 ))
      return 0
    fi
  done < <(build_skeleton)
  return 1
}

# `load`: the first time, the startup reload (see "Start from the skeleton");
# after a ctrl-t, the cursor onto the task it created. Unbound either way, so
# the poller's reloads every 2 s never pay for this.
loaded() { # [--no-git]
  local self="$WTS_BIN/wts-switch" id n
  local -a chain
  chain=("unbind(load)")
  if [[ -n "${WTS_SWITCH_FOCUS:-}" && -s "$WTS_SWITCH_FOCUS" ]]; then
    id=$(<"$WTS_SWITCH_FOCUS")
    rm -f "$WTS_SWITCH_FOCUS"
    n=$(task_position "$id") && chain+=("pos($n)")
  else
    chain+=("reload-sync('$self' --list${1:+ $1})")
  fi
  print -rn -- "${(j:+:)chain}"
}

# The sessions started from a task: the live ones with their agent's state,
# then the finished ones through task_attempts_md (outcome, PR, retrospective),
# newest first. The list row only said "2 session(s)", and finding out which
# meant leaving the popup for `wts task show`. The live part is not in
# task_context_md: that one is also the agent's context, where a live state
# would be stale the moment it was written.
TASK_PREVIEW_ARCHIVED=3

task_sessions_md() { # $1 = task id
  db_available || return 0
  local out name head
  local -i n=0
  # Split rather than `read -d`, which stops this very process under fzf's
  # preview: see db_rows in wts-db.zsh.
  out=$(db_rows "
    SELECT s.name FROM task_links l JOIN sessions s ON s.name = l.session
     WHERE l.task = $(sql_str "$1") ORDER BY s.name" 2>/dev/null)
  for name in "${(@ps:\x1e:)out}"; do
    [[ -n "$name" ]] || continue
    (( n++ == 0 )) && { print -r -- "Sessions on it now:"; print -r -- "" }
    head=$(preview_header "$name") || head="live"
    print -r -- "- $name  $head"
  done
  (( n )) && print -r -- ""
  local attempts
  attempts=$(task_attempts_md "$1" "$TASK_PREVIEW_ARCHIVED" 2>/dev/null) || attempts=""
  if [[ -n "$attempts" ]]; then
    print -r -- "$attempts"
  elif (( n == 0 )); then
    print -r -- "Sessions started from it: none yet, enter starts one."
  fi
  return 0
}

# A task has no pane to capture, so the preview is what the task carries: the
# same block wts writes into a new session's context file, from the same
# renderer, plus the sessions started from it and what `enter` will do with it.
# Reading the task here is the payoff of the whole feature — the popup becomes
# where you check whether a piece of work is ready to start.
task_preview() { # $1 = task id
  local md
  md=$(task_context_md "$1" 0 0 2>/dev/null) || md=""
  if [[ -z "$md" ]]; then
    print -r -- "(task $1 is unknown here)"
    return
  fi
  # Right under the header (title, status, area), above the notes: a long note
  # would otherwise push the sessions below the fold of a task that opens on
  # its first line.
  local head="${md%%$'\n\n'*}" rest=""
  [[ "$md" == *$'\n\n'* ]] && rest="${md#*$'\n\n'}"
  print -r -- "$head"
  print -r -- ""
  task_sessions_md "$1"
  print -r -- ""
  [[ -n "$rest" ]] && print -r -- "$rest"
  print -r -- "enter: attach it to a session, or start one from a prompt or a branch name."
  print -r -- "tab notes on it, ctrl-e attaches a document."
}

# "4m", "1h12m", "2d": how long an agent has been in its state.
age_of() { # <epoch>
  local s=$(( ${EPOCHSECONDS:-$(date +%s)} - $1 ))
  (( s < 0 )) && s=0
  if (( s < 60 )); then print -r -- "${s}s"
  elif (( s < 3600 )); then print -r -- "$(( s / 60 ))m"
  elif (( s < 86400 )); then print -r -- "$(( s / 3600 ))h$(( (s % 3600) / 60 ))m"
  else print -r -- "$(( s / 86400 ))d"
  fi
}

# The line above a session's pane capture: its state, for how long, and what
# it waits for ("blocked 4m: Bash: rm -rf dist"). Read from the file --list
# writes, so the preview costs no collector call of its own.
preview_header() { # <session name>
  local name="$1" row state since waiting
  [[ -n "$name" && -n "${WTS_SWITCH_META:-}" && -s "$WTS_SWITCH_META" ]] || return 1
  local -a f
  for row in "${(@ps:\x1e:)$(<"$WTS_SWITCH_META")}"; do
    f=("${(@ps:\x1f:)row}")
    [[ "${f[1]:-}" == "$name" ]] || continue
    state="${f[2]:-}" since="${f[3]:-}" waiting="${f[4]:-}"
    [[ -n "$state" && "$state" != - && "$state" != stopped ]] || return 1
    local head="$state"
    [[ "$since" == <-> ]] && head+=" $(age_of "$since")"
    [[ -n "$waiting" ]] && head+=": $waiting"
    print -r -- "$head"
    return 0
  done
  return 1
}

# The pull request under the state line: number, state, checks and review as
# wts-pr last cached them, with their age — or, once the branch landed, that it
# did and what ctrl-d does about it. The list only has room for `#42 ✗ci`; this
# is where it is spelled out. A database read, never gh.
preview_pr() { # <session name>
  local name="$1" out
  local -a f
  [[ -n "$name" ]] && db_available || return 1
  out=$(db_rows "SELECT coalesce(p.number, ''), coalesce(p.state, ''), coalesce(p.review, ''),
                        coalesce(p.checks, ''), coalesce(p.fetched_at, 0),
                        coalesce(p.error, ''), coalesce(m.merged, '')
                   FROM sessions s
                   LEFT JOIN pr_state p ON p.session = s.name
                   LEFT JOIN merge_checks m ON m.session = s.name
                  WHERE s.name = $(sql_str "$name")" 2>/dev/null)
  f=("${(@ps:\x1f:)${out%$'\x1e'}}")
  local num="${f[1]:-}" st="${f[2]:-}" review="${f[3]:-}" checks="${f[4]:-}"
  local at="${f[5]:-0}" err="${f[6]:-}" landed="${f[7]:-}" line
  if [[ -n "$landed" || "$st" == merged ]]; then
    line="merged${num:+ #$num}${${landed:#merged}:+ ($landed)} · ctrl-d to remove"
    print -r -- $'\e[32m'"$line"$'\e[0m'
    return 0
  fi
  if [[ -n "$num" ]]; then
    line="PR #$num $st"
    case "$checks" in
      fail)    line+=" · checks failing" ;;
      pending) line+=" · checks running" ;;
      pass)    line+=" · checks pass" ;;
    esac
    case "$review" in
      approved)          line+=" · approved" ;;
      changes_requested) line+=" · changes requested" ;;
      review_required)   line+=" · review required" ;;
    esac
    [[ "$at" == <-> ]] && (( at > 0 )) && line+=" ($(age_of "$at") ago)"
  elif [[ -n "$err" ]]; then
    line="PR: ${err//[[:cntrl:]]/ }"
  else
    return 1
  fi
  (( ${#line} > ${FZF_PREVIEW_COLUMNS:-80} )) && line="${line[1,${FZF_PREVIEW_COLUMNS:-80}-1]}…"
  print -r -- $'\e[2m'"$line"$'\e[0m'
}

# What the session already said about itself, under the state line: the cached
# `done:` / `next:` of `wts brief` and the last two notes its agent left with
# `wts db set`. Both were written at every brief and every note and read by no
# switcher code, so finding out meant leaving the popup. The cache only, never
# a model call (CLAUDE.md): a brief that is a day old says so with its age.
# One database read per refresh, no git.
preview_memo() { # <session name>
  local name="$1" out row line age
  local -a f lines
  local -i width=${FZF_PREVIEW_COLUMNS:-80} first
  [[ -n "$name" ]] && db_available || return 1
  out=$(db_rows "
    SELECT 'brief', '', body, updated_at FROM briefs WHERE session = $(sql_str "$name")
    UNION ALL
    SELECT * FROM (SELECT 'note', key, value,
                          CAST(strftime('%s', updated_at) AS INTEGER)
                     FROM notes WHERE session = $(sql_str "$name")
                    ORDER BY updated_at DESC LIMIT 2)" 2>/dev/null)
  [[ -n "$out" ]] || return 1
  for row in "${(@ps:\x1e:)out}"; do
    f=("${(@ps:\x1f:)row}")
    [[ -n "${f[3]:-}" ]] || continue
    age=""
    [[ "${f[4]:-}" == <-> ]] && age=" ($(age_of "${f[4]}"))"
    if [[ "${f[1]}" == brief ]]; then
      # The body is the two lines `done: …` and `next: …`; the age goes on the
      # first, as for a note.
      first=1
      for line in "${(@f)f[3]}"; do
        [[ -n "$line" ]] || continue
        (( first )) && { line+="$age"; first=0 }
        lines+=("$line")
      done
    else
      lines+=("note ${f[2]}$age: ${f[3]//[[:cntrl:]]/ }")
    fi
  done
  (( ${#lines} )) || return 1
  for line in "${lines[@]}"; do
    (( ${#line} > width )) && line="${line[1,width-1]}…"
    # Dim: these are memos about the pane, and the pane is what the eye is for.
    print -r -- $'\e[2m'"$line"$'\e[0m'
  done
}

preview() { # $1 = cursor target, $2 = cursor name
  local target capture header="" prline="" memo=""
  target=$(resolve_target "${1:-}" "${2:-}")
  if [[ "$target" == task:* ]]; then
    capture=$(task_preview "${target#task:}")
  else
    # tmux_target: a bare `0` is read as a window of the current session first.
    capture=$(tmux capture-pane -p -e -S "-$SCROLLBACK" -t "${target:+$(tmux_target "$target")}" 2>/dev/null)
    header=$(preview_header "${2:-}") || header=""
    prline=$(preview_pr "${2:-}") || prline=""
    memo=$(preview_memo "${2:-}") || memo=""
  fi
  # The header takes the first line and is never scrolled away: it is printed
  # before the window sliced below, which is one line shorter for it — and
  # before the empty-capture guard, since the state is known whether or not
  # the pane has drawn anything yet.
  local height="${FZF_PREVIEW_LINES:-20}"
  if [[ -n "$header" ]]; then
    print -r -- "$header"
    (( height-- ))
  fi
  if [[ -n "$prline" ]]; then
    print -r -- "$prline"
    (( height-- ))
  fi
  # Pinned like the header, and only while the pane keeps most of the window:
  # on a short popup the agent's last lines matter more than its memos.
  if [[ -n "$memo" ]]; then
    local -a memo_lines=("${(@f)memo}")
    # The width a plain variable and the operand an explicit empty string: a
    # `${…}` inside the (l::) flag is a "bad substitution", and no operand at
    # all is "parameter not set" under set -u. Either ended the preview right
    # here, before the pane.
    local -i rule_w=${FZF_PREVIEW_COLUMNS:-80}
    if (( height - ${#memo_lines} - 1 >= 8 )); then
      print -r -- "$memo"
      print -r -- $'\e[2m'"${(l:rule_w::-:)${:-}}"$'\e[0m'
      (( height -= ${#memo_lines} + 1 ))
    fi
  fi
  (( height < 1 )) && height=1
  [[ -n "$capture" ]] || { print -r -- "(no preview)"; return }

  # Command substitution already ate the trailing empty lines: the bottom of
  # the capture is the last line the agent wrote, and offset 0 pins the
  # preview to live.
  local -a lines=("${(@f)capture}")

  # Only --preview knows how many lines were actually captured: it clamps the
  # offset and writes it back, so --scroll can count blindly.
  local max=$(( $#lines - height ))
  (( max < 0 )) && max=0
  # A task opens on its first line, a pane on its last: see read_scroll.
  local off
  if [[ "$target" == task:* ]]; then
    off=$(read_scroll "$target" "$max")
  else
    off=$(read_scroll "$target")
  fi
  (( off > max )) && off=$max
  (( off < 0 )) && off=0
  write_scroll "$target" "$off"

  local end=$(( $#lines - off ))
  local start=$(( end - height + 1 ))
  (( start < 1 )) && start=1
  print -rl -- "${lines[@]:$((start - 1)):$((end - start + 1))}"
}

scroll() { # $1 = cursor target, $2 = cursor name, $3 = up|down
  local target dir="$3"
  target=$(resolve_target "${1:-}" "${2:-}")
  # Half a page sized on the real window height: fzf exports
  # FZF_PREVIEW_LINES to `execute*` as well as to preview commands.
  local step=$(( ${FZF_PREVIEW_LINES:-20} / 2 ))
  (( step < 1 )) && step=1
  local off=$(read_scroll "$target")
  case "$dir" in
    up)   (( off += step )) ;;
    down) (( off -= step )) ;;
  esac
  (( off < 0 )) && off=0
  write_scroll "$target" "$off"
}

# ─── Preview width ───────────────────────────────────────────────────────────
# The preview is a raw capture-pane: text at the PANE's width, whatever the
# window's. With the editor as main pane (main-vertical at 75%), the agent's
# pane is 56 columns on a 223-column terminal and a 60% window was 110: half
# of it blank, while the list had 76 columns for the 130 it needs to show
# SUBJECT in full. So the window is fitted to the pane of the highlighted row,
# on the `focus` event: as wide as the pane, never wider than the half of the
# popup it starts with. The list is laid out for the other half (WTS_SWITCH_COLS
# below), so a window that grew past it would cut every row: a pane wider than
# half the popup is truncated on the right instead.
#
# An absolute --preview-window size counts content columns and the border comes
# on top (`right,57,border-left` gives FZF_PREVIEW_COLUMNS=57, measured on fzf
# 0.74), so pane_width maps one to one. fzf does not re-run the preview command
# on that resize, and it does not have to: the output only depends on
# FZF_PREVIEW_LINES, which a window on the right never changes.
fit_preview() { # $1 = cursor target, $2 = cursor name ; prints the action, or nothing
  local target width cols="${FZF_COLUMNS:-}"
  # In reply mode the preview shows the pinned session, so the window follows
  # that pane rather than the row the cursor drifted to.
  target=$(resolve_target "${1:-}" "${2:-}")
  # A task has no pane: leave the window where the last session put it rather
  # than asking tmux about a target it cannot resolve.
  [[ "$target" == task:* ]] && return 0
  width=$(tmux display-message -p -t "${target:+$(tmux_target "$target")}" '#{pane_width}' 2>/dev/null)
  # A gone pane, or a fzf without FZF_COLUMNS: leave the window as it is.
  [[ "$width" == <-> && "$cols" == <-> ]] || return 0
  if (( width < cols / 2 )); then
    print -r -- "change-preview-window(right,$width,border-left)"
  else
    print -r -- "change-preview-window(right,$(( cols / 2 )),border-left)"
  fi
}

# ─── Stop ────────────────────────────────────────────────────────────────────
# ctrl-x: `wts stop` on the selected row, after a y/N prompt. "Stop" in every
# word the user reads — the prompt, the footer, the CLI — where the popup used to
# say "kill" and the CLI "stop" for the same thing. Runs under fzf's
# `execute`, which talks to /dev/tty directly, so the prompt reads the keyboard
# with no redirection. fzf redraws the instant the command exits: a message
# that is not followed by a key wait is never seen.
# A key press, after draining what the terminal already sent: replies to the
# queries fzf and tmux make (cursor position, keyboard protocol) land on the
# same tty, and a bare `read -k1` took one of them for the key, so the message
# was gone before anyone read it.
wait_key() {
  local junk
  sleep 0.1
  while read -t 0 -k1 -s junk 2>/dev/null; do :; done
  read -k1 -s junk
}

stop_session() { # $1 = session name, $2 = display line (its 2nd word is AGENT)
  local name="$1" line="${2:-}" cur agent=""
  [[ -n "$name" ]] || return 0   # `execute` also fires on an empty list

  # fzf hands over its alternate screen with the cursor wherever it was: clear
  # it, so the prompt is at the top and not in the middle of a blank popup.
  print -n '\e[2J\e[H'

  # Same call as the " *" marker, so this agrees with what the user sees. Done
  # here and not left to `wts stop`: nobody should be asked y/N for a refusal.
  cur=$(tmux display-message -p '#S' 2>/dev/null)
  if [[ "$name" == "$cur" ]]; then
    print -r -- "wts: '$name' is the current session, not stopped (switch away first) — any key"
    wait_key
    return 0
  fi

  # The AGENT column, unless the row does not carry one: an unregistered tmux
  # session may have blanks in its name, which shifts every word.
  local -a cols=(${=line})
  case "${cols[2]:-}" in
    blocked|working|idle|done|failed|stopped|stuck\?|-) agent="${cols[2]}" ;;
  esac

  if ! read -q "?Stop session '$name'${agent:+ (agent: $agent)}? Its tmux session closes; worktree and registry are kept. [y/N] "; then
    print
    return 0
  fi
  print
  if [[ -z "$WTS_CMD" ]]; then
    print -r -- "wts: wts not found next to this helper nor in PATH — any key"
    wait_key
    return 0
  fi
  # The CLI's own output is the message; the pause makes a failure readable.
  "$WTS_CMD" stop "$name" || { print -n "press any key"; wait_key }
  return 0
}

# ─── Pull request ────────────────────────────────────────────────────────────
# ctrl-o: `wts pr` on the selected row, under `execute` like ctrl-x. Only a
# failure (no PR for the branch, unregistered session, gh not logged in) waits
# for a key: on success the browser has the focus and the list comes back.
open_pr() { # $1 = session name
  local name="$1"
  [[ -n "$name" ]] || return 0   # `execute` also fires on an empty list
  print -n '\e[2J\e[H'
  if [[ -z "$WTS_CMD" ]]; then
    print -r -- "wts: wts not found next to this helper nor in PATH — any key"
    wait_key
    return 0
  fi
  "$WTS_CMD" pr "$name" || { print -n "press any key"; wait_key }
  return 0
}

# ─── Remove ──────────────────────────────────────────────────────────────────
# ctrl-d used to be `execute(wts rm {3})` straight from the bind. It cannot be:
# on a task row {3} is empty, and `wts rm ''` reaches registry_resolve_name,
# whose substring match (`[[ "$k" == *""* ]]`) matches EVERY session and opens a
# picker offering to delete any of them. The header row already produced an empty
# {3}, but --header-lines makes it unselectable; a task row is selectable.
# So the guard every other verb has, in the same shape.
#
# On a task row it now does something after all, through the target in {2}
# rather than the empty name: it closes the task (wts task done), which is the
# only way out of the list a local task has. The name stays the only thing that
# can reach `wts rm`.
remove_session() { # $1 = session name, $2 = preview target, $3 = display line
  local name="$1" target="${2:-}" line="${3:-}" cur agent=""
  if [[ -z "$name" ]]; then
    [[ "$target" == task:* ]] && close_task "${target#task:}"
    return 0   # otherwise the header, or an empty list
  fi
  print -n '\e[2J\e[H'
  if [[ -z "$WTS_CMD" ]]; then
    print -r -- "wts: wts not found next to this helper nor in PATH — any key"
    wait_key
    return 0
  fi
  # Same guard as stop_session: nobody should be asked y/N for a refusal.
  cur=$(tmux display-message -p '#S' 2>/dev/null)
  if [[ "$name" == "$cur" ]]; then
    print -r -- "wts: '$name' is the current session, not removed (switch away first) — any key"
    wait_key
    return 0
  fi
  # A y/N, as ctrl-x has — and this key does more: the worktree, the branch and
  # the registry entry go too. The list re-sorts under the cursor every 2 s (it
  # is kept by index), so the row this fires on is not always the row aimed at;
  # the prompt names it, with its agent state, before anything is touched.
  local -a cols=(${=line})
  case "${cols[2]:-}" in
    blocked|working|idle|done|failed|stopped|stuck\?|-) agent="${cols[2]}" ;;
  esac
  # Merged is worth saying here: it is the one case where the answer is
  # obviously yes, and `wts rm` deletes a squash-merged branch without -f.
  local landed
  landed=$(db_ro "SELECT 1 FROM sessions s
                    LEFT JOIN pr_state p ON p.session = s.name
                    LEFT JOIN merge_checks m ON m.session = s.name
                   WHERE s.name = $(sql_str "$name")
                     AND (m.merged != '' OR p.state = 'merged')" 2>/dev/null)
  local about="${agent:+agent: $agent}"
  [[ "$landed" == 1 ]] && about+="${about:+, }merged"
  if ! read -q "?Remove session '$name'${about:+ ($about)}? Worktree, branch and registry entry go too. [y/N] "; then
    print
    return 0
  fi
  print
  "$WTS_CMD" rm "$name" || { print -n "press any key"; wait_key }
  return 0
}

# ctrl-d on a task. A Things task is only explained, not closed: it is completed
# in Things, and `wts task done` would refuse it anyway — asking y/N first for a
# refusal is what stop_session avoids too. The source is read here for that
# reason, from wts's own database; Things itself is not opened.
close_task() { # $1 = task id
  local id="$1" src title
  [[ -n "$id" ]] || return 0
  print -n '\e[2J\e[H'
  if [[ -z "$WTS_CMD" ]]; then
    print -r -- "wts: wts not found next to this helper nor in PATH — any key"
    wait_key
    return 0
  fi
  src=$(db_ro "SELECT source FROM tasks WHERE id = $(sql_str "$id")" 2>/dev/null)
  title=$(task_label "$id")
  if [[ "$src" != local ]]; then
    print -r -- "“$title” is a Things task: complete it in Things, and it leaves this list at the next 'wts task ls' — any key"
    wait_key
    return 0
  fi
  if ! read -q "?Mark task “$title” done? It leaves this list; its notes and history are kept. [y/N] "; then
    print
    return 0
  fi
  print
  "$WTS_CMD" task done "$id" >/dev/null || { print -n "press any key"; wait_key }
  return 0
}

# ─── Context document ────────────────────────────────────────────────────────
# ctrl-e: `wts doc use` on the selected row, under `execute` like ctrl-o. With
# no slug it opens the library picker, an inner fzf: `execute` hands over the
# alternate screen and blocks this one until it exits — the same terminal
# stop_session reads its y/N from. It always waits for a key: unlike ctrl-o,
# nothing else takes the focus, and what was attached is worth reading.
#
# On a task row the document goes on the TASK instead, which is the difference
# that matters: attached to a session it is gone at the merge, attached to the
# task every later attempt at it inherits the document.
attach_doc() { # $1 = session name, $2 = preview target
  local name="$1" target="${2:-}"
  if [[ -z "$name" && "$target" != task:* ]]; then
    return 0   # the header, or an empty list
  fi
  print -n '\e[2J\e[H'
  if [[ -z "$WTS_CMD" ]]; then
    print -r -- "wts: wts not found next to this helper nor in PATH — any key"
    wait_key
    return 0
  fi
  if [[ -z "$name" ]]; then
    "$WTS_CMD" task doc "${target#task:}"
  else
    "$WTS_CMD" doc use "" "$name"
  fi
  print -n "press any key"
  wait_key
  return 0
}

# ─── Pull a task in ──────────────────────────────────────────────────────────
# ctrl-t: `wts task add`, whose picker is the Things one — another inner fzf
# under `execute`, exactly like ctrl-e's library picker. This is what fills the
# tasks section: the switcher itself never opens Things (it runs every 2 s and
# must stay a single query on wts's own database), so a task gets in here.
pull_task() {
  print -n '\e[2J\e[H'
  if [[ -z "$WTS_CMD" ]]; then
    print -r -- "wts: wts not found next to this helper nor in PATH — any key"
    wait_key
    return 0
  fi
  "$WTS_CMD" task add
  print -n "press any key"
  wait_key
  return 0
}

# ─── Enter on a task ─────────────────────────────────────────────────────────
# `enter` on a task row asks what to do with it rather than starting a session at
# once. The first version did start at once, on a name derived from the title,
# and that was the wrong default twice over: the work often already HAS a session
# (started before the task was written down), and a session worth days deserves a
# name or an opening prompt chosen by the person starting it.
#
# So a second screen, in the SAME popup: this runs after the list's fzf has
# exited, but `display-popup -E` stays open until this script does, so another
# fzf simply takes the screen. It offers
#   - a new session from a prompt       wts-fresh "<prompt>" --task <id>
#   - a new session from a branch name  wts-fresh <name> --task <id>
#   - attaching the task to a session   wts task link <id> <session>
# and `esc` goes back to the list rather than closing the popup.
#
# Not tmux's command-prompt, which was the design before the first version and
# had to be abandoned: it puts interactive state on the CLIENT, and from inside
# the popup's process it raced the popup's teardown — measured on tmux 3.7, from
# identical code the prompt appeared on one `enter` and was gone on the next.
#
# Creation goes through wts-fresh in a new window, EXACTLY what the `wts`
# command-alias does for prefix+g: the branch is cut from a freshly fetched
# origin/<default>, creation refuses outside a repository, and none of that is
# reimplemented here. The window is transient: wts ends with
# `exec tmuxinator start`, which switches the client to the new session. A prompt
# gets its name from wts-name there, in that window — the popup itself still
# never calls the model.

# A new window on wts-fresh, in the repository the user is looking at: the same
# -c expansion the `wts` command-alias uses. No -d: the window has to take the
# focus, or tmuxinator answers "no current client" and exits 1.
# WTS_SWITCH_DRY prints the command instead, for the smoke test.
fresh_window() { # wts-fresh arguments
  if [[ -n "${WTS_SWITCH_DRY:-}" ]]; then
    print -r -- "wts-fresh ${(j: :)${(q-)@}}"
    return 0
  fi
  if [[ -x "$WTS_BIN/wts-fresh" ]]; then
    tmux new-window -n wts -c '#{pane_current_path}' "$WTS_BIN/wts-fresh" "$@" \
      2>/dev/null && return 0
  fi
  tmux display-message "wts: could not start a session on that task" 2>/dev/null
  return 1
}

# What a typed branch becomes as a session name. The prefix is stripped because
# `feature/` is what one types by habit, and wts adds it back itself; the rule is
# the one wts applies to the slug it derives (bin/wts), since the name is used
# as a directory, a tmux session and a branch at once.
#
# The prefix is the one of the layout the session will start on, `default`: the
# built-in one has none, and stripping a `feature/` it never adds back turned
# `feature/foo` into branch `foo`.
task_branch_prefix() {
  local f
  f=$("$WTS_CMD" layouts 2>/dev/null | awk -F '\t' '$1 == "default" { print $2 }')
  if (( ${+WTS_BRANCH_PREFIX} )) || [[ -n "$f" ]]; then
    branch_prefix_of "${f:-/dev/null}"
  fi
}
branch_to_name() { # $1 = what was typed
  setopt local_options extended_glob
  local n="$1" p
  p=$(task_branch_prefix)
  n="${n##[[:space:]]##}"
  n="${n%%[[:space:]]##}"
  [[ -n "$p" && "$n" == "$p"* ]] && n="${n#$p}"
  [[ "$n" =~ '^[a-z0-9][a-z0-9-]*$' ]] || return 1
  print -r -- "$n"
}

# One of the three answers, carried out. Separate from the screens so the smoke
# test can drive it without a terminal (with WTS_SWITCH_DRY). Status 2 is "that
# answer cannot be used", which sends the screen back to the question.
task_action() { # $1 = task id, $2 = prompt|branch|session, $3 = value
  local id="$1" kind="$2" value="${3:-}" name title
  case "$kind" in
    prompt)
      # wts reads an argument as a phrase only when it holds whitespace; a lone
      # word would be taken for a session name — and `status` or `ls` for a
      # wts-fresh passthrough command.
      [[ "$value" == *[[:space:]]* && -n "${value//[[:space:]]/}" ]] || return 2
      fresh_window "$value" --task "$id"
      ;;
    branch)
      name=$(branch_to_name "$value") || return 2
      fresh_window "$name" --task "$id"
      ;;
    session)
      [[ -n "$value" && -n "$WTS_CMD" ]] || return 2
      "$WTS_CMD" task link "$id" "$value" >/dev/null 2>&1 || return 2
      if [[ -n "${WTS_SWITCH_DRY:-}" ]]; then
        print -r -- "switch $value"
        return 0
      fi
      title=$(task_label "$id")
      # The agent already running does not hear of it: the SessionStart hook
      # that carries a task's context only fires on the next start or /clear.
      tmux display-message "wts: $value now serves “$title” — its agent sees it at the next /clear" 2>/dev/null
      tmux switch-client -t "=$value" 2>/dev/null
      ;;
    *) return 2 ;;
  esac
}

# fzf as a one-line editor: no list, the query pre-filled, `enter` returns it.
# fzf exits 1 on an empty list (no match) but still prints the query first;
# 130 is esc.
ask_line() { # $1 = prompt, $2 = default, $3 = header
  local out rc
  out=$(fzf --disabled --print-query --reverse --info=hidden \
          --prompt="$1" --query="$2" --header="$3" </dev/null 2>/dev/null)
  rc=$?
  (( rc == 0 || rc == 1 )) || return 1
  print -r -- "${out%%$'\n'*}"
}

# The rows of the choice screen: <display> TAB <kind> TAB <value>. Sessions of
# the repository in front of the user first, since the task is started there.
choice_rows() { # $1 = task id
  local here="" dir
  dir=$(tmux display-message -p '#{pane_current_path}' 2>/dev/null)
  if [[ -n "$dir" ]]; then
    here=$(git -C "$dir" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)
    here="${here%/.git}"
  fi
  print -r -- "new session from a prompt"$'\t'"prompt"$'\t'
  print -r -- "new session from a branch name"$'\t'"branch"$'\t'
  db_available || return 0
  local name branch root serves served note out row
  local -a f
  out=$(db_rows "
    SELECT s.name, s.branch, s.repo_root, coalesce(t.title, ''), coalesce(l.task, '')
      FROM sessions s
      LEFT JOIN task_links l ON l.session = s.name
      LEFT JOIN tasks t ON t.id = l.task
     ORDER BY s.repo_root = $(sql_str "$here") DESC, s.name" 2>/dev/null)
  for row in "${(@ps:\x1e:)out}"; do
    f=("${(@ps:\x1f:)row}")
    name="${f[1]:-}" branch="${f[2]:-}" root="${f[3]:-}" serves="${f[4]:-}" served="${f[5]:-}"
    [[ -n "$name" ]] || continue
    note=""
    if [[ "$served" == "$1" ]]; then
      note="already serves this task"
    elif [[ -n "$serves" ]]; then
      note="serves: ${serves//[[:cntrl:]]/ }"
    fi
    [[ -n "$here" && "$root" != "$here" ]] && note="${note:+$note, }${root:t}"
    printf 'attach to %-24s %-28s %s\t%s\t%s\n' \
      "$name" "${branch:--}" "${note:+($note)}" session "$name"
  done
}

# The screens. Status 1 is `esc` on the choice itself: back to the list.
choose_for_task() { # $1 = task id
  local id="$1" title slug pick kind value hint def rc prefix
  [[ -n "$id" ]] || return 1
  title=$(db_ro "SELECT title FROM tasks WHERE id = $(sql_str "$id")" 2>/dev/null)
  title="${title//[[:cntrl:]]/ }"
  # The default branch name: derived from the title locally (WTS_NO_LLM=1), as
  # the popup must not call the model. Only a suggestion now, edited before use.
  slug=""
  if [[ -n "$title" && -x "$WTS_BIN/wts-name" ]]; then
    slug=$(WTS_NO_LLM=1 "$WTS_BIN/wts-name" "$title" 2>/dev/null) || slug=""
  fi
  branch_to_name "$slug" >/dev/null || slug=""

  while true; do
    print -n '\e[2J\e[H'
    pick=$(choice_rows "$id" | fzf --reverse --delimiter=$'\t' --with-nth=1 \
             --prompt='task> ' --info=hidden \
             --header="${title:-$id}"$'\n'"enter: choose · esc: back to the list" \
             2>/dev/null) || return 1
    kind=$(print -r -- "$pick" | cut -f2)
    value=$(print -r -- "$pick" | cut -f3)
    case "$kind" in
      session)
        task_action "$id" session "$value" && return 0
        ;;
      prompt|branch)
        if [[ "$kind" == prompt ]]; then
          def="$title"
          hint="The agent's opening prompt, and wts names the session from it."
        else
          def="$slug"
          prefix=$(task_branch_prefix)
          if [[ -n "$prefix" ]]; then
            hint="The session name; the branch is ${prefix}<name>."
          else
            hint="The session name, and the branch's."
          fi
        fi
        # Until an answer is usable, or esc / an empty line to go back.
        while value=$(ask_line "$kind> " "$def" "$hint"$'\n'"enter: start · esc: back"); do
          [[ -n "${value//[[:space:]]/}" ]] || break
          task_action "$id" "$kind" "$value"
          rc=$?
          (( rc == 0 )) && return 0
          def="$value"
          if [[ "$kind" == prompt ]]; then
            hint="A prompt is a phrase: one word would be read as a session name."
          else
            hint="'$value' cannot be a session name: a-z, 0-9 and -, like ${slug:-fix-login}."
          fi
        done
        ;;
    esac
  done
}

# Exposes the function to the subshell fzf starts for `reload`.
#
# A full pass leaves its pid in WTS_SWITCH_BUSY while it runs and its duration
# in WTS_SWITCH_LAST when it ends: the poller reads both. Without them, a pass
# longer than the refresh interval was replaced by the next tick before it
# finished, and on a large repository (12 s per pass at 8 sessions, measured
# in docs/big-repo-analysis.md) the columns never filled at all.
if [[ "${1:-}" == "--list" ]]; then
  if [[ -n "${WTS_SWITCH_BUSY:-}" && "${2:-}" != "--no-git" ]]; then
    zmodload zsh/datetime 2>/dev/null
    print -r -- $$ > "$WTS_SWITCH_BUSY"
    t0=${EPOCHREALTIME:-0}
    build_list "${@:2}"
    print -r -- $(( ${EPOCHREALTIME:-0} - t0 )) > "$WTS_SWITCH_LAST"
    rm -f "$WTS_SWITCH_BUSY"
  else
    build_list "${@:2}"
  fi
  exit 0
fi

# ctrl-g: the last pass's rows under the view just toggled; see "View".
if [[ "${1:-}" == "--list-cached" ]]; then
  build_cached
  exit 0
fi

if [[ "${1:-}" == "--view" ]]; then
  view "${2:-}"
  exit 0
fi

# Not used by fzf — the skeleton is passed on stdin — but the smoke test needs to
# compare the two lists, and it is the quickest way to eyeball the alignment
# (WTS_SWITCH_COLS=55 wts-switch --list-fast | cut -f1).
if [[ "${1:-}" == "--list-fast" ]]; then
  build_skeleton
  exit 0
fi

# Preview subcommands, called by fzf for the current line.
if [[ "${1:-}" == "--preview" ]]; then
  preview "${2:-}" "${3:-}"
  exit 0
fi

if [[ "${1:-}" == "--scroll" ]]; then
  scroll "${2:-}" "${3:-}" "${4:-}"
  exit 0
fi

# Reply mode verbs, called by fzf through `transform`; see "Reply mode" above.
if [[ "${1:-}" == "--reply" ]]; then
  reply "${2:-}" "${@:3}"
  exit 0
fi

# The `?` toggle, called by fzf through `transform`; see "Footer" above.
if [[ "${1:-}" == "--keys" ]]; then
  keys "${2:-}" "${3:-}"
  exit 0
fi

if [[ "${1:-}" == "--fit" ]]; then
  fit_preview "${2:-}" "${3:-}"
  exit 0
fi

if [[ "${1:-}" == "--stop" ]]; then
  stop_session "${2:-}" "${3:-}"
  exit 0
fi

if [[ "${1:-}" == "--pr" ]]; then
  open_pr "${2:-}"
  exit 0
fi

if [[ "${1:-}" == "--rm" ]]; then
  remove_session "${2:-}" "${3:-}" "${4:-}"
  exit 0
fi

if [[ "${1:-}" == "--doc" ]]; then
  attach_doc "${2:-}" "${3:-}"
  exit 0
fi

if [[ "${1:-}" == "--loaded" ]]; then
  loaded "${2:-}"
  exit 0
fi

if [[ "${1:-}" == "--things" ]]; then
  pull_task
  exit 0
fi

if [[ "${1:-}" == "--start" ]]; then
  choose_for_task "${2:-}"
  exit 0
fi

# The choice screen's answers without the screen, for the smoke test.
if [[ "${1:-}" == "--task-action" ]]; then
  task_action "${2:-}" "${3:-}" "${4:-}"
  exit $?
fi

# `wts doc use` sends into an agent's pane too. The `=name:` target form and the
# pause before Enter are hard-won and not worth having in two places, so that
# knowledge stays here and wts-doc calls this verb.
if [[ "${1:-}" == "--send" ]]; then
  send_reply "${2:-}" "${3:-}"
  exit $?
fi

# Jump straight to the agent that is waiting (bound to prefix+a).
if [[ "${1:-}" == "--next" ]]; then
  if [[ ! -x "$WTS_BIN/wts-status" ]] || ! command -v jq >/dev/null 2>&1; then
    tmux display-message "wts: state engine unavailable" 2>/dev/null
    exit 1
  fi
  current=$(tmux display-message -p '#S' 2>/dev/null)
  # Actionable = stuck, blocked, failed, or turn finished and waiting for input.
  # The current session is skipped so that repeated calls cycle through them.
  # The order is wts-status's: the most urgent state first and, within it, the
  # agent waiting longest — so the first press lands on the oldest question.
  # --no-git: this only reads agent states and tmux liveness, and the git
  # columns cost seconds on a large repository.
  states=$("$WTS_BIN/wts-status" --json --no-git 2>/dev/null)
  target=$(print -r -- "$states" | jq -r --arg cur "$current" '
    [ .[]
      | select(.tmux_alive)
      | select(.stale or (.agent_state | IN("blocked","failed","idle")))
      | .name ] as $c
    | (($c | index($cur)) // -1) as $i
    | if ($c | length) == 0 then empty
      else $c[(($i + 1) % ($c | length))] end')
  if [[ -z "$target" ]]; then
    tmux display-message "wts: no agent waiting" 2>/dev/null
    exit 0
  fi
  # Say why it landed here: the state, its age, and the question when there is one.
  why=$(print -r -- "$states" | jq -r --arg t "$target" '
    def age: if . < 60 then "\(. | floor)s" elif . < 3600 then "\((. / 60) | floor)m"
             else "\((. / 3600) | floor)h" end;
    .[] | select(.name == $t)
    | (if .stale then "stuck?" else (.agent_state // "-") end)
      + (if .agent_since then " " + ((now - .agent_since) | age) else "" end)
      + (.agent_waiting_for | if type == "string" and . != "" then ": " + .[0:80] else "" end)')
  tmux switch-client -t "$target" 2>/dev/null || tmux attach -t "$target"
  [[ -n "$why" ]] && tmux display-message "wts: $target — $why" 2>/dev/null
  exit 0
fi

self="$WTS_BIN/wts-switch"

# The table is laid out for the list's real width: the popup's columns, minus
# the preview and the 3 columns fzf adds to it (border-left, padding, scrollbar),
# minus fzf's pointer and marker gutter (2) and the list's scrollbar (1) —
# measured on fzf 0.74 with a 140-column popup: 64 for a 70-column preview. The
# preview gets an absolute size so that width is exact rather than a guess at
# fzf's percentage rounding. Should another fzf lay the panes out a column or two
# differently, every row is the same length and --ellipsis cuts them all at the
# same place, so the columns stay aligned and only the subject loses a little.
# Exported like WTS_SWITCH_SCROLL: the reload children write to a pipe and
# cannot ask the terminal, and they must use the same number as the skeleton or
# the swap would redraw every row shifted. /dev/tty rather than stdout: inside
# `display-popup -E` it is the popup's pty.
cols=$(stty size </dev/tty 2>/dev/null | cut -d' ' -f2)
{ [[ "$cols" == <-> ]] && (( cols > 0 )); } || cols="${COLUMNS:-0}"
(( cols > 0 )) || cols=120
preview_cols=$(( cols / 2 ))
export WTS_SWITCH_COLS=$(( cols - preview_cols - 6 ))

# Start from the skeleton and let fzf pull the collected list itself, so the popup
# is interactive at once instead of after a full collection pass.
#
# `load`, not `start`: `reload` replaces the reader, and on `start` that reader is
# still stdin, so the skeleton is thrown away unread and the popup is an empty
# frame until the collector returns — the very bug being fixed. `load` fires once
# stdin has been consumed and the rows are on screen. Measured on a pty, time
# until the skeleton is visible: `start` never, `start` + `--sync` never (`--sync`
# withholds the first frame until the bind completes, which is worse still),
# `load` immediately.
#
# `unbind(load)` first in the chain, because the reload fires `load` again when it
# finishes: without it the collector would re-run forever. Verified it runs once.
#
# `reload-sync` rather than `reload`, for the same reason the poller below uses
# it: the list is replaced only once the command has finished, so the skeleton
# stays on screen instead of blinking to empty.
#
# The version is probed because an unknown --bind action is fatal: fzf would exit
# immediately and the popup would close without a word. On an older fzf we
# collect up front, exactly as before. 0.36 is where `reload-sync` appeared;
# `load` (0.22) and `unbind` (0.24) are older.
#
# Decided here because the first fill depends on it: with a poller, the `load`
# pass is `--no-git` (agent states in tens of milliseconds, git columns "-")
# and the poller's first tick brings the full list; without one, the `load`
# pass has to be the full list, since nothing else will ever replace it.
#
# sun_path is capped at 104 bytes on macOS. A path that is too long makes the
# bind fail, fzf exits at once and the popup closes without a word: we would
# rather knowingly fall back to the static list.
REFRESH="${WTS_SWITCH_REFRESH:-2}"
sock=""
if [[ "$REFRESH" == <-> ]] && (( REFRESH > 0 )) && command -v curl >/dev/null 2>&1; then
  candidate="${TMPDIR:-/tmp}/wts-switch.$$.sock"
  (( ${#candidate} <= 100 )) && sock="$candidate"
fi

typeset -a fast_opts
fast_opts=()
fzf_version=$(fzf --version 2>/dev/null | cut -d' ' -f1)
autoload -Uz is-at-least
#
# From 0.45 the same chain comes out of `transform` (--loaded), because `load` is
# also how ctrl-t puts the cursor on the task it created: see "New task".
if [[ -n "$fzf_version" ]] && is-at-least 0.36 "$fzf_version"; then
  list=$(build_skeleton)
  first_pass=""
  [[ -n "$sock" ]] && first_pass=" --no-git"
  if is-at-least 0.45 "$fzf_version"; then
    fast_opts=(--bind="load:transform('$self' --loaded$first_pass)")
  else
    fast_opts=(--bind="load:unbind(load)+reload-sync('$self' --list$first_pass)")
  fi
else
  list=$(build_list)
fi

# The fit bind needs `transform` (0.45) and FZF_COLUMNS (0.46). On an older fzf
# the window stays at half the popup, for the reason above: an unknown action
# would close the popup without a word.
typeset -a fit_opts
fit_opts=()
if [[ -n "$fzf_version" ]] && is-at-least 0.46 "$fzf_version"; then
  fit_opts=(--bind="focus:transform('$self' --fit {2} {3})")
fi

# Reply mode rests on `transform` (0.45), the only way to make a key conditional.
# Below that the three keys keep their fzf defaults and the switcher is exactly
# what it was. `tab` is free: without --multi its default `toggle` does nothing.
typeset -a reply_opts
reply_opts=()
if [[ -n "$fzf_version" ]] && is-at-least 0.45 "$fzf_version"; then
  reply_opts=(
    --bind="tab:transform('$self' --reply toggle {2} {3})"
    --bind="enter:transform('$self' --reply send {q} {2} {3})"
    --bind="esc:transform('$self' --reply esc)"
  )
fi

# The collected list is a subset of registry + tmux sessions, so an empty
# skeleton means there would be nothing to show either way.
[[ -n "$list" ]] || exit 0

# Exported rather than recomputed, so that the subprocesses started by
# --preview and by the binds land on this popup's file.
export WTS_SWITCH_SCROLL="${TMPDIR:-/tmp}/wts-switch.$$.scroll"
export WTS_SWITCH_REPLY="${TMPDIR:-/tmp}/wts-switch.$$.reply"
# The task ctrl-t just created, for `load` to put the cursor on.
export WTS_SWITCH_FOCUS="${TMPDIR:-/tmp}/wts-switch.$$.focus"
# Written by `--list` (see there), read by the poller below.
export WTS_SWITCH_BUSY="${TMPDIR:-/tmp}/wts-switch.$$.busy"
export WTS_SWITCH_LAST="${TMPDIR:-/tmp}/wts-switch.$$.last"
# Written by --list, read by --preview: state, since-when and waiting-for per
# session, for the header above the pane capture.
export WTS_SWITCH_META="${TMPDIR:-/tmp}/wts-switch.$$.meta"
# ctrl-g: the view (present: only what needs you) and the rows it re-emits.
export WTS_SWITCH_VIEW="${TMPDIR:-/tmp}/wts-switch.$$.view"
export WTS_SWITCH_ROWS="${TMPDIR:-/tmp}/wts-switch.$$.rows"
rm -f "$WTS_SWITCH_REPLY" "$WTS_SWITCH_FOCUS" "$WTS_SWITCH_VIEW" "$WTS_SWITCH_ROWS"

# ctrl-d and ctrl-x: without a resolvable wts, the binds would fail silently in
# the popup. fzf quotes {1} and {3} itself; {1} is the display line, from which
# --stop reads the agent state shown to the user.
typeset -a delete_bind stop_bind
delete_bind=()
stop_bind=()
if [[ -n "$WTS_CMD" ]]; then
  # Through --rm and not `wts rm {3}` directly: see remove_session for why an
  # empty {3} must never reach `wts rm`.
  delete_bind=(--bind="ctrl-d:execute('$self' --rm {3} {2} {1})+reload('$self' --list)")
  stop_bind=(--bind="ctrl-x:execute('$self' --stop {3} {1})+reload('$self' --list)")
fi

# ctrl-o: `wts pr` needs gh. Without it the key is not bound, and wts-keys reads
# WTS_SWITCH_PR so the footer lists exactly the keys that work. No reload: the
# list has nothing new to show. Kept bound in reply mode: harmless there, and
# the unbind/rebind lists stay the same whether gh is installed or not.
typeset -a pr_bind
pr_bind=()
if [[ -n "$WTS_CMD" ]] && command -v gh >/dev/null 2>&1; then
  export WTS_SWITCH_PR=1
  pr_bind=(--bind="ctrl-o:execute('$self' --pr {3})")
fi

# The PR column's slow timer. gh is a network round trip per session, so it
# never runs on the 2-second tick: at most every $WTS_PR_REFRESH seconds (300 by
# default, 0 for never), in the background, when the popup opens and then from
# the poller. wts-pr --if-older claims the slot in the database, so several
# popups, or a popup and a `wts pr --refresh` typed meanwhile, do not all call
# gh; the list picks the new rows up on its next tick.
PR_EVERY="${WTS_PR_REFRESH:-300}"
[[ "$PR_EVERY" == <-> ]] || PR_EVERY=300
pr_refresh() {
  (( PR_EVERY > 0 )) || return 0
  [[ "${WTS_SWITCH_PR:-}" == 1 && -x "$WTS_BIN/wts-pr" ]] || return 0
  "$WTS_BIN/wts-pr" --refresh --if-older "$PR_EVERY" --quiet </dev/null >/dev/null 2>&1 &!
  return 0
}
pr_refresh

# ctrl-e: `wts doc use` on the selected row. Bound only when the helper is
# there, and wts-keys reads WTS_SWITCH_DOC so the footer lists exactly the keys
# that work. No reload: the list has nothing new to show, but the preview does.
typeset -a doc_bind
doc_bind=()
if [[ -n "$WTS_CMD" && -x "$WTS_BIN/wts-doc" ]]; then
  export WTS_SWITCH_DOC=1
  # {2} as well as {3}: on a task row the name is empty and the target carries
  # the id, and the document goes on the task. The reload is new with that — a
  # task's `N ctx` count changes, where a session's row does not.
  doc_bind=(--bind="ctrl-e:execute('$self' --doc {3} {2})+reload('$self' --list)+refresh-preview")
fi

# ctrl-g: the view; see "View". fzf's own ctrl-g is a second `abort`, which esc
# already is. Below 0.45 there is no `transform` to word the prompt with: the
# toggle runs on its own and the counts line alone says which view this is.
typeset -a view_bind
if [[ -n "$fzf_version" ]] && is-at-least 0.45 "$fzf_version"; then
  view_bind=(--bind="ctrl-g:transform('$self' --view toggle)")
else
  view_bind=(--bind="ctrl-g:execute-silent('$self' --view toggle)+reload('$self' --list-cached)")
fi

# ctrl-t: a new task, whose mode rests on `transform` like reply mode; see "New
# task". Things only decides what an empty title does, and wts-keys reads
# WTS_SWITCH_THINGS so the footer says so only where it is true. Below fzf 0.45
# the key keeps its old meaning — pull a task in from Things — where there is one.
#
# `available` and never `db`: reading Things' container is privileged on macOS
# 15+ and `db` raised "iTerm would like to access data from other apps" on every
# single popup open. The answer comes from wts's own database instead, and the
# two values are not the same claim — `1` is "read once, say so in the footer",
# `maybe` is "never probed, so let ctrl-t itself find out".
typeset -a things_bind
things_bind=()
if [[ -n "$WTS_CMD" && -x "$WTS_BIN/wts-things" ]] \
   && "$WTS_BIN/wts-things" available --maybe; then
  if "$WTS_BIN/wts-things" available; then
    export WTS_SWITCH_THINGS=1
  else
    export WTS_SWITCH_THINGS=maybe
  fi
  things_bind=(--bind="ctrl-t:execute('$self' --things)+reload('$self' --list)")
fi
if [[ -n "$fzf_version" ]] && is-at-least 0.45 "$fzf_version"; then
  things_bind=(--bind="ctrl-t:transform('$self' --reply new)")
fi

# The footer needs --footer (fzf 0.65) and `transform` (0.45, so `?` can leave
# the query alone while the list is filtered). Older versions keep the popup
# exactly as it was, and `wts keys` still prints the same list in a terminal.
# WTS_SWITCH_FOOTER is what the bind subprocesses read, WTS_SWITCH_HELP is
# where expanded-or-not is kept; both are exported for them.
#
# LAST, after every conditional bind above: footer_text runs wts-keys here and
# now, and wts-keys drops the keys whose WTS_SWITCH_* flag is unset. Built before
# them, the FIRST footer drawn listed neither ^o nor ^e nor ^t, and they only
# appeared once `?` or reply mode rebuilt it in a subprocess that had the exports.
typeset -a footer_opts
footer_opts=()
if [[ -x "$WTS_BIN/wts-keys" && -n "$fzf_version" ]] && is-at-least 0.65 "$fzf_version"; then
  export WTS_SWITCH_FOOTER=1
  export WTS_SWITCH_HELP="${TMPDIR:-/tmp}/wts-switch.$$.help"
  rm -f "$WTS_SWITCH_HELP"
  footer_opts=(
    --footer="$(footer_text)"
    --bind="?:transform('$self' --keys toggle {q})"
  )
fi

# ─── Live refresh ────────────────────────────────────────────────────────────
# fzf has no timer event: its bindable events are start, load, resize, result,
# change, focus, multi, one, zero, backward-eof, jump, jump-cancel,
# click-header and click-footer. No interval. The only mechanism meant for an
# autonomous refresh is --listen: fzf opens a socket, an external poller pushes
# actions to it.
#
# `reload-sync` rather than `reload`: the former only replaces the list once
# the command has finished, so no empty list blinking every 2 s. It also keeps
# the cursor and the current query, which avoids --track — which would also
# change how the cursor behaves while filtering.
#
# Caveat: the cursor is kept by INDEX, not by name. If the urgency sort
# reorders the list under the user's feet, the selected line changes session.
# That is the price of a list that is both sorted AND live.
poll_pid=""

cleanup() {
  [[ -n "$poll_pid" ]] && kill "$poll_pid" 2>/dev/null
  [[ -n "$sock" ]] && rm -f "$sock"
  rm -f "$WTS_SWITCH_SCROLL" "$WTS_SWITCH_REPLY" "$WTS_SWITCH_BUSY" "$WTS_SWITCH_LAST" "$WTS_SWITCH_META" \
    "$WTS_SWITCH_FOCUS" "$WTS_SWITCH_VIEW" "$WTS_SWITCH_ROWS" \
    ${WTS_SWITCH_HELP:+"$WTS_SWITCH_HELP"}
}
trap cleanup EXIT INT TERM

typeset -a listen_opts
listen_opts=()
if [[ -n "$sock" ]]; then
  listen_opts=(--listen "$sock")
  # The poller starts before fzf and waits for the socket to appear: fzf
  # exposes no "server ready" signal usable from the outside.
  #
  # Two safety nets for stopping: the trap kills the poller, and `|| break`
  # makes it exit on its own as soon as the socket stops answering (fzf
  # closed). Killing the subshell does not necessarily kill the running
  # `sleep`, hence the second one.
  #
  # Never replace a pass in flight: fzf drops the running reload when the next
  # one arrives, so on a repository where a pass outlasts the interval the list
  # never filled. While `--list` is running (its pid in WTS_SWITCH_BUSY, alive)
  # only the preview is refreshed; and the next reload is scheduled no sooner
  # than the last pass took (WTS_SWITCH_LAST), so a 12-second pass is followed
  # by 12 seconds of quiet rather than by another 12-second pass.
  {
    n=0
    while [[ ! -S "$sock" ]] && (( n < 100 )); do sleep 0.1; (( n++ )); done
    delay="$REFRESH"
    pr_next=$(( SECONDS + PR_EVERY ))
    while [[ -S "$sock" ]]; do
      sleep "$delay"
      if (( PR_EVERY > 0 && SECONDS >= pr_next )); then
        pr_refresh
        pr_next=$(( SECONDS + PR_EVERY ))
      fi
      if [[ -s "$WTS_SWITCH_BUSY" ]] && kill -0 "$(<"$WTS_SWITCH_BUSY")" 2>/dev/null; then
        curl -s -m 2 --unix-socket "$sock" -XPOST http://localhost/ \
          -d "refresh-preview" >/dev/null 2>&1 || break
        continue
      fi
      curl -s -m 2 --unix-socket "$sock" -XPOST http://localhost/ \
        -d "reload-sync(\"$self\" --list)+refresh-preview" >/dev/null 2>&1 || break
      delay="$REFRESH"
      if [[ -s "$WTS_SWITCH_LAST" ]]; then
        last=$(<"$WTS_SWITCH_LAST")
        # LC_ALL=C: under fr_FR (and every comma-decimal locale) printf wrote
        # `12,3`, `sleep 12,3` failed at once, and the loop ran with no delay at
        # all — on the very repositories slow enough to reach this line.
        [[ "$last" == <->(.<->|) ]] && (( last > REFRESH )) && delay=$(LC_ALL=C printf '%.1f' "$last")
      fi
    done
  } &
  poll_pid=$!
fi

selection=$(print -r -- "$list" | fzf \
  "${listen_opts[@]}" \
  "${fast_opts[@]}" \
  "${fit_opts[@]}" \
  "${reply_opts[@]}" \
  "${footer_opts[@]}" \
  --reverse \
  --delimiter=$'\t' \
  --with-nth=1 \
  --prompt='session> ' \
  --header-lines=2 \
  --ellipsis='…' \
  --preview="'$self' --preview {2} {3}" \
  --preview-window="right,${preview_cols},border-left" \
  --bind="ctrl-r:reload('$self' --list)" \
  "${delete_bind[@]}" \
  "${stop_bind[@]}" \
  "${pr_bind[@]}" \
  "${doc_bind[@]}" \
  "${things_bind[@]}" \
  "${view_bind[@]}" \
  --bind="ctrl-f:execute-silent('$self' --scroll {2} {3} down)+refresh-preview" \
  --bind="ctrl-b:execute-silent('$self' --scroll {2} {3} up)+refresh-preview" \
) || exit 0

[[ -n "$selection" ]] || exit 0

target=$(print -r -- "$selection" | cut -f3)

# No session name in field 3: either the row is a task, and `enter` asks what
# to do with it, or it is nothing at all. Field 2 is where the id is.
if [[ -z "$target" ]]; then
  ptarget=$(print -r -- "$selection" | cut -f2)
  [[ "$ptarget" == task:* ]] || exit 0
  choose_for_task "${ptarget#task:}" && exit 0
  # esc on the choice: back to the list, as a fresh popup. The poller and the
  # socket go first — exec keeps the pid, and with it every per-popup path, so
  # the old poller would push its reloads into the new fzf as well.
  cleanup
  trap - EXIT INT TERM
  exec "$self"
fi

tmux switch-client -t "$target" 2>/dev/null || tmux attach -t "$target"
