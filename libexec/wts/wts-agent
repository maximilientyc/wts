#!/usr/bin/env zsh
# wts-agent — drive another session's agent from a command: what the switcher
# does with keys, for an agent that delegated work to other sessions.
#
# Usage: wts send <session> [--answer | --force] <text…>
#        wts wait <session>… [--until <state>[,<state>…]] [--timeout <s>] [--json]
#        wts tail <session> [-n <k>] [--json]
#
#   send   types <text> into the session's agent and submits it. Into the
#          agent's own pane, from its hooks or the collector — refused when that
#          pane is unknown, never typed into whatever pane is active. And only
#          into an agent that will read it as a prompt, working or idle:
#          --answer is for the one that is blocked on a question (the text is
#          then its answer, `1`, `y`…), --force types whatever the state.
#   wait   returns once every named session's agent is in one of the states
#          (default: anything but working — it stopped, finished, failed, needs
#          someone, or claims to work on a pane that no longer moves), or after
#          --timeout seconds (default 90: under the 2 minutes an agent's Bash
#          tool allows a command; call it again to keep waiting). Exit 0 when
#          reached, 1 on timeout. States are those of `wts status --json`:
#          blocked working idle done failed stopped — and `unknown` for a
#          session no agent is known in, which no wait will ever see change.
#   tail   the agent's last <k> messages (default 1), from its transcript — what
#          it concluded, rather than a capture of a terminal UI.
#
# No model call, no git: wts-status --no-git for the states, the transcript
# for the messages.

set -uo pipefail

WTS_BIN="${0:A:h}"
source "$WTS_BIN/wts-db.zsh"

die() { print -u2 -r -- "wts $VERB: $1"; exit "${2:-1}" }

VERB="${1:-}"
(( $# )) && shift

# A session wts knows, by its exact name: these verbs act on another agent, and
# the typo tolerance of `stop` would send a message to the wrong one.
need_session() {  # <name>
  [[ -n "$1" ]] || die "a session name is required" 2
  db_has_session "$1" || die "'$1' is not a wts session (wts ls)"
}

# ─── send ────────────────────────────────────────────────────────────────────

cmd_send() {
  local name="" answer=false force=false
  while (( $# )); do
    case "$1" in
      --answer) answer=true ;;
      --force)  force=true ;;
      --)       shift; break ;;
      -*)       die "unknown option '$1' (--answer, --force; put -- before a text that starts with a dash)" 2 ;;
      *)        [[ -z "$name" ]] || break; name="$1" ;;
    esac
    shift
  done
  need_session "$name"
  local text="$*"
  [[ -n "${text//[[:space:]]/}" ]] || die "nothing to send" 2
  # One line: a newline in the middle would submit half of it.
  text="${text//[[:cntrl:]]/ }"
  local me=""
  me=$(db_current_session 2>/dev/null) || me=""
  [[ "$name" != "$me" ]] || die "'$name' is your own session"
  local pane
  pane=$(agent_pane_of "$name") \
    || die "no agent pane known for '$name' (its agent has not run since wts recorded panes; wts status --json)"

  # What is in that pane, before anything is typed into it. The pane outlives
  # the agent: once Claude has quit it is a shell, and a sentence sent there
  # ran as a command. And a prompt sent to an agent that is asking a question
  # is typed into the question, Enter included. The switcher's reply mode shows
  # the pane to the person typing; a caller with no terminal sees nothing, so
  # it is told instead. --force is the old behaviour.
  if ! $force; then
    local st state="" waiting=""
    st=$("$WTS_BIN/wts-status" --json --no-git "$name" 2>/dev/null)
    IFS=$'\x1f' read -r state waiting < <(print -r -- "$st" | jq -r --arg n "$name" '
      .[] | select(.name == $n)
      | [ (if .tmux_alive then (.agent_state // "unknown") else "stopped" end),
          ((.agent_waiting_for // "") | if type == "string" then . else tojson end
           | gsub("[\\t\\n\\r\u001f]"; " ")) ]
      | join("\u001f")' 2>/dev/null)
    state="${state:-unknown}"
    if $answer; then
      [[ "$state" == blocked ]] \
        || die "'$name' is not waiting for an answer (it is $state): send without --answer"
    else
      case "$state" in
        working|idle) ;;
        blocked)
          die "'$name' is blocked${waiting:+ on: $waiting} — what you send would be typed into that question. Answer it: wts send $name --answer <choice>" ;;
        *)
          local what="it is $state"
          [[ "$state" == unknown ]] && what="none is known there"
          die "no agent is reading in '$name' ($what): its pane may be a shell, where the text would run as a command. wts restore $name starts it again; --force types anyway" ;;
      esac
    fi
  fi

  "$WTS_BIN/wts-switch" --send "$pane" "$text" || die "could not type into $pane"
  if $answer; then print -r -- "→ answered the agent of '$name' ($pane)"
  else print -r -- "→ sent to the agent of '$name' ($pane)"
  fi
}

# ─── wait ────────────────────────────────────────────────────────────────────

cmd_wait() {
  local -a names
  local until_states="" timeout=90 json=false
  names=()
  while (( $# )); do
    case "$1" in
      --until)     until_states="${2:-}"; shift ;;
      --until=*)   until_states="${1#--until=}" ;;
      --timeout)   timeout="${2:-}"; shift ;;
      --timeout=*) timeout="${1#--timeout=}" ;;
      --json)      json=true ;;
      -*)          die "unknown option '$1'" 2 ;;
      *)           names+=("$1") ;;
    esac
    shift
  done
  (( ${#names} )) || die "name at least one session" 2
  [[ "$timeout" == <-> ]] || die "--timeout takes seconds" 2
  local n s
  for n in "${names[@]}"; do need_session "$n"; done
  local -a wanted
  wanted=(${(s:,:)until_states})
  for s in "${wanted[@]}"; do
    [[ "$s" == (blocked|working|idle|done|failed|stopped) ]] \
      || die "unknown state '$s' (blocked working idle done failed stopped)" 2
  done

  zmodload zsh/datetime 2>/dev/null
  local start=$EPOCHSECONDS st reached=false
  local -A state stale
  local -a nobody
  while :; do
    st=$("$WTS_BIN/wts-status" --json --no-git "${names[@]}" 2>/dev/null)
    reached=true
    nobody=()
    for n in "${names[@]}"; do
      s=$(print -r -- "$st" | jq -r --arg n "$n" '
            .[] | select(.name == $n)
            | (if .tmux_alive then (.agent_state // "unknown") else "stopped" end)
              + " " + (.stale // false | tostring)' 2>/dev/null)
      state[$n]="${${s%% *}:-unknown}"
      stale[$n]=false
      [[ "$s" == *" true" ]] && stale[$n]=true
      [[ "${state[$n]}" == unknown ]] && nobody+=("$n")
      if (( ${#wanted} )); then
        (( ${wanted[(Ie)${state[$n]}]} )) || reached=false
      # Working on a pane that has stopped moving is not working: the switcher
      # says `stuck?`, and a wait that ignored it waited on a frozen agent.
      elif [[ "${state[$n]}" == unknown || ( "${state[$n]}" == working && "${stale[$n]}" == false ) ]]; then
        reached=false
      fi
    done
    $reached && break
    (( EPOCHSECONDS - start >= timeout )) && break
    sleep 2
  done

  if $json; then
    for n in "${names[@]}"; do print -r -- "$n"$'\x1f'"${state[$n]}"$'\x1f'"${stale[$n]}"; done \
      | jq -Rc 'split("\u001f") | {name: .[0], state: .[1], stale: (.[2] == "true")}' \
      | jq -sc --argjson r "$($reached && print true || print false)" \
          --argjson w "$(( EPOCHSECONDS - start ))" '{version: 1, reached: $r, waited_s: $w, sessions: .}'
  else
    for n in "${names[@]}"; do
      if [[ "${stale[$n]}" == true ]]; then print -r -- "$n ${state[$n]} (stuck?)"
      else print -r -- "$n ${state[$n]}"
      fi
    done
  fi
  if ! $reached; then
    # "Call it again" was the only advice, and for a session no agent is known
    # in it is advice to loop: nothing there will ever report a state.
    if (( ${#nobody} )); then
      print -u2 -r -- "wts wait: no agent known in ${(j:, :)nobody} (not started yet, or gone without a word for over 12 hours): waiting longer will not change it — wts status --json, wts restore <name>"
    else
      print -u2 -r -- "wts wait: not reached after ${timeout}s; call it again to keep waiting"
    fi
  fi
  $reached
}

# ─── tail ────────────────────────────────────────────────────────────────────

# The transcript of <session>'s agent: the conversation its hooks named, when
# its file is there, else the newest one of the session's working directory —
# through db_session_transcript, like the brief and the retrospective. A lookup
# of its own here had no lower bound on the file's age: under a name used
# again, `tail` read out the conversation of the session that had it before.
transcript_of() {  # <session>
  local wt sub created sid
  wt=$(db_session_field "$1" worktree)
  sub=$(db_session_field "$1" subdir)
  created=$(db_ro "SELECT coalesce(strftime('%s', created_at), 0) FROM sessions
                   WHERE name = $(sql_str "$1")" 2>/dev/null)
  [[ "$created" == <-> ]] || created=0
  sid=$(db_claude_session_of "$1") || sid=""
  db_session_transcript "$wt" "$sub" "$created" "$sid"
}

cmd_tail() {
  local name="" k=1 json=false
  while (( $# )); do
    case "$1" in
      -n)     k="${2:-}"; shift ;;
      -n*)    k="${1#-n}" ;;
      --json) json=true ;;
      -*)     die "unknown option '$1'" 2 ;;
      *)      [[ -z "$name" ]] || die "one session at a time" 2; name="$1" ;;
    esac
    shift
  done
  need_session "$name"
  [[ "$k" == <-> ]] && (( k > 0 )) || die "-n takes a count" 2
  local tr
  tr=$(transcript_of "$name") || die "no transcript for '$name' yet"
  # The assistant's text blocks, newest last; tool calls and thinking left out:
  # what the agent said, not what it did on the way.
  local msgs
  msgs=$(jq -c 'select(.type == "assistant")
                | {at: (.timestamp // ""),
                   text: ([.message.content[]? | select(.type == "text") | .text] | join("\n"))}
                | select(.text != "")' "$tr" 2>/dev/null | tail -n "$k")
  if $json; then
    print -r -- "$msgs" | jq -sc --arg s "$name" --arg t "$tr" \
      '{version: 1, session: $s, transcript: $t, messages: .}'
    return 0
  fi
  [[ -n "$msgs" ]] || { print -r -- "(no message from the agent yet)"; return 0 }
  print -r -- "$msgs" | jq -r '"── \(.at)\n\(.text)\n"'
}

case "$VERB" in
  send) cmd_send "$@" ;;
  wait) cmd_wait "$@" ;;
  tail) cmd_tail "$@" ;;
  *) print -u2 "usage: wts send|wait|tail …"; exit 2 ;;
esac
