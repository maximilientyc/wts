#!/usr/bin/env zsh
# wts-gc — garbage collector for worktrees, branches and registry entries.
#
# Usage: wts gc [--all] [--all-branches] [--apply] [--no-fetch] [--no-retro]
#        wts gc [--all] [--all-branches] [--no-fetch] --json
#
# --json prints the dry run's plan, and only that: every category with its
# entries and why, as one object (an array of them under --all). It is never
# combined with --apply: a program decides from the plan, then asks for it.
#
# Default: DRY RUN. Nothing is deleted without --apply.
#
# Default scope: what wts made. A branch is considered only when a session of
# this repository had it (the registry, or the archive of finished sessions),
# and a husk folder only when it bears the name of such a session. gc used to
# classify EVERY local branch: a local `develop` fully contained in `main` was
# `branch -D`'d, a worktree made by hand on a merged branch was removed, and any
# folder without `.git` under a shared WTS_WORKTREES_BASE was offered for
# `rm -rf`. The dry run listed it all, so it was a choice and not a bug — but
# the wrong default for a tool that only made some of them. --all-branches is
# the old scope, for a repository where every branch is disposable.
#
# --all runs the same gc, unchanged, once per repository that has a registered
# session, from that repository's main worktree. Without it, a repository you
# do not happen to stand in is never cleaned, and its sessions pile up.
#
# --apply also ARCHIVES what it tears down, into the `archive` table that
# `wts log` reports: a session is only tellable once it is finished, and this
# used to be the moment wts forgot it. The facts are collected while the
# worktree still exists, the row is written only once the teardown succeeded,
# and the retrospective — the one model call here — comes last, after every
# destructive step, so a hang or a Ctrl-C costs nothing but text that
# `wts retro` writes later. --no-retro skips that call; so does WTS_NO_LLM.
#
# Six categories, all restricted to the current repository:
#   1. husk folders        — `git worktree remove` does NOT delete git-ignored
#                            files, so a folder without `.git` is left behind
#                            in <repo>-worktrees/. wts's own .wts/ (the context
#                            documents) is one, and is taken away just below
#                            rather than left to become a husk.
#   2. worktrees to remove — those holding a dead branch.
#   3. dead branches       — content entirely present in the base.
#   4. orphan branches     — remote gone, content MISSING from the base.
#   5. orphan registry     — entries whose worktree has disappeared. Those of
#                            the worktrees removed in 2. go along with them.
#   6. stale index.lock    — left by a git process killed mid-operation; blocks
#                            every write in that worktree until removed.
#
# The remote is the source of truth. Fetch --prune first (unless --no-fetch),
# then compare against `origin/<base>` whenever it exists, not against the local
# copy of the base, which may lag behind.
#
# Why `git branch --merged` is not enough: it only recognizes merges by
# ancestry. PRs merged by squash or rebase rewrite SHAs, so the branch is never
# an ancestor of the base and `--merged` does not see it. So we also compare by
# patch-id, the test behind `git cherry`, then by a three-way merge that would
# change nothing (a squash of several commits matches none of their
# patch-ids), and takes a pull request gh saw merged at the branch's tip as a
# witness: merge_scope, merge_content, merge_pr_landed and merge_is_new in
# wts-db.zsh, which the collector and `wts rm` share. That last witness is
# asked of gh by gc itself after its fetch, for the branches the content tests
# left unmerged (pr_witness below): a release rewrites the lines a squash
# landed, and only the pull request still says it merged.
#
# Caution:
#   - only <repo>-worktrees/ is scanned for husks, and a folder that has a
#     `.git` is NEVER proposed (live worktree or independent repository);
#   - a brand-new branch (no commit since its creation) is never "dead": with
#     zero commits it is an ancestor of the base, exactly like a merged one;
#   - a worktree with uncommitted changes is never removed;
#   - a worktree whose Claude agent is busy (working, blocked, stuck) is never
#     removed;
#   - the current tmux session is never killed;
#   - orphan branches (cat. 4) are NEVER deleted automatically: a deleted remote
#     branch does not prove its work landed anywhere;
#   - an index.lock is only reported once it is empty, several minutes old and
#     held by nobody: deleting a live one corrupts its owner's index;
#   - a `--prune` is ONE ref transaction for every deletion, so a single ref git
#     cannot lock loses the whole fetch, origin/<base> included, and every
#     category below then compares against a base days old. The fetch keeps
#     git's stderr for that reason, and retries without --prune. Known cause on
#     macOS: two refs differing only by case (origin/rm/x and origin/RM/x) are
#     ONE path on a case-insensitive filesystem, so neither can be locked nor
#     verified separately, and the transaction aborts.
#
# Variables: WTS_LOCK_STALE_AFTER (300 s before an index.lock counts as stale),
#            WTS_GC_GH_TIMEOUT (20 s for the one `gh pr list`, see pr_witness).

set -uo pipefail

APPLY=false
JSON=false
FETCH=true
RETRO=true
ALL=false
ALL_BRANCHES=false
WTS_BIN="${0:A:h}"
WTS_GC="${0:A}"
typeset -a pass=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --apply)    APPLY=true; pass+=("$1") ;;
    --no-fetch) FETCH=false; pass+=("$1") ;;
    --no-retro) RETRO=false; pass+=("$1") ;;
    --dry-run)  pass+=("$1") ;;
    --json)     JSON=true; pass+=("$1") ;;
    --all-branches) ALL_BRANCHES=true; pass+=("$1") ;;
    --all)      ALL=true ;;
    *) print -u2 "wts gc: unknown option '$1' (--all, --all-branches, --apply, --no-fetch, --no-retro, --json)"; exit 2 ;;
  esac
  shift
done
if $JSON && $APPLY; then
  print -u2 "wts gc: --json is the dry run's plan; --apply acts on it, without --json"
  exit 2
fi

# --all: one run per repository, each in a process of its own so the per-
# repository code below stays exactly what a plain `wts gc` runs. A repository
# is git's common directory and not repo_root: a session created from inside
# another worktree records that worktree as its root (see wts-context), and two
# roots of one repository must not be collected twice. Each run starts from the
# main worktree, because --show-toplevel answers with the worktree you stand in
# and the husk scan derives <repo>-worktrees/ from it (CLAUDE.md).
if $ALL; then
  source "$WTS_BIN/wts-db.zsh"
  db_available || { print -u2 "wts gc --all: sqlite3 is required"; exit 1 }
  typeset -A seen
  typeset -a mains
  root="" common="" main=""
  for root in "${(@f)$(db_ro "SELECT DISTINCT repo_root FROM sessions
                                    WHERE repo_root != '' ORDER BY repo_root" 2>/dev/null)}"; do
    [[ -n "$root" ]] || continue
    if [[ ! -d "$root" ]]; then
      print -u2 -r -- "→ $root: gone, skipped (its sessions are pruned by wts ls)"
      continue
    fi
    common=$(git -C "$root" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || common=""
    [[ -n "$common" ]] || { print -u2 -r -- "→ $root: not a git repository, skipped"; continue }
    [[ -n "${seen[$common]+x}" ]] && continue
    seen[$common]=1
    # The first entry of `worktree list` is the main worktree; a bare one has
    # no working tree to stand in, and nothing of gc applies to it.
    main=$(git -C "$root" worktree list --porcelain 2>/dev/null \
             | awk 'NR == 1 && /^worktree / { sub(/^worktree /, ""); w = $0 }
                    /^bare$/ { w = "" } /^$/ { exit } END { print w }')
    [[ -n "$main" && -d "$main" ]] || { print -u2 -r -- "→ $root: no main worktree, skipped"; continue }
    mains+=("$main")
  done
  if (( ${#mains} == 0 )); then
    print "No registered session, so no repository to collect."
    exit 0
  fi
  integer rc=0 one=0
  typeset -a plans
  plans=()
  for main in "${mains[@]}"; do
    if $JSON; then
      plans+=("$(cd "$main" && WTS_GC_ALL=1 "$WTS_GC" "${pass[@]}")") || rc=1
      continue
    fi
    (( one++ )) && print ""
    ( cd "$main" && WTS_GC_ALL=1 "$WTS_GC" "${pass[@]}" ) || rc=1
  done
  if $JSON; then
    print -r -- "${(F)plans}" | jq -sc '.'
  fi
  exit $rc
fi

if ! git rev-parse --git-dir >/dev/null 2>&1; then
  print -u2 "wts: not in a git repository"
  exit 1
fi

# --json: the report below still runs, into /dev/null, and the plan is printed
# on the real stdout (fd 3) at the point where --apply would start acting.
if $JSON; then
  exec 3>&1 >/dev/null
fi
fetch_state=skipped
# Whether origin answered: the one condition for asking gh below.
remote_ok=false

# The main worktree, not --show-toplevel: run from inside a session — where an
# agent always is — that named the session's worktree, and gc reported on
# `<worktree>-worktrees/` and a repository named after the session. wts-fresh
# and `--all` hopped to the main worktree already; a plain `wts gc` did not.
repo_root=$(git worktree list --porcelain 2>/dev/null \
              | awk 'NR == 1 && /^worktree / { print substr($0, 10); exit }')
[[ -n "$repo_root" && -d "$repo_root" ]] || repo_root=$(git rev-parse --show-toplevel)
repo_name=$(basename "$repo_root")
parent=$(dirname "$repo_root")
worktree_base="${WTS_WORKTREES_BASE:-${parent}/${repo_name}-worktrees}"

source "${0:A:h}/wts-db.zsh"

# Base branch (same priority order as the wrapper).
base="${WTS_BASE_BRANCH:-}"
if [[ -z "$base" ]]; then
  head_ref=$(git -C "$repo_root" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null)
  if [[ -n "$head_ref" ]]; then
    base="${head_ref#origin/}"
  else
    for c in main master; do
      git -C "$repo_root" show-ref --verify --quiet "refs/heads/$c" && { base="$c"; break }
    done
  fi
fi

print "Garbage collection — $repo_name (base: ${base:-?})"
$APPLY && print "Mode: DELETE" || print "Mode: dry run (--apply to execute)"
if $ALL_BRANCHES; then
  print "Scope: every local branch (--all-branches)"
else
  print "Scope: the branches of wts sessions (--all-branches for every one)"
fi

# ─── Sync with the remote ────────────────────────────────────────────────────
# Without --prune, a branch deleted on origin keeps its local tracking ref and
# goes unnoticed. The prune is what makes `[gone]` appear.

# Remote-tracking refs that differ only by case. On a case-insensitive
# filesystem (APFS, by default) they are ONE path: packed-refs holds both names
# happily, `git rev-parse` answers the same loose file for both, and a prune can
# neither lock them separately nor match their old values — the transaction
# aborts and the whole fetch goes with it. This is the one fetch failure whose
# message ("cannot lock ref") says nothing about the cause, and its repair is one
# deletion per ref, so it is worth naming. Only called when a fetch has failed.
case_colliding_refs() {
  git -C "$repo_root" for-each-ref --format='%(refname)' refs/remotes/ 2>/dev/null | awk '
    { k = tolower($0)
      if (k in seen) { if (!(k in shown)) { print seen[k]; shown[k] = 1 } print }
      else seen[k] = $0 }'
}

# git's stderr used to go to /dev/null, which left "fetch failed" as the only
# thing a broken fetch ever said.
#
# The FIRST lines, not a grep for `^(error|fatal):`: git leads with its diagnosis
# and trails with boilerplate, and the most useful line often carries no prefix at
# all — an authentication failure opens on ssh's own "git@github.com: Permission
# denied (publickey)." and only then says `fatal:`. Nothing else writes on stderr
# here, since the fetch is --quiet.
report_fetch_error() {
  local f="$1" l
  local -a lines
  [[ -s "$f" ]] || return 0
  lines=("${(@f)$(<"$f")}")
  lines=("${(@)lines:#}")          # git pads with blank lines before boilerplate
  for l in "${lines[@]:0:3}"; do print "  $l"; done
  # A failing prune can print one `error:` per ref it could not lock: cap, count.
  (( ${#lines} > 3 )) && print "  (+ $(( ${#lines} - 3 )) more line(s) from git)"
  return 0
}

# True when the fetch failed on a ref it could not write, rather than on the
# network. Only then is the case collision below worth naming: those refs are
# real either way, but they are not why an unreachable remote failed.
is_ref_lock_failure() {
  local f="$1"
  # No capture (mktemp failed) means no way to tell: say yes rather than hide the
  # one hint that explains an otherwise mute failure.
  [[ -n "$f" ]] || return 0
  grep -qE "cannot lock ref|could not delete references|\.lock': File exists" "$f" 2>/dev/null
}

if $FETCH && [[ -n "$(git -C "$repo_root" remote 2>/dev/null)" ]]; then
  # The longest silence of the command on a real remote: say it is happening.
  [[ -t 2 ]] && print -u2 "→ fetch --all --prune…"
  # Spelled out rather than `mktemp -t wts-gc-fetch`: with GNU coreutils in front
  # of the BSD one (Homebrew), `-t` without X's is "too few X's in template" and
  # the capture silently went back to /dev/null. Same form as wts-name.
  fetch_err=$(mktemp "${TMPDIR:-/tmp}/wts-gc-fetch.XXXXXX" 2>/dev/null) || fetch_err=""
  if git -C "$repo_root" fetch --all --prune --quiet 2>"${fetch_err:-/dev/null}"; then
    print "Remote: fetch --prune ok"
    fetch_state=ok
    remote_ok=true
  else
    print "Remote: fetch --prune FAILED"
    fetch_state=failed
    report_fetch_error "$fetch_err"
    # An aborted transaction updated NOTHING, origin/<base> included. Without
    # --prune each update is its own transaction and the refs that cannot be
    # deleted are simply not part of it, so this second fetch does go through:
    # the base is fresh again and only `[gone]` stays out of reach.
    if git -C "$repo_root" fetch --all --quiet 2>/dev/null; then
      remote_ok=true
      print "  refs updated without --prune: the base is fresh, but a deleted"
      print "  remote is not seen, so cat. 4 (orphan branches) under-reports"
    else
      print "  analysis on local state (results may be stale)"
    fi
    typeset -a collisions
    collisions=()
    is_ref_lock_failure "$fetch_err" && collisions=("${(@f)$(case_colliding_refs)}")
    collisions=("${(@)collisions:#}")
    if (( ${#collisions} )); then
      # "not a stale lock" on purpose: git's own second line blames a concurrent
      # process or a leftover .lock, and cat. 6 below is about exactly that, so a
      # reader is one step from hunting a lock that was never there.
      print "  not a stale lock: ${#collisions} remote-tracking refs differ only by case —"
      print "  one path on a case-insensitive filesystem, which the prune cannot lock:"
      for ref in "${collisions[@]:0:8}"; do print "    $ref"; done
      (( ${#collisions} > 8 )) && print "    … and $(( ${#collisions} - 8 )) more"
      # One command per ref on purpose: two of them in a single transaction is
      # exactly the collision. A `for` loop calling git once per ref is fine.
      print "  → repair, one deletion per command:"
      print "       git -C $repo_root update-ref -d <each ref above>"
    fi
  fi
  [[ -n "$fetch_err" ]] && rm -f "$fetch_err"
else
  print "Remote: not consulted (--no-fetch)"
fi

# The reference base: origin/<base> if it exists, otherwise the local one.
base_ref="$base"
if [[ -n "$base" ]] && git -C "$repo_root" show-ref --verify --quiet "refs/remotes/origin/$base"; then
  base_ref="origin/$base"
fi
[[ -n "$base" ]] && print "Comparing against: $base_ref"
print ""

# ─── Helpers ─────────────────────────────────────────────────────────────────

# Live worktrees according to git (source of truth), and their branch.
#
# \x1f separator rather than TAB throughout this file: TAB is an IFS
# whitespace, so `read` merges consecutive delimiters and swallows empty fields
# (a detached HEAD has no branch, a session may be unknown to the registry).
typeset -a live
typeset -A branch_wt
while IFS=$'\x1f' read -r wt br; do
  [[ -n "$wt" ]] || continue
  live+=("$wt")
  [[ -n "$br" ]] && branch_wt[$br]="$wt"
done < <(git -C "$repo_root" worktree list --porcelain 2>/dev/null | awk '
  /^worktree /{wt=substr($0,10); br=""}
  /^branch /{br=$2; sub("refs/heads/","",br)}
  /^$/{if(wt!=""){printf "%s%c%s\n", wt, 31, br; wt=""}}
  END{if(wt!="")printf "%s%c%s\n", wt, 31, br}')

is_live() {
  local d="$1" w
  for w in "${live[@]}"; do
    [[ "$w" == "$d" ]] && return 0
  done
  return 1
}

human() {
  local kb="$1"
  if (( kb >= 1048576 )); then printf '%.1fG' $(( kb / 1048576.0 ))
  elif (( kb >= 1024 )); then printf '%.0fM' $(( kb / 1024.0 ))
  else printf '%dK' "$kb"; fi
}

# Tracking state and ancestry of every local branch, for the patch-id test
# (merge_scope in wts-db.zsh, the same one wts-status and `wts rm` use).
merge_scope "$repo_root" "$base" "$base_ref"

# Registered session for a given worktree (empty if unknown).
session_for_worktree() {
  local w="$1"
  db_available || return 0
  # git hands over the canonical path; the registry may hold the one wts was
  # given (trailing slash, symlink). Either spelling names the session.
  db_ro "SELECT name FROM sessions
         WHERE worktree IN ($(sql_str "$w"), $(sql_str "${w:A}")) LIMIT 1" 2>/dev/null
}

# gc's own verdict on a branch, mapped to the archive's closed vocabulary
# (merged squashed remote-deleted removed abandoned unknown). Whether the work
# shipped is the single most load-bearing fact of a performance review, so it is
# stored as one of six values rather than as gc's free-text reason. "merged" and
# "squashed" win over a deleted remote: how the work landed says more than how
# its branch was cleaned up.
outcome_of() {
  case "$1" in
    merged*)   print -r -- "merged" ;;
    squashed*) print -r -- "squashed" ;;
    *)
      if [[ "$1" == *"remote deleted"* || "$1" == *gone* ]]; then
        print -r -- "remote-deleted"
      else
        print -r -- "unknown"
      fi
      ;;
  esac
}

# Busy agents, by worktree: the agent state comes from wts-status, the single
# collector of it — not duplicated here. A merged branch whose agent is still
# working (or waiting for a permission, or looks stuck) is not torn down under
# its feet. Without wts-status or jq, nothing is known and nothing is held back
# for this reason: the other safeguards still apply.
# Filled by the report, read by --json: what it measured on the way.
typeset -A husk_kb gone_ahead
typeset -A busy_wt
if [[ -x "${0:A:h}/wts-status" ]] && command -v jq >/dev/null 2>&1; then
  # Keyed by both spellings of the path, looked up with git's canonical one:
  # a registry path with a trailing slash or through a symlink never matched,
  # and a merged branch was torn down under an agent still working on it.
  while IFS=$'\x1f' read -r w st; do
    [[ -n "$w" ]] && busy_wt[$w]="$st" && busy_wt[${w:A}]="$st"
  done < <("${0:A:h}/wts-status" --json 2>/dev/null | jq -r '
    .[]? | select(.stale == true or .agent_state == "working" or .agent_state == "blocked")
    | "\(.worktree)\(if .stale == true then "stuck?" else .agent_state end)"' 2>/dev/null)
fi

# ─── Scope ───────────────────────────────────────────────────────────────────
# The branches and session names wts has had in THIS repository: live sessions,
# and the archive, which outlives them (a branch whose session `wts rm` removed
# keeps its row there). Same repository = same git common directory, as in
# --all above; a root that no longer exists is matched by path instead.
typeset -A known_branch known_name
foreign_branches=0
foreign_husks=0
if ! $ALL_BRANCHES && db_available; then
  this_common=$(git -C "$repo_root" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)
  typeset -A common_cache
  while IFS=$'\x1f' read -r -d $'\x1e' n b root; do
    [[ -n "$root" ]] || continue
    if [[ -d "$root" ]]; then
      if [[ -z "${common_cache[$root]+x}" ]]; then
        common_cache[$root]=$(git -C "$root" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)
      fi
      [[ -n "$this_common" && "${common_cache[$root]:A}" == "${this_common:A}" ]] || continue
    else
      [[ "$root" == "$repo_root" || "$root" == "${worktree_base:A}"/* ]] || continue
    fi
    [[ -n "$b" ]] && known_branch[$b]=1
    [[ -n "$n" ]] && known_name[$n]=1
  done < <(db_rows "SELECT name, branch, repo_root FROM sessions
                    UNION SELECT session, branch, repo_root FROM archive" 2>/dev/null)
fi
wts_branch() { $ALL_BRANCHES || (( ${+known_branch[$1]} )) }
wts_folder() { $ALL_BRANCHES || (( ${+known_name[${1:t}]} )) }

# Outside tmux, `display-message` falls back to the most recently used session,
# which would then be spared as if it were the one running this command. Only
# a real client has a current session.
cur_session=""
[[ -n "${TMUX:-}" ]] && cur_session=$(tmux display-message -p '#S' 2>/dev/null)

# ─── 1. Husk folders ─────────────────────────────────────────────────────────
# Candidates: <repo>-worktrees/* only, where wts creates its worktrees. Sibling
# folders of the repository are never scanned: a `<repo>-notes/` without `.git`
# has nothing to do with wts and must not be proposed for `rm -rf`.
total_kb=0
typeset -a husks candidates
husks=(); candidates=()
[[ -d "$worktree_base" ]] && candidates+=("$worktree_base"/*(N/))

for d in "${candidates[@]}"; do
  d="${d:A}"
  [[ "$d" == "$repo_root" ]] && continue
  # A `.git` (file for a worktree, folder for a repository) => hands off.
  [[ -e "$d/.git" ]] && continue
  is_live "$d" && continue
  if ! wts_folder "$d"; then
    (( foreign_husks++ ))
    continue
  fi
  husks+=("$d")
done

if (( ${#husks} )); then
  print "Husk folders (no .git, leftovers of \`git worktree remove\`):"
  for d in "${husks[@]}"; do
    kb=$(du -sk "$d" 2>/dev/null | cut -f1)
    husk_kb[$d]="${kb:-0}"
    total_kb=$(( total_kb + ${kb:-0} ))
    printf '  %8s  %s\n' "$(human ${kb:-0})" "$d"
  done
  print "  → $(human $total_kb) reclaimable"
else
  print "Husk folders: none"
fi
(( foreign_husks )) \
  && print "  ($foreign_husks other folder(s) without .git, not named after a wts session: --all-branches)"
print ""

# ─── Pull requests merged on GitHub ──────────────────────────────────────────
# The content tests miss a squash whose lines the base rewrote afterwards: the
# three-way merge then conflicts. A release does exactly that, to the CHANGELOG
# entry and the version every branch touches, and gc left squash-merged
# branches alone until someone ran `wts pr --refresh`. The pull request is the
# witness that survives it (merge_pr_landed), so gc asks gh itself — the one
# caller of gh besides wts-pr (CLAUDE.md) — and only here: after a fetch that
# went through, never with --no-fetch, and for the branches every other test
# called unlanded. One `gh pr list` for the whole repository, not one call per
# branch, filtered to those heads.
#
# A merged PR counts only when its head is the branch's current tip, as in
# wts-pr: a commit added after the merge, or a reused branch name, is not
# covered. Such a match is also written to the session's pr_state row, which
# the switcher and `wts status --json` read; review and checks are kept. Its
# merge_checks row goes: the busy check above ran the collector, which cached
# "not merged" for these very tips, and kept it until a tip moved.
#
# Silent without gh or jq, and when the repository has no GitHub remote (gh's
# own wording, as wts-pr matches it): a GitHub-less repository is not an error.
# The 200 most recent merged PRs: gc runs days after a merge, not years.
pr_witness() { # <branch...>
  local out err errf b head num at url sess key n=0 now
  command -v gh >/dev/null 2>&1 && command -v jq >/dev/null 2>&1 || return 0
  errf=$(mktemp "${TMPDIR:-/tmp}/wts-gc-gh.XXXXXX" 2>/dev/null) || errf=""
  out=$(cd "$repo_root" && GH_PROMPT_DISABLED=1 perl -e 'alarm shift; exec @ARGV' \
          "${WTS_GC_GH_TIMEOUT:-20}" gh pr list --state merged --limit 200 \
          --json number,headRefName,headRefOid,mergedAt,url 2>"${errf:-/dev/null}")
  local rc=$?
  [[ -n "$errf" ]] && { err=$(<"$errf"); rm -f "$errf" }
  err="${${err:-}%%$'\n'*}"
  if (( rc != 0 )); then
    if [[ "$err" == *"none of the git remotes"* || "$err" == *"no git remotes"* \
          || "$err" == *"no pull requests found"* ]]; then
      return 0
    fi
    (( rc == 142 )) && err="no answer in ${WTS_GC_GH_TIMEOUT:-20}s"
    print "Pull requests: gh failed (${err:-exit $rc}), merged PRs not consulted"
    return 0
  fi
  now=${EPOCHSECONDS:-$(date +%s)}
  while IFS=$'\x1f' read -r b head num at url; do
    [[ -n "$b" && -n "$head" && "$head" == "${MERGE_TIP[$b]:-}" ]] || continue
    # Through a variable, as merge_scope does: a $'..' quote inside the
    # subscript is not the key merge_pr_landed builds.
    key="$b"$'\x1f'"$head"
    MERGE_PR_HEAD[$key]=1
    (( n++ ))
    sess=""
    [[ -n "${branch_wt[$b]:-}" ]] && sess=$(session_for_worktree "${branch_wt[$b]}")
    [[ -n "$sess" && "$num" == <-> ]] || continue
    db_q "INSERT INTO pr_state (session, branch, number, state, merged_at, url, head,
                                error, fetched_at, checked_at)
            VALUES ($(sql_str "$sess"), $(sql_str "$b"), $num, 'merged', $(sql_str "$at"),
                    $(sql_str "$url"), $(sql_str "$head"), '', $now, $now)
          ON CONFLICT(session) DO UPDATE SET branch = excluded.branch,
            number = excluded.number, state = 'merged', merged_at = excluded.merged_at,
            url = excluded.url, head = excluded.head, error = '',
            fetched_at = excluded.fetched_at, checked_at = excluded.checked_at;
          DELETE FROM merge_checks WHERE session = $(sql_str "$sess")" >/dev/null 2>&1
  done < <(print -r -- "$out" | jq -r --args '
             .[]? | select(.headRefName as $h | $ARGS.positional | index($h))
             | [.headRefName, (.headRefOid // ""), (.number | tostring), (.mergedAt // ""), (.url // "")]
             | join("\u001f")' "$@" 2>/dev/null)
  print "Pull requests: asked gh about ${#@} unmerged branch(es), $n merged at their tip"
  return 0
}

# A branch whose content is in the base (or whose PR merged at its tip):
# left alone if new, else a teardown, a dead branch, or held back.
classify_landed() { # <branch>
  local b="$1" why wt dirty
  if merge_is_new "$b"; then
    new_branches+=("$b")
    return 0
  fi

  if [[ -n "${MERGE_ANCESTRY[$b]:-}" ]]; then why="merged"; else why="squashed/rebased"; fi
  [[ "${MERGE_TRACK[$b]:-}" == "[gone]" ]] && why="$why, remote deleted"

  wt="${branch_wt[$b]:-}"
  if [[ -z "$wt" ]]; then
    free_branches+=("$b"$'\x1f'"$why")
  elif [[ "$wt" == "$repo_root" ]]; then
    : # the working branch of the main repository: never touched
  else
    # --no-optional-locks, and not GIT_OPTIONAL_LOCKS=0 for the whole
    # script: gc also removes worktrees and deletes branches, and those
    # locks are not optional. Without it this status took the worktree's
    # index.lock and raced the agent living there (see wts-status).
    dirty=$(git -C "$wt" --no-optional-locks status --porcelain 2>/dev/null | wc -l | tr -d ' ')
    if (( ${dirty:-0} > 0 )); then
      held+=("$b"$'\x1f'"$wt"$'\x1f'"${dirty} modified file(s)")
    elif [[ -n "${busy_wt[$wt]:-}" ]]; then
      held+=("$b"$'\x1f'"$wt"$'\x1f'"agent busy (${busy_wt[$wt]})")
    else
      teardown+=("$b"$'\x1f'"$wt"$'\x1f'"$(session_for_worktree "$wt")"$'\x1f'"$why")
    fi
  fi
  return 0
}

# ─── Classifying branches ────────────────────────────────────────────────────
# dead   : content entirely in the base (whatever the merge mode)
# orphan : remote gone, but some content is still missing from the base
# new    : created, never committed to — left alone
typeset -a teardown held free_branches gone_branches new_branches
teardown=(); held=(); free_branches=(); gone_branches=(); new_branches=()

if [[ -n "$base" ]]; then
  typeset -a all_branches
  all_branches=("${(@f)$(git -C "$repo_root" for-each-ref --format='%(refname:short)' refs/heads/ 2>/dev/null)}")
  # Seconds per thousand branches now, but still the longest step: say so.
  (( ${#all_branches} > 200 )) && [[ -t 2 ]] \
    && print -u2 "→ classifying ${#all_branches} local branches…"
  # Branches no content test placed in the base: the second pass below asks
  # gh about them, then judges them again.
  typeset -a unlanded
  unlanded=()
  for b in "${all_branches[@]}"; do
    [[ -n "$b" && "$b" != "$base" ]] || continue
    if ! wts_branch "$b"; then
      (( foreign_branches++ ))
      continue
    fi
    if merge_content "$b" || merge_pr_landed "$b"; then
      classify_landed "$b"
    else
      unlanded+=("$b")
    fi
  done
  (( ${#unlanded} )) && $remote_ok && pr_witness "${unlanded[@]}"
  for b in "${unlanded[@]}"; do
    if merge_pr_landed "$b"; then
      classify_landed "$b"
    elif [[ "${MERGE_TRACK[$b]:-}" == "[gone]" ]]; then
      gone_branches+=("$b")
    fi
  done
fi

# ─── 2. Worktrees to remove ──────────────────────────────────────────────────
if (( ${#teardown} )); then
  print "Worktrees on a dead branch (worktree + session + branch):"
  for rec in "${teardown[@]}"; do
    IFS=$'\x1f' read -r b wt sess why <<< "$rec"
    printf '  %-28s %s\n' "$b" "$wt"
    printf '  %-28s   → %s%s\n' "" "$why" "${sess:+, tmux session '$sess'}"
  done
else
  print "Worktrees on a dead branch: none"
fi
if (( ${#held} )); then
  print "  (left in place:)"
  for rec in "${held[@]}"; do
    IFS=$'\x1f' read -r b wt reason <<< "$rec"
    printf '  %-28s %s — %s\n' "$b" "$wt" "$reason"
  done
fi
print ""

# ─── 3. Dead branches without a worktree ─────────────────────────────────────
if (( ${#free_branches} )); then
  print "Dead branches in '$base_ref', without a worktree:"
  for rec in "${free_branches[@]}"; do
    IFS=$'\x1f' read -r b why <<< "$rec"
    printf '  %-28s (%s)\n' "$b" "$why"
  done
else
  print "Dead branches without a worktree: none"
fi
(( ${#new_branches} )) && print "New branches without commits, left alone: ${(j:, :)new_branches}"
(( foreign_branches )) \
  && print "Other branches, not made by a wts session, not looked at: $foreign_branches (--all-branches)"
print ""

# ─── 4. Orphan branches ──────────────────────────────────────────────────────
if (( ${#gone_branches} )); then
  print "Branches whose remote is gone, content MISSING from '$base_ref':"
  for b in "${gone_branches[@]}"; do
    ahead=$(git -C "$repo_root" rev-list --count "$base_ref..$b" 2>/dev/null)
    gone_ahead[$b]="${ahead:-0}"
    printf '  %-28s %s commit(s) the base does not have\n' "$b" "${ahead:-?}"
  done
  print "  → never deleted automatically: check before \`git branch -D\`"
else
  print "Orphan branches (remote gone, not merged): none"
fi
print ""

# ─── 5. Orphan registry entries ──────────────────────────────────────────────
typeset -a orphans
orphans=()
if db_available; then
  while IFS=$'\x1f' read -r -d $'\x1e' n w; do
    [[ -n "$n" ]] || continue
    [[ -d "$w" ]] || orphans+=("$n")
  done < <(db_rows "SELECT name, worktree FROM sessions" 2>/dev/null)
fi

# The entries attached to the worktrees removed in 2. are not orphans at scan
# time — their folder still exists — but will be at the end of this run. The
# scan alone would miss them by one round, and `wts-switch` (prefix+s) reads
# the registry: they would stay listed as live sessions until the next gc.
typeset -a reg_teardown
reg_teardown=()
for rec in "${teardown[@]}"; do
  IFS=$'\x1f' read -r b wt sess why <<< "$rec"
  [[ -n "$sess" ]] && reg_teardown+=("$sess")
done

if (( ${#orphans} )); then
  print "Orphan registry entries: ${(j:, :)orphans}"
else
  print "Orphan registry entries: none"
fi
(( ${#reg_teardown} )) && print "  (+ removed along with their worktree: ${(j:, :)reg_teardown})"
print ""

# ─── 6. Stale index locks ────────────────────────────────────────────────────
# `git status` and `git add` create <gitdir>/index.lock and hold it for the whole
# operation. A process killed inside that window — an aborted agent, a status
# collector whose caller went away, lazygit in a torn-down pane — leaves the file
# behind, and from then on EVERY write in that worktree fails with "Unable to
# create index.lock: File exists". Nothing reports it, so the worktree looks fine
# until the next `git add`, and the fix (deleting a file inside .git) is not one
# to guess at.
#
# Three conditions, all required, because deleting a lock somebody holds
# corrupts their index:
#   - empty: git writes the new index INTO the lock before renaming it over
#     `index`, so a non-empty lock may be a write in progress;
#   - older than WTS_LOCK_STALE_AFTER (5 min): no legitimate status or add holds
#     the lock that long;
#   - no open file descriptor: git keeps the lock open for the whole operation,
#     so lsof is the authoritative liveness test. Without lsof the first two
#     conditions stand alone and the report says so, rather than staying silent.
LOCK_STALE_AFTER=${WTS_LOCK_STALE_AFTER:-300}

# zstat rather than stat: the `stat` in PATH may be GNU coreutils', whose options
# have nothing in common with the macOS one.
zmodload -F zsh/stat b:zstat 2>/dev/null

# Age as one field, for a report that stays readable at a glance.
lock_age() {
  local s=$1
  (( s < 3600 ))  && { print -r -- "$((s / 60))m"; return }
  (( s < 86400 )) && { print -r -- "$((s / 3600))h"; return }
  print -r -- "$((s / 86400))d"
}

typeset -a stale_locks
stale_locks=()
lock_note=""
# --git-common-dir, not "$repo_root/.git": the latter is a file in a linked
# worktree, and gc may well be run from one.
common_dir=$(git -C "$repo_root" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)
if [[ -z "$common_dir" ]]; then
  # git < 2.31 has no --path-format, and the plain form answers relative to the
  # repository — which would resolve against this script's cwd instead.
  common_dir=$(git -C "$repo_root" rev-parse --git-common-dir 2>/dev/null)
  [[ -n "$common_dir" && "$common_dir" != /* ]] && common_dir="$repo_root/$common_dir"
fi
# `b:zstat` loads a builtin, so it lands in $builtins, not in $functions.
if [[ -n "$common_dir" ]] && (( ${+builtins[zstat]} )); then
  command -v lsof >/dev/null 2>&1 \
    || lock_note="lsof not found: a lock still held by a live git process cannot be ruled out"
  now=$(date +%s)
  # (N) on the glob only: no worktree at all is the normal case for a plain
  # repository, and a bare glob would print zsh's "no matches found". The first
  # word is not a pattern, so it survives as-is and the -e test filters it.
  for lock in "$common_dir"/index.lock "$common_dir"/worktrees/*/index.lock(N); do
    [[ -f "$lock" ]] || continue
    [[ -s "$lock" ]] && continue
    mtime=$(zstat +mtime "$lock" 2>/dev/null) || continue
    (( now - mtime >= LOCK_STALE_AFTER )) || continue
    # -n -P: no host or port name lookups, 0.1 s instead of 0.3 s per lock.
    [[ -n "$(lsof -n -P -t -- "$lock" 2>/dev/null)" ]] && continue
    # The main working tree's lock lives directly in the common dir; a linked
    # worktree's is one level down, under its own name.
    if [[ "$lock" == "$common_dir"/index.lock ]]; then
      owner="$repo_name (main)"
    else
      owner="${lock:h:t}"
    fi
    stale_locks+=("$owner"$'\x1f'"$lock"$'\x1f'"$(lock_age $(( now - mtime )))")
  done
fi

if (( ${#stale_locks} )); then
  print "Stale index.lock (every git write in that worktree fails until removed):"
  for rec in "${stale_locks[@]}"; do
    IFS=$'\x1f' read -r owner lock age <<< "$rec"
    printf '  %-28s %s ago\n' "$owner" "$age"
  done
else
  print "Stale index.lock: none"
fi
[[ -n "$lock_note" ]] && print "  ($lock_note)"
print ""

# ─── Execution ───────────────────────────────────────────────────────────────
# Announced even in dry run, and only announced: --apply INSERTs into `archive`,
# and a dry run that quietly wrote to the database would be a surprise the first
# time someone noticed it.
integer to_archive=0
for rec in "${teardown[@]}"; do
  IFS=$'\x1f' read -r b wt sess why <<< "$rec"
  [[ -n "$sess" ]] && (( ++to_archive ))
done
if (( to_archive )); then
  print "To archive (kept for wts log): $to_archive session(s)"
  # Said before --apply, once: the dry run is where a cost can still be declined.
  if ! $APPLY && $RETRO && [[ -z "${WTS_NO_LLM:-}" ]] && command -v claude >/dev/null 2>&1; then
    print "  --apply then asks Claude for $to_archive retrospective(s): one ${WTS_MODEL:-haiku} call each,"
    print "  ${WTS_RETRO_JOBS:-3} at a time, after the teardown (--no-retro: none now, wts retro later)"
  fi
  print ""
fi

# ─── The plan, as JSON ───────────────────────────────────────────────────────
if $JSON; then
  integer retro_calls=0
  if $RETRO && [[ -z "${WTS_NO_LLM:-}" ]] && command -v claude >/dev/null 2>&1; then
    retro_calls=$to_archive
  fi
  # One jq per category, from \x1f records: the fields are paths and reasons,
  # free text that only jq can quote.
  recs() {  # <field names…> — reads \x1f records on stdin
    jq -Rc --args 'split("\u001f") as $f | [$ARGS.positional, $f] | transpose
                   | map({(.[0]): (.[1] // "")}) | add' "$@" | jq -sc '.'
  }
  j_husks=$(for d in "${husks[@]}"; do print -r -- "$d"$'\x1f'"${husk_kb[$d]:-0}"; done | recs path kb)
  j_teardown=$(print -rl -- "${teardown[@]}" | grep . | recs branch worktree session why)
  j_held=$(print -rl -- "${held[@]}" | grep . | recs branch worktree reason)
  j_dead=$(print -rl -- "${free_branches[@]}" | grep . | recs branch why)
  j_gone=$(for b in "${gone_branches[@]}"; do print -r -- "$b"$'\x1f'"${gone_ahead[$b]:-0}"; done | recs branch ahead)
  j_locks=$(print -rl -- "${stale_locks[@]}" | grep . | recs owner path age)
  jq -nc --arg repo "$repo_name" --arg root "$repo_root" --arg base "${base:-}" \
     --arg base_ref "${base_ref:-}" --arg fetch "$fetch_state" \
     --arg scope "$($ALL_BRANCHES && print all || print wts)" \
     --argjson husks "$j_husks" --argjson teardown "$j_teardown" --argjson held "$j_held" \
     --argjson dead "$j_dead" --argjson gone "$j_gone" --argjson locks "$j_locks" \
     --argjson new "$(print -rl -- "${new_branches[@]}" | grep . | jq -Rsc 'split("\n") | map(select(. != ""))')" \
     --argjson orphans "$(print -rl -- "${orphans[@]}" | grep . | jq -Rsc 'split("\n") | map(select(. != ""))')" \
     --argjson fb "$foreign_branches" --argjson fh "$foreign_husks" \
     --argjson archive "$to_archive" --argjson calls "$retro_calls" '
     {version: 1, repo: $repo, repo_root: $root, base: $base, compared_to: $base_ref,
      fetch: $fetch, scope: $scope,
      husks: ($husks | map(.kb |= (tonumber? // 0))),
      teardown: ($teardown | map(.session |= (if . == "" then null else . end))),
      held: $held, dead_branches: $dead, new_branches: $new,
      orphan_branches: ($gone | map(.ahead |= (tonumber? // 0))),
      orphan_registry: $orphans, stale_locks: $locks,
      not_looked_at: {branches: $fb, folders: $fh},
      to_archive: $archive, retro_calls: $calls}' >&3
  exit 0
fi

if ! $APPLY; then
  if (( ${#husks} + ${#teardown} + ${#free_branches} + ${#orphans} + ${#stale_locks} > 0 )); then
    print "Nothing was deleted. Run again with: wts gc${WTS_GC_ALL:+ --all} --apply"
  fi
  exit 0
fi

# Order: removing the worktrees frees their branches, which are deleted next.
# `purge` accumulates the registry entries to remove: the orphans found above,
# plus those whose worktree is going away right now.
typeset -a purge
purge=("${orphans[@]}")
# The sessions whose archive row was written: what the retro phase works on.
typeset -a archived
archived=()
retro_tmp=$(mktemp -d "${TMPDIR:-/tmp}/wts-gc-retro.XXXXXX") || retro_tmp=""
[[ -n "$retro_tmp" ]] && trap 'rm -rf "$retro_tmp"' EXIT

for rec in "${teardown[@]}"; do
  IFS=$'\x1f' read -r b wt sess why <<< "$rec"
  if [[ -n "$sess" ]]; then
    if [[ "$sess" == "$cur_session" ]]; then
      print -u2 "⚠ session '$sess' is the current session, not killed"
    else
      tmux kill-session -t "=$sess" 2>/dev/null && print "✓ session $sess killed"
    fi
  fi
  # Before anything is removed: the facts live in the worktree and the branch,
  # both of which are about to go. `why` is already gc's own verdict on how the
  # work ended, so it becomes the archive's outcome.
  if [[ -n "$sess" && -n "$retro_tmp" && -z "${WTS_NO_ARCHIVE:-}" && -x "$WTS_BIN/wts-retro" ]]; then
    "$WTS_BIN/wts-retro" collect "$sess" "$wt" "$b" "$base" "$(outcome_of "$why")" \
      > "$retro_tmp/$sess.facts" 2>/dev/null \
      || print -u2 "⚠ $sess: facts not collected, archiving what the registry knows"
  fi
  # .wts/ holds the session's context documents and is git-ignored, so git
  # leaves it behind and the folder becomes a husk (category 1) on the very
  # next pass. Never a symlink, never anything but that folder.
  if [[ -d "$wt/.wts" && ! -L "$wt/.wts" ]]; then
    rm -rf -- "$wt/.wts"
  fi
  if git -C "$repo_root" worktree remove "$wt" 2>/dev/null; then
    print "✓ worktree $wt removed"
    # Only now: an archive row means "this work ended", and a worktree that
    # could not be removed has not ended.
    if [[ -n "$sess" && -s "$retro_tmp/$sess.facts" ]]; then
      if store_err=$("$WTS_BIN/wts-retro" store "$sess" < "$retro_tmp/$sess.facts" 2>&1 >/dev/null); then
        archived+=("$sess")
      else
        print -u2 -r -- "⚠ $sess: not archived${store_err:+: ${store_err%%$'\n'*}}"
      fi
    fi
    [[ -n "$sess" ]] && purge+=("$sess")
    if git -C "$repo_root" branch -D "$b" >/dev/null 2>&1; then
      print "✓ branch $b deleted"
    else
      print -u2 "⚠ branch $b not deleted"
    fi
  else
    print -u2 "⚠ worktree $wt not removed (branch $b kept)"
  fi
done
(( ${#archived} )) && print "✓ archived ${#archived} session(s) (wts log)"

# `-D` and not `-d`: a squashed branch is not "merged" in git's sense, while
# its content is indeed in the base — which is what was checked above.
for rec in "${free_branches[@]}"; do
  IFS=$'\x1f' read -r b why <<< "$rec"
  if git -C "$repo_root" branch -D "$b" >/dev/null 2>&1; then
    print "✓ branch $b deleted ($why)"
  else
    print -u2 "⚠ branch $b not deleted"
  fi
done

for d in "${husks[@]}"; do
  if rm -rf -- "$d"; then print "✓ deleted $d"; else print -u2 "⚠ failed to delete $d"; fi
done

# Re-checked here and not trusted from the scan above: the fetch and the
# teardowns took time, and a lock that became live in between must survive.
for rec in "${stale_locks[@]}"; do
  IFS=$'\x1f' read -r owner lock age <<< "$rec"
  if [[ -s "$lock" ]] || [[ -n "$(lsof -t -- "$lock" 2>/dev/null)" ]]; then
    print -u2 "⚠ index.lock of $owner now held by a live git process, kept"
  elif [[ ! -f "$lock" ]]; then
    print "✓ index.lock of $owner already gone"
  elif rm -f -- "$lock"; then
    print "✓ stale index.lock removed ($owner)"
  else
    print -u2 "⚠ index.lock of $owner not removed"
  fi
done

purge=("${(@u)purge}")
# The rows the other tables keep about a session go with it; so do those of
# sessions removed some other way, and pane hashes no agent has refreshed in a
# week (Claude session ids are never reused).
if db_available && [[ -s "$WTS_DB" ]]; then
  if db_err=$(db_q "BEGIN IMMEDIATE;
           DELETE FROM sessions WHERE name IN $(sql_list "${purge[@]}");
           DELETE FROM briefs WHERE session NOT IN (SELECT name FROM sessions);
           DELETE FROM notes WHERE session NOT IN (SELECT name FROM sessions);
           DELETE FROM task_links WHERE session NOT IN (SELECT name FROM sessions);
           DELETE FROM agent_events WHERE session NOT IN (SELECT name FROM sessions);
           DELETE FROM agent_panes WHERE session NOT IN (SELECT name FROM sessions);
           DELETE FROM touches WHERE session NOT IN (SELECT name FROM sessions);
           DELETE FROM pr_state WHERE session NOT IN (SELECT name FROM sessions);
           DELETE FROM merge_checks WHERE session NOT IN (SELECT name FROM sessions);
           DELETE FROM pane_hashes WHERE since < unixepoch() - 7 * 86400;
           DELETE FROM kv WHERE key LIKE 'teardown:%'
             AND CAST(value AS INTEGER) < unixepoch() - 3600;
           COMMIT;" 2>&1 >/dev/null); then
    db_q "$(usage_prune_sql)" >/dev/null 2>&1
    db_q "$(seen_prune_sql "(SELECT name FROM sessions)" not)" >/dev/null 2>&1
    (( ${#purge} )) && print "✓ registry: ${#purge} entry(ies) removed"
  else
    # sqlite3's reason: "database is locked" and "no such function: unixepoch"
    # (SQLite before 3.38) call for different fixes.
    print -u2 -r -- "⚠ registry not updated${db_err:+: ${db_err%%$'\n'*}}"
  fi
fi

git -C "$repo_root" worktree prune 2>/dev/null

# Last on purpose, and the only place gc calls the model. Every destructive step
# above has finished and been reported, so a missing claude, a timeout or a
# Ctrl-C here costs only four lines of text, which `wts retro` writes later from
# rows already in the database. Summarizing earlier — while the facts were still
# live — would instead put a model call per session in front of the deletions
# and lose the whole run to one hang.
if (( ${#archived} )) && $RETRO && [[ -z "${WTS_NO_LLM:-}" ]] \
   && command -v claude >/dev/null 2>&1 && [[ -x "$WTS_BIN/wts-retro" ]]; then
  print ""
  "$WTS_BIN/wts-retro" write "${archived[@]}"
elif (( ${#archived} )); then
  print "  (no retrospective written: run wts retro when you want them)"
fi
