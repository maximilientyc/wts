#!/usr/bin/env zsh
# wts-task — the durable unit of work above a session.
#
# Usage: wts task ls [--all]
#        wts task show <id>
#        wts task link [<id|url|words>] [<session>]
#        wts task unlink [<session>]
#        wts task new "<title>"
#        wts task add [<id|words>]
#        wts task note [<id>] "<text>" | [<id>] --clear
#        wts task edit [<id>]
#        wts task doc [<id>] [<url|path|slug>] | [<id>] --rm <slug>
#        wts task done [<id>]
#
# A task lives for months and gets one to N sessions; a session lives for days
# and dies at the merge. So the task is the durable identity and the session is
# one attempt at it — which is what lets `wts log` say "three attempts over five
# weeks" instead of showing three unrelated branches, and what carries the Notion
# pages, Slack threads and meeting notes that live in the task's own notes.
#
# `note`, `edit` and `doc` are how a task carries context on a machine where the
# notes do not come from Things: they write task_notes and task_docs, which
# snapshot() never touches, and `wts <name> --task <id>` turns both into the new
# session's opening context. Every one of them takes the task of the session you
# are in when no id is given.
#
# Where the id is optional, position 1 is only read as a task when it IS one —
# a `local:` id, a `things:` link, or a row wts already has. Anything else is the
# text or the document, so `wts task note "the spec moved"` needs no id and
# `wts task note <15-character word>` is not mistaken for a Things uuid. Point
# wts at a Things task once with `wts task add` and it becomes a known row.
#
# A task is a LABEL, not a folder: `wts ls` and the switcher stay one flat list
# of sessions with an `@` on the linked ones, because the switcher is
# width-constrained and nesting would cost the one view that has to stay
# scannable. The grouped view is this command.
#
# The link itself is per-session and dies with the session (see task_links in
# wts-db.zsh); the durable one is the archive row, which `wts log` reads.

set -uo pipefail

WTS_BIN="${0:A:h}"
source "$WTS_BIN/wts-db.zsh"

# Overridable so the smoke test can count the opens: "one read of Things per
# command" is the property this file is built around, and a claim no test can
# check is how it drifted back to one per task in the first place.
THINGS="${WTS_THINGS_BIN:-$WTS_BIN/wts-things}"
DOC="$WTS_BIN/wts-doc"

# ─── Helpers ─────────────────────────────────────────────────────────────────

now_iso() { db_ro "SELECT strftime('%Y-%m-%dT%H:%M:%SZ', 'now')" 2>/dev/null }

# Whether an argument IS a task, for the verbs whose id is optional. Deliberately
# stricter than resolve_task: no bare-uuid guess and no word search, because here
# a false positive would read the note as an id and lose the text.
is_task_arg() {  # <arg>
  [[ -n "${1:-}" ]] || return 1
  [[ "$1" == local:* || "$1" == things:* ]] && return 0
  [[ "$(db_ro "SELECT 1 FROM tasks WHERE id = $(sql_str "$1")" 2>/dev/null)" == 1 ]]
}

# The task of the session the caller is in, for `wts task note` typed inside a
# worktree. Fails with the reason rather than silently writing nowhere.
current_task() {
  local s t
  s=$(db_current_session) || {
    print -u2 -r -- "wts task: not inside a wts session, name a task"
    return 1
  }
  t=$(db_task_of_session "$s")
  [[ -n "$t" ]] || {
    print -u2 -r -- "wts task: '$s' serves no task (wts task link)"
    return 1
  }
  print -r -- "$t"
}

# Shared by note / edit / doc: peel an optional leading task id off the
# arguments. Answers in two globals rather than on stdout, because a command
# substitution runs in a subshell and REPLY_ARGS set there would never reach the
# caller — the arguments would silently vanish and every note be written empty.
typeset -g REPLY_TASK=""
typeset -ga REPLY_ARGS=()
take_task_arg() {  # <args…>  -> REPLY_TASK, REPLY_ARGS
  REPLY_TASK=""
  REPLY_ARGS=()
  if is_task_arg "${1:-}"; then
    REPLY_TASK=$(resolve_task "$1") || return 1
    shift
  else
    REPLY_TASK=$(current_task) || return 1
  fi
  [[ -n "$REPLY_TASK" ]] || return 1
  REPLY_ARGS=("$@")
}

task_exists() {  # <id>
  [[ "$(db_ro "SELECT 1 FROM tasks WHERE id = $(sql_str "$1")" 2>/dev/null)" == 1 ]]
}

# Snapshot a Things task into `tasks`. Last writer wins, with no merge logic at
# all: nothing is ever written back to Things, so there is no conflict to resolve
# — and the snapshot exists only so the archive can still name the work when
# Things is absent, on another machine, or the task since edited.
snapshot() {  # <uuid>
  local id="$1" json
  # A local task has nothing in Things, so asking for it opened another app's
  # container for an answer that is always empty — and on macOS 15+ every open
  # is an "access data from other apps" prompt. `wts task show`, `wts task link`
  # and `wts <name> --task` all land here, and most tasks are local ones.
  [[ "$id" == local:* ]] && return 1
  [[ -x "$THINGS" ]] || return 1
  command -v jq >/dev/null 2>&1 || return 1
  json=$("$THINGS" show "$id" 2>/dev/null) || return 1
  [[ -n "$json" ]] || return 1
  snapshot_json "$json"
}

# The same write, from a task ALREADY read. The picker and the `ls` refresh both
# hold the whole object; going back to Things for it would be one more prompt.
snapshot_json() {  # <task json>
  local json="$1" id
  command -v jq >/dev/null 2>&1 || return 1
  id=$(print -r -- "$json" | jq -r '.id // empty' 2>/dev/null)
  [[ -n "$id" ]] || return 1

  local title notes links st area created completed
  # A \u001e terminator, read with -d: a task's notes are the user's own free
  # text and hold newlines, so a plain `read` stops at the first one and loses
  # every field after `notes`.
  IFS=$'\x1f' read -r -d $'\x1e' title notes links st area created completed < <(
    print -r -- "$json" | jq -r '[.title, .notes, (.links | tojson), .status,
      .area, .created_at, .completed_at] | join("\u001f") + "\u001e"' 2>/dev/null)

  db_q "INSERT INTO tasks
          (id, source, title, notes, links, status, area, created_at, completed_at, synced_at)
        VALUES ($(sql_str "$id"), 'things', $(sql_str "${title:-}"),
                $(sql_str "${notes:-}"), json($(sql_str "${links:-[]}")),
                $(sql_str "${st:-open}"), $(sql_str "${area:-}"),
                $(sql_str "${created:-}"), $(sql_str "${completed:-}"),
                strftime('%Y-%m-%dT%H:%M:%SZ', 'now'))
        ON CONFLICT(id) DO UPDATE SET
          title = excluded.title, notes = excluded.notes, links = excluded.links,
          status = excluded.status, area = excluded.area,
          completed_at = excluded.completed_at, synced_at = excluded.synced_at" \
    >/dev/null 2>&1
}

# Title of a task, from the snapshot then from Things.
task_title() {  # <id>
  local t
  t=$(db_ro "SELECT title FROM tasks WHERE id = $(sql_str "$1")" 2>/dev/null)
  if [[ -z "$t" && -x "$THINGS" ]] && command -v jq >/dev/null 2>&1; then
    t=$("$THINGS" show "$1" 2>/dev/null | jq -r '.title // empty' 2>/dev/null)
  fi
  print -r -- "$t"
}

# Turn what the user typed into a task id. A Things "Copy Link" gives
# things:///show?id=<uuid>, so that shape is accepted whole; bare words are
# searched in the open tasks; nothing at all opens the picker.
#
# With no argument it also SNAPSHOTS what the picker read, and that is why every
# caller below snapshots only when it was given an id: the picker hands back the
# whole task, so the trip to Things costs one open instead of two.
resolve_task() {  # [<id|url|words>]
  local want="${1:-}"
  if [[ -z "$want" ]]; then
    # No terminal, no picker: an agent gets the way out instead of a Things
    # read followed by an fzf that cannot draw.
    if ! [[ -t 0 && -t 2 ]]; then
      print -u2 -r -- "wts task: no terminal to pick a task in — pass its id (wts task ls --json)"
      return 2
    fi
    [[ -x "$THINGS" ]] || { print -u2 -r -- "wts task: no Things on this machine, pass an id"; return 1 }
    local json id
    json=$("$THINGS" pick --json) || return 1
    [[ -n "$json" ]] || return 1
    id=$(print -r -- "$json" | jq -r '.id // empty' 2>/dev/null)
    [[ -n "$id" ]] || return 1
    snapshot_json "$json"
    print -r -- "$id"
    return 0
  fi
  # things:///show?id=<uuid> — and any other query parameter order.
  if [[ "$want" == things:* ]]; then
    if [[ "$want" =~ 'id=([A-Za-z0-9-]+)' ]]; then
      print -r -- "${match[1]}"
      return 0
    fi
    print -u2 -r -- "wts task: no id in that Things link"
    return 1
  fi
  # A known snapshot, or a plausible Things uuid.
  if [[ "$(db_ro "SELECT 1 FROM tasks WHERE id = $(sql_str "$want")" 2>/dev/null)" == 1 ]]; then
    print -r -- "$want"
    return 0
  fi
  # A regex and not a glob: the (#cN,M) count form needs EXTENDED_GLOB, which a
  # sourced helper cannot assume. Things Cloud ids are 22 alphanumerics today.
  if [[ "$want" =~ '^[A-Za-z0-9]{15,30}$' ]] && [[ -x "$THINGS" ]] \
     && command -v jq >/dev/null 2>&1 \
     && [[ -n "$("$THINGS" show "$want" 2>/dev/null | jq -r '.id // empty' 2>/dev/null)" ]]; then
    print -r -- "$want"
    return 0
  fi
  # Words: search the open tasks, then every task.
  if [[ ! -x "$THINGS" ]] || ! command -v jq >/dev/null 2>&1; then
    print -u2 -r -- "wts task: '$want' is not a known task id"
    return 1
  fi
  local -a hits
  local st
  for st in open all; do
    hits=("${(@f)$("$THINGS" tasks --status "$st" --limit 500 2>/dev/null \
      | jq -r --arg w "$want" '.[] | select(.title | ascii_downcase
            | contains($w | ascii_downcase)) | "\(.id)\u001f\(.title)"' 2>/dev/null)}")
    hits=("${(@)hits:#}")
    (( ${#hits} )) && break
  done
  if (( ${#hits} == 0 )); then
    print -u2 -r -- "wts task: no task matching '$want'"
    return 1
  fi
  if (( ${#hits} == 1 )); then
    print -r -- "${hits[1]%%$'\x1f'*}"
    return 0
  fi
  print -u2 -r -- "wts task: '$want' matches ${#hits} tasks:"
  local h
  for h in "${hits[@]}"; do
    print -u2 -r -- "  ${h%%$'\x1f'*}  ${h#*$'\x1f'}"
  done
  return 1
}

# ─── ls ──────────────────────────────────────────────────────────────────────

# The JSON of `task ls --json` / `task show --json`: one SELECT each, over the
# same tables as the text, so the two cannot disagree. `version` like `wts log`:
# keys are added, never renamed. `state` is live or archived; `outcome` is the
# archive's closed vocabulary (in-progress for a live session).
task_sessions_sql() {  # <sql expression for the task id>
  print -r -- "(SELECT coalesce(json_group_array(json(s)), json('[]')) FROM (
      SELECT json_object('name', session, 'state', 'archived', 'outcome', outcome,
                         'pr', pr_url, 'added', added, 'removed', removed,
                         'finished_at', finished_at,
                         'retro', json(CASE WHEN retro_delivered != '' THEN 'true' ELSE 'false' END)) AS s
        FROM archive WHERE task = $1
      UNION ALL
      SELECT json_object('name', s.name, 'state', 'live', 'outcome', 'in-progress',
                         'branch', s.branch, 'worktree', s.worktree)
        FROM task_links l JOIN sessions s ON s.name = l.session WHERE l.task = $1))"
}

tasks_json() {  # <all?>
  local all="$1" where=""
  $all || where="WHERE (SELECT count(*) FROM (
                   SELECT session FROM task_links WHERE task = t.id
                   UNION SELECT session FROM archive WHERE task = t.id)) > 0"
  db_ro "SELECT json_object('version', 1, 'tasks', coalesce(json_group_array(json(o)), json('[]')))
         FROM (SELECT json_object('id', t.id, 'title', t.title, 'source', t.source,
                 'status', CASE WHEN t.status = '' THEN 'unknown' ELSE t.status END,
                 'area', t.area, 'completed_at', t.completed_at,
                 'sessions', json($(task_sessions_sql t.id))) AS o
               FROM tasks t $where ORDER BY t.completed_at DESC, t.title)" 2>/dev/null
}

task_json() {  # <id>
  local q
  q=$(sql_str "$1")
  db_ro "SELECT json_object('version', 1, 'id', t.id, 'title', t.title, 'source', t.source,
           'status', CASE WHEN t.status = '' THEN 'unknown' ELSE t.status END,
           'area', t.area, 'notes', t.notes,
           'links', json(CASE WHEN json_valid(t.links) THEN t.links ELSE '[]' END),
           'wts_notes', (SELECT coalesce(json_group_array(json_object('at', added_at, 'body', body)), json('[]'))
                         FROM (SELECT added_at, body FROM task_notes WHERE task = $q ORDER BY added_at)),
           'documents', (SELECT coalesce(json_group_array(slug), json('[]'))
                         FROM (SELECT slug FROM task_docs WHERE task = $q ORDER BY added_at)),
           'sessions', json($(task_sessions_sql "$q")),
           'attempts', (SELECT coalesce(json_group_array(json(a)), json('[]')) FROM (
              SELECT json_object('session', session, 'outcome', outcome, 'pr', pr_url,
                     'finished_at', finished_at, 'delivered', retro_delivered,
                     'resisted', retro_resisted, 'resolved', retro_resolved,
                     'abandoned', retro_abandoned) AS a
                FROM archive WHERE task = $q ORDER BY finished_at DESC, id DESC)),
           'usage', json($(task_usage_sql "$q")))
         FROM tasks t WHERE t.id = $q" 2>/dev/null
}

cmd_ls() {
  local all=false json=false a
  for a in "$@"; do
    case "$a" in
      --all)  all=true ;;
      --json) json=true ;;
      *) print -u2 -r -- "usage: wts task ls [--all] [--json]"; return 2 ;;
    esac
  done
  db_init 2>/dev/null

  # Refresh the snapshots wts holds, so titles do not drift from Things — in ONE
  # read, not one per task. This used to call `show` per snapshot, and every one
  # of those opens another app's container: on macOS 15+, `wts task ls` asked
  # "iTerm would like to access data from other apps" once per task it held.
  # A task outside the window keeps the snapshot it has, which is exactly what
  # happens anyway when Things is not installed.
  # Not `all`: that name is this function's --all flag, and taking it here made
  # `wts task ls --all` hide every task without a session.
  local known fresh id
  known=$(db_ro "SELECT count(*) FROM tasks WHERE source = 'things'" 2>/dev/null)
  if [[ -x "$THINGS" ]] && (( ${known:-0} > 0 )) && command -v jq >/dev/null 2>&1; then
    fresh=$("$THINGS" tasks --status all --limit 2000 2>/dev/null)
    if [[ -n "$fresh" ]]; then
      local one
      while IFS=$'\x1f' read -r -d $'\x1e' id; do
        [[ -n "$id" ]] || continue
        one=$(print -r -- "$fresh" | jq -c --arg id "$id" \
                'map(select(.id == $id)) | .[0] // empty' 2>/dev/null)
        [[ -n "$one" ]] && snapshot_json "$one"
      done < <(db_rows "SELECT id FROM tasks WHERE source = 'things'" 2>/dev/null)
    fi
  fi

  if $json; then
    tasks_json "$all"
    return 0
  fi

  local bold="" dim="" reset=""
  if [[ -t 1 ]]; then bold=$'\e[1m' dim=$'\e[2m' reset=$'\e[0m'; fi

  # Declared ONCE, outside the loop: a bare `local a b` re-run in a scope that
  # already has them PRINTS them (zsh displays what it is asked to declare and
  # not assign), so the second task listed pushed `name=''` and six more lines
  # of its own state into the middle of the output.
  local task title st done_at n
  local name outcome pr added removed retro state
  integer shown=0
  while IFS=$'\x1f' read -r -d $'\x1e' task title st done_at n; do
    [[ -n "$task" ]] || continue
    (( ++shown ))
    print -r -- "${bold}◆ ${title:-$task}${reset}  ${dim}${st}${done_at:+ $done_at}  $n session(s)${reset}"
    while IFS=$'\x1f' read -r -d $'\x1e' name state outcome pr added removed retro; do
      [[ -n "$name" ]] || continue
      local prl=""
      [[ "$pr" =~ '/pull/([0-9]+)' ]] && prl="PR #${match[1]}"
      printf '    %-26s %-12s %-12s %-14s %s\n' \
        "$name" "$outcome" "$prl" "+$added/-$removed" \
        "$([[ -n "$retro" ]] && print -r -- "retro ✓" || print -r -- "—")"
    done < <(sessions_of "$task")
  done < <(tasks_rows "$all")

  (( shown )) || print -r -- "No task linked yet. Link one with: wts task link"
}

tasks_rows() {  # <all?>
  local all="$1" having=""
  $all || having="HAVING n > 0"
  db_rows "
    SELECT t.id, t.title,
           CASE WHEN t.status = '' THEN 'unknown' ELSE t.status END,
           substr(t.completed_at, 1, 10),
           (SELECT count(*) FROM (
              SELECT session FROM task_links WHERE task = t.id
              UNION SELECT session FROM archive WHERE task = t.id)) AS n
    FROM tasks t
    GROUP BY t.id $having
    ORDER BY t.completed_at DESC, t.title" 2>/dev/null
}

sessions_of() {  # <task-id>
  db_rows "
    SELECT session, 'archived', outcome, pr_url, added, removed, retro_delivered
      FROM archive WHERE task = $(sql_str "$1")
    UNION ALL
    SELECT s.name, 'live', 'in-progress', '', 0, 0, ''
      FROM task_links l JOIN sessions s ON s.name = l.session
     WHERE l.task = $(sql_str "$1")
    " 2>/dev/null
}

# ─── show ────────────────────────────────────────────────────────────────────

cmd_show() {
  local id json=false
  local -a rest
  rest=()
  for a in "$@"; do
    if [[ "$a" == --json ]]; then json=true; else rest+=("$a"); fi
  done
  set -- "${rest[@]}"
  # Inside a wts session, no id means this session's task — as for note, edit
  # and doc. The picker, and its read of Things, is for a human at a terminal
  # outside any session; an agent told `wts task show` by the SessionStart hook
  # must never land there.
  if [[ -z "${1:-}" ]] && id=$(current_task 2>/dev/null) && [[ -n "$id" ]]; then
    :
  else
    id=$(resolve_task "${1:-}") || return 1
  fi
  [[ -n "$id" ]] || return 1
  db_init 2>/dev/null
  # Only when an id was given: with none, resolve_task went through the picker
  # and has already snapshotted what it read.
  if [[ -n "${1:-}" ]]; then snapshot "$id" 2>/dev/null; fi

  if $json; then
    local out
    out=$(task_json "$id")
    if [[ -z "$out" ]]; then
      print -u2 -r -- "wts task: $id is unknown here"
      return 1
    fi
    print -r -- "$out"
    return 0
  fi

  local title notes links st
  IFS=$'\x1f' read -r -d $'\x1e' title notes links st < <(db_rows "
    SELECT title, notes, links, status FROM tasks WHERE id = $(sql_str "$id")" 2>/dev/null)
  if [[ -z "${title:-}" ]]; then
    print -u2 -r -- "wts task: $id is unknown here"
    return 1
  fi
  print -r -- "$title"
  print -r -- "  id:     $id"
  print -r -- "  status: ${st:-unknown}"
  if [[ -n "${notes:-}" ]]; then
    print -r -- "  notes:"
    print -r -- "$notes" | sed 's/^/    /'
  fi
  # Its own block, and labelled: these are wts's, they survive a Things refresh
  # and the source document knows nothing about them.
  local at body
  integer wn=0
  while IFS=$'\x1f' read -r -d $'\x1e' at body; do
    [[ -n "$body" ]] || continue
    (( wn++ == 0 )) && print -r -- "  notes added in wts:"
    print -r -- "    ($at) $body" | sed '2,$s/^/      /'
  done < <(db_rows "SELECT substr(added_at, 1, 10), body FROM task_notes
                    WHERE task = $(sql_str "$id") ORDER BY added_at" 2>/dev/null)
  if [[ -n "${links:-}" && "${links:-}" != "[]" ]] && command -v jq >/dev/null 2>&1; then
    print -r -- "  links:"
    print -r -- "$links" | jq -r '.[] | "    [\(.kind)] \(.url)"' 2>/dev/null
  fi
  local slug
  integer wd=0
  while IFS=$'\x1f' read -r -d $'\x1e' slug; do
    [[ -n "$slug" ]] || continue
    (( wd++ == 0 )) && print -r -- "  documents:"
    print -r -- "    $slug"
  done < <(db_rows "SELECT slug FROM task_docs WHERE task = $(sql_str "$id")
                    ORDER BY added_at" 2>/dev/null)
  local name state outcome pr added removed retro
  integer live=0
  while IFS=$'\x1f' read -r -d $'\x1e' name state outcome pr added removed retro; do
    [[ "$state" == live && -n "$name" ]] || continue
    (( live++ == 0 )) && print -r -- "  sessions on it now:"
    print -r -- "    $name"
  done < <(sessions_of "$id")
  # Every attempt, with the three retrospective lines a retry needs, and not
  # `delivered` alone: what resisted and what was abandoned is what the next
  # session must not rediscover. Same renderer as the context file and the hook.
  local attempts
  attempts=$(task_attempts_md "$id" 1000 2>/dev/null) || attempts=""
  if [[ -n "$attempts" ]]; then
    print -r -- "$attempts" | sed -e '/^$/d' -e 's/^/  /'
  elif (( live == 0 )); then
    print -r -- "  sessions: none yet"
  fi
  # Over every attempt: the number a single session's row in wts ls cannot
  # give. As of each one's last wts brief or teardown.
  local usage
  local -a u
  usage=$(db_rows "SELECT CASE WHEN json_extract(j, '\$.tokens') >= 1000000
                               THEN printf('%.1fM', json_extract(j, '\$.tokens') / 1e6)
                               WHEN json_extract(j, '\$.tokens') >= 1000
                               THEN printf('%dk', json_extract(j, '\$.tokens') / 1000)
                               ELSE json_extract(j, '\$.tokens') END,
                          printf('%.2f', json_extract(j, '\$.cost_usd')),
                          json_extract(j, '\$.cost_complete'), json_extract(j, '\$.sessions')
                   FROM (SELECT $(task_usage_sql "$(sql_str "$id")") AS j)
                   WHERE j IS NOT NULL" 2>/dev/null)
  u=("${(@ps:\x1f:)${usage%$'\x1e'}}")
  if [[ -n "${u[1]:-}" ]]; then
    print -r -- "  usage:  ${u[1]} tokens, ${${u[3]:#1}:+~}\$${u[2]:-0} at API list prices, over ${u[4]:-?} session(s)"
  fi
  # Explicit: a function's status is its last command's, and `wts task show`
  # once exited 1 on every successful listing that ended on a `[[ ]] && …`.
  return 0
}

# ─── link / unlink ───────────────────────────────────────────────────────────

cmd_link() {
  local want="" session=""
  local a
  for a in "$@"; do
    if [[ -z "$want" ]]; then want="$a"; else session="$a"; fi
  done
  db_init 2>/dev/null

  # A task id looks nothing like a session name, but the argument order is
  # <task> <session>: when only one is given and it names a session, take it as
  # the session and open the picker for the task.
  if [[ -z "$session" && -n "$want" ]] && db_has_session "$want"; then
    session="$want"; want=""
  fi
  [[ -n "$session" ]] || session=$(db_current_session) || {
    print -u2 -r -- "wts task link: not inside a wts session, name one"
    return 1
  }
  db_has_session "$session" || {
    print -u2 -r -- "wts task link: '$session' is not a registered session"
    return 1
  }

  local id
  id=$(resolve_task "$want") || return 1
  [[ -n "$id" ]] || { print -u2 -r -- "wts task link: no task chosen"; return 1 }

  # Only when an id was given: with none, resolve_task went through the picker
  # and has already snapshotted what it read.
  if [[ -n "$want" ]]; then snapshot "$id" 2>/dev/null; fi
  db_q "INSERT INTO task_links (session, task, linked_at)
        VALUES ($(sql_str "$session"), $(sql_str "$id"), $(sql_str "$(now_iso)"))
        ON CONFLICT(session) DO UPDATE SET
          task = excluded.task, linked_at = excluded.linked_at" >/dev/null 2>&1 || {
    print -u2 -r -- "wts task link: could not write the link"
    return 1
  }
  print -r -- "→ $session serves “$(task_title "$id")”"

  # The URLs the task carries are exactly the context an agent starting on it
  # would otherwise be told to go and find. Printed rather than attached: making
  # `wts doc` fetch one to three pages per link would put minutes in front of a
  # session, and `wts doc use` is the one command that knows how to tell a live
  # agent about a new document.
  local links
  links=$(db_ro "SELECT links FROM tasks WHERE id = $(sql_str "$id")" 2>/dev/null)
  if [[ -n "$links" && "$links" != "[]" ]] && command -v jq >/dev/null 2>&1; then
    local n
    n=$(print -r -- "$links" | jq 'length' 2>/dev/null)
    if [[ "$n" == <-> ]] && (( n > 0 )); then
      print -r -- "  $n link(s) in its notes; attach one with:"
      print -r -- "$links" | jq -r --arg s "$session" \
        '.[] | "    wts doc use \(.url) \($s)"' 2>/dev/null
    fi
  fi
}

cmd_unlink() {
  local session="${1:-}"
  db_init 2>/dev/null
  [[ -n "$session" ]] || session=$(db_current_session) || {
    print -u2 -r -- "wts task unlink: not inside a wts session, name one"
    return 1
  }
  # `wts task unlink notasession` said "→ notasession serves no task" and exited
  # 0: true, and useless — the typo went unnoticed and the real link stayed.
  if ! db_has_session "$session" \
     && [[ -z "$(db_ro "SELECT 1 FROM task_links WHERE session = $(sql_str "$session")" 2>/dev/null)" ]]; then
    print -u2 -r -- "wts task unlink: '$session' is not a session (wts ls)"
    return 1
  fi
  db_q "DELETE FROM task_links WHERE session = $(sql_str "$session")" >/dev/null 2>&1
  print -r -- "→ $session serves no task"
}

# ─── new ─────────────────────────────────────────────────────────────────────

# A task that exists only in wts, for a machine without Things. Its id is
# prefixed so it can never collide with a Things Cloud uuid.
cmd_new() {
  local title="$*"
  [[ -n "$title" ]] || { print -u2 -r -- 'wts task new: give it a title'; return 1 }
  db_init 2>/dev/null
  local id="local:$(db_ro "SELECT lower(hex(randomblob(8)))" 2>/dev/null)"
  db_q "INSERT INTO tasks (id, source, title, status, created_at, synced_at)
        VALUES ($(sql_str "$id"), 'local', $(sql_str "$title"), 'open',
                strftime('%Y-%m-%dT%H:%M:%SZ', 'now'),
                strftime('%Y-%m-%dT%H:%M:%SZ', 'now'))" >/dev/null 2>&1 || {
    print -u2 -r -- "wts task new: could not write the task"
    return 1
  }
  print -r -- "$id"
}

# ─── add ─────────────────────────────────────────────────────────────────────

# Put a task on wts's list without creating anything: it is the snapshot that
# makes a Things task visible to `wts task ls` and to the switcher, which read
# the database and never open Things on their own.
cmd_add() {
  local id
  db_init 2>/dev/null
  id=$(resolve_task "${1:-}") || return 1
  [[ -n "$id" ]] || { print -u2 -r -- "wts task add: no task chosen"; return 1 }
  # Only when an id was given: with none, resolve_task went through the picker
  # and has already snapshotted what it read.
  if [[ -n "${1:-}" ]]; then snapshot "$id" 2>/dev/null; fi
  if ! task_exists "$id"; then
    print -u2 -r -- "wts task add: $id could not be read from Things"
    return 1
  fi
  print -r -- "→ $(task_title "$id")"
  print -r -- "  $id — start a session on it with: wts <name> --task $id"
}

# ─── note / edit ─────────────────────────────────────────────────────────────

# Free text kept ON the task, so the second session on it starts where the first
# left off. Appended, never merged into the Things notes: those are refreshed
# from Things and anything written over them is lost on the next `wts task ls`.
cmd_note() {
  local id text
  db_init 2>/dev/null
  take_task_arg "$@" || return 1
  id="$REPLY_TASK"
  set -- "${REPLY_ARGS[@]}"

  if [[ "${1:-}" == "--clear" ]]; then
    db_q "DELETE FROM task_notes WHERE task = $(sql_str "$id")" >/dev/null 2>&1
    print -r -- "→ notes cleared on “$(task_title "$id")”"
    return 0
  fi

  text="$*"
  if [[ -z "${text//[[:space:]]/}" ]]; then
    print -u2 -r -- 'wts task note: give it some text (or --clear)'
    return 1
  fi
  db_q "INSERT INTO task_notes (task, body, added_at)
        VALUES ($(sql_str "$id"), $(sql_str "$text"), $(sql_str "$(now_iso)"))" \
    >/dev/null 2>&1 || {
    print -u2 -r -- "wts task note: could not write the note"
    return 1
  }
  print -r -- "→ noted on “$(task_title "$id")”"
}

# The same notes in an editor, for context longer than a command line. Replaces
# them with one row: this is the verb that rewrites, `note` is the one that adds.
cmd_edit() {
  local id tmp editor
  db_init 2>/dev/null
  take_task_arg "$@" || return 1
  id="$REPLY_TASK"

  editor="${VISUAL:-${EDITOR:-}}"
  if [[ -z "$editor" ]]; then
    if command -v vi >/dev/null 2>&1; then editor=vi; else
      print -u2 -r -- "wts task edit: no \$VISUAL, no \$EDITOR and no vi (use: wts task note)"
      return 1
    fi
  fi
  # An editor needs the terminal. Under fzf's `execute` it has one; in a pipe or
  # a hook it does not, and vi on a pipe leaves the terminal in a broken state.
  if [[ ! -t 0 || ! -t 1 ]]; then
    print -u2 -r -- "wts task edit: needs a terminal (use: wts task note \"<text>\")"
    return 1
  fi

  tmp=$(mktemp "${TMPDIR:-/tmp}/wts-task-note.XXXXXX.md") || return 1
  # db_rows TERMINATES each row with \x1e, so deleting it would run the notes
  # together ("…company_idrewritten by the editor"). Turned into a newline
  # instead. A note that already holds newlines blurs into the next one in the
  # buffer, which is harmless: this verb saves the whole buffer as ONE note, so
  # after the first edit there is only ever one.
  db_rows "SELECT body FROM task_notes WHERE task = $(sql_str "$id") ORDER BY added_at" \
    2>/dev/null | tr '\036' '\n' > "$tmp"

  if ! ${=editor} "$tmp"; then
    rm -f "$tmp"
    print -u2 -r -- "wts task edit: $editor exited non-zero, nothing written"
    return 1
  fi

  local body
  body=$(<"$tmp")
  rm -f "$tmp"
  # One transaction: an interrupted edit must not leave the task with no notes
  # at all, which is what a DELETE followed by a failed INSERT would do.
  if [[ -z "${body//[[:space:]]/}" ]]; then
    db_q "DELETE FROM task_notes WHERE task = $(sql_str "$id")" >/dev/null 2>&1
    print -r -- "→ notes cleared on “$(task_title "$id")”"
    return 0
  fi
  print -r -- "BEGIN IMMEDIATE;
DELETE FROM task_notes WHERE task = $(sql_str "$id");
INSERT INTO task_notes (task, body, added_at)
  VALUES ($(sql_str "$id"), $(sql_str "$body"), $(sql_str "$(now_iso)"));
COMMIT;" | db_q >/dev/null 2>&1 || {
    print -u2 -r -- "wts task edit: could not write the notes"
    return 1
  }
  print -r -- "→ notes rewritten on “$(task_title "$id")” (${#body} characters)"
}

# ─── doc ─────────────────────────────────────────────────────────────────────

# A context document on the TASK rather than on one of its sessions: every
# session started on it inherits the document, instead of the author attaching
# the same spec to the third attempt as to the first.
#
# The slug is stored, not the URL: it is what `wts doc sync` refreshes and what
# materialize takes, so this is the same object as a document on a session.
cmd_doc() {
  local id slug
  db_init 2>/dev/null
  take_task_arg "$@" || return 1
  id="$REPLY_TASK"
  set -- "${REPLY_ARGS[@]}"

  if [[ ! -x "$DOC" ]]; then
    print -u2 -r -- "wts task doc: the wts-doc helper is missing"
    return 1
  fi

  if [[ "${1:-}" == "--rm" ]]; then
    [[ -n "${2:-}" ]] || { print -u2 -r -- "wts task doc: --rm needs a slug"; return 1 }
    db_q "DELETE FROM task_docs WHERE task = $(sql_str "$id")
            AND slug = $(sql_str "$2")" >/dev/null 2>&1
    print -r -- "→ $2 detached from “$(task_title "$id")”"
    return 0
  fi

  if [[ -n "${1:-}" ]]; then
    slug=$("$DOC" resolve "$1") || return 1
  else
    slug=$("$DOC" pick) || return 1
  fi
  [[ -n "$slug" ]] || { print -u2 -r -- "wts task doc: no document chosen"; return 1 }

  db_q "INSERT INTO task_docs (task, slug, added_at)
        VALUES ($(sql_str "$id"), $(sql_str "$slug"), $(sql_str "$(now_iso)"))
        ON CONFLICT(task, slug) DO UPDATE SET added_at = excluded.added_at" \
    >/dev/null 2>&1 || {
    print -u2 -r -- "wts task doc: could not attach $slug"
    return 1
  }
  print -r -- "→ $slug attached to “$(task_title "$id")”"

  # The sessions already running on this task do not get it: their context file
  # was written when they started. Name the one command that fixes that rather
  # than rewriting files under a working agent from here.
  local -a live
  live=("${(@f)$(db_ro "SELECT session FROM task_links WHERE task = $(sql_str "$id")" 2>/dev/null)}")
  live=("${(@)live:#}")
  if (( ${#live} )); then
    print -r -- "  ${#live} session(s) already running; tell them with:"
    local s
    for s in "${live[@]}"; do print -r -- "    wts doc use $slug $s"; done
  fi
}

# ─── done ────────────────────────────────────────────────────────────────────

# Close a task wts holds on its own. Nothing else ever did: a local task has no
# Things behind it to complete, so it stayed `open` for good — in the switcher,
# and back in it after every `wts rm` of a session that served it, merged or not.
#
# Local only. A Things task is closed in Things: snapshot() is last writer wins
# and nothing is written back, so a status set here would be undone by the next
# `wts task ls` — and wts would disagree with Things until then. The check reads
# the row's source rather than the `local:` prefix, which is only a convention.
#
# Notes, documents, the archive and a live link are left alone: the task leaves
# the list of work to start, not the history of what was done on it.
cmd_done() {
  local id src st title
  db_init 2>/dev/null
  take_task_arg "$@" || return 1
  id="$REPLY_TASK"
  IFS=$'\x1f' read -r -d $'\x1e' src st title < <(db_rows "
    SELECT source, status, title FROM tasks WHERE id = $(sql_str "$id")" 2>/dev/null)
  if [[ -z "${src:-}" ]]; then
    print -u2 -r -- "wts task done: $id is not a task wts holds"
    return 1
  fi
  if [[ "$src" != local ]]; then
    print -u2 -r -- "wts task done: “${title:-$id}” is a Things task — complete it in Things; wts sees it at the next wts task ls"
    return 1
  fi
  if [[ "$st" == completed ]]; then
    print -r -- "→ “${title:-$id}” is already done"
    return 0
  fi
  db_q "UPDATE tasks SET status = 'completed',
                         completed_at = strftime('%Y-%m-%dT%H:%M:%SZ', 'now')
         WHERE id = $(sql_str "$id") AND source = 'local'" >/dev/null 2>&1 || {
    print -u2 -r -- "wts task done: could not write the task"
    return 1
  }
  print -r -- "✓ “${title:-$id}” — done"
}

# ─── Dispatch ────────────────────────────────────────────────────────────────

case "${1:-ls}" in
  ls)     shift 2>/dev/null; cmd_ls "$@" ;;
  show)   shift; cmd_show "$@" ;;
  link)   shift; cmd_link "$@" ;;
  unlink) shift; cmd_unlink "$@" ;;
  new)    shift; cmd_new "$@" ;;
  add)    shift; cmd_add "$@" ;;
  note)   shift; cmd_note "$@" ;;
  edit)   shift; cmd_edit "$@" ;;
  doc)    shift; cmd_doc "$@" ;;
  done)   shift; cmd_done "$@" ;;
  # Not a user-facing verb: how `wts <name> --task …` turns what was typed into
  # an id, before it creates anything. Prints the id, or fails having said why.
  resolve)
    shift
    db_init 2>/dev/null
    id=$(resolve_task "${1:-}") || exit 1
    [[ -n "$id" ]] || exit 1
    if [[ -n "${1:-}" ]]; then snapshot "$id" 2>/dev/null; fi
    print -r -- "$id"
    ;;
  # Also internal: the one line `wts <name> --task` prints once it has linked.
  title)
    shift
    db_init 2>/dev/null
    task_title "${1:-}"
    ;;
  # The URLs the task carries, one per line. From the snapshot and not from
  # Things, so a local task works too and a machine without Things still has
  # whatever was recorded when the task was last seen.
  links)
    shift
    db_init 2>/dev/null
    command -v jq >/dev/null 2>&1 || exit 0
    db_ro "SELECT links FROM tasks WHERE id = $(sql_str "${1:-}")" 2>/dev/null \
      | jq -r '.[]?.url // empty' 2>/dev/null
    ;;
  # Internal, beside `links`: the library slugs the author attached to the task.
  # Already-fetched documents, so `wts <name> --task` adds them with no fetch.
  docs)
    shift
    db_init 2>/dev/null
    db_ro "SELECT slug FROM task_docs WHERE task = $(sql_str "${1:-}")
           ORDER BY added_at" 2>/dev/null
    ;;
  *) print -u2 "usage: wts task ls|show|link|unlink|new|add|note|edit|doc|done …"; exit 2 ;;
esac
